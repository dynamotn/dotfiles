[submodule "scripts/lib/dybatpho"]
  path = scripts/lib/dybatpho
  url = https://github.com/dynamotn/dybatpho.git
{{- /* Every URL is the GitHub one over HTTPS, which a fresh machine clones
       anonymously. Whether git fetches it from GitLab or GitHub, over SSH or
       HTTPS, is the network's call: dynet rewrites it with insteadOf rules
       (scripts/lib/network.sh), from the mirrors in dynet/config.json */}}
[submodule "neovim"]
  path = home/private_dot_config/nvim
  url = https://github.com/dynamotn/neovim-config.git
{{- if eq .terminalMultiplexer "T" }}
[submodule "tmux"]
  path = silos/tmux
  url = https://github.com/dynamotn/tmux-config.git
{{- end }}
{{- if eq .guiServer "X" }}
[submodule "awesome"]
  path = home/private_dot_config/awesome
  url = https://github.com/dynamotn/awesomewm-config.git
{{- end }}
{{- if ne .guiServer "0" }}
[submodule "wallpaper"]
  path = home/Multimedia/Pictures/Wallpaper
  url = https://github.com/dynamotn/wallpapers-collection.git
{{- end }}
{{- if eq .guiServer "W" "X" }}
[submodule "icon"]
  path = silos/icon
  url = https://github.com/dynamotn/Dynamo-Icon.git
{{- end }}
{{- if eq .browser "F" }}
[submodule "lepton"]
  path = home/.chezmoitemplates/firefox/chrome/lepton
  url = https://github.com/black7375/Firefox-UI-Fix.git
{{- end }}
{{- if eq .browser "F" "Z" }}
{{-   if .decryptPersonal }}
[submodule "firefox-personal"]
  path = home/private_dot_config/firefox/profiles/personal
  url = https://github.com/dynamotn/firefox-personal.git
  shallow = true
[submodule "thunderbird-personal"]
  path = home/private_dot_config/thunderbird/profiles/personal
  url = https://github.com/dynamotn/thunderbird-personal.git
  shallow = true
{{-   end }}
{{-   range .browserEnterpriseProfiles }}
[submodule "firefox-enterprise-{{ . }}"]
  path = home/private_dot_config/firefox/profiles/enterprise-{{ . }}
  url = https://github.com/dynamotn/firefox-enterprise-{{ . }}.git
  shallow = true
[submodule "thunderbird-enterprise-{{ . }}"]
  path = home/private_dot_config/thunderbird/profiles/enterprise-{{ . }}
  url = https://github.com/dynamotn/thunderbird-enterprise-{{ . }}.git
  shallow = true
{{-   end }}
{{- end }}
{{- if or .decryptPersonal (not (empty .decryptEnterprise)) }}
[submodule "secrets/data"]
  path = secrets/data
  url = https://github.com/dynamotn/dotfiles-secrets.git
{{- end }}
