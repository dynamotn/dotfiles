{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "minimumReleaseAge": "7 days",
  "enabledManagers": [
    "pre-commit",
    "github-actions",
    "git-submodules",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true,
    "ignorePaths": [
      "secrets/data"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The GitHub MCP server image, pinned by tag and digest in the dyai config.",
      "managerFilePatterns": [
        "/^home/private_dot_config/dyai/config\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "\"(?<depName>ghcr\\.io/github/github-mcp-server):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "claude-mem, run through npx by the other agents' installers.",
      "managerFilePatterns": [
        "/^home/private_dot_config/dyai/config\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "npx -y (?<depName>claude-mem)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Claude marketplaces, pinned to a release tag in the shared dyai data.",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/ai/dyai-data\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "repo: (?<depName>[\\w.-]+/[\\w.-]+), ref: (?<currentValue>[^ }]+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "age, fetched by setup.sh and installed by dytoy, each pinned with the sha256 of its archives: a bump fails the pins workflow until scripts/pins.sh shows the new digests written.",
      "managerFilePatterns": [
        "/^scripts/setup\\.sh$/",
        "/^home/\\.chezmoitemplates/dytoy/age\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "AGE_VERSION=\"(?<currentValue>v[0-9.]+)\"",
        "repo: FiloSottile/age\\n  version: (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "FiloSottile/age",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "yq, fetched by setup.sh with the sha256 of each binary; checked by the pins workflow like age.",
      "managerFilePatterns": [
        "/^scripts/setup\\.sh$/"
      ],
      "matchStrings": [
        "YQ_VERSION=\"(?<currentValue>v[0-9.]+)\""
      ],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The delta theme git/config includes, at a commit with its sha256; checked by the pins workflow.",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternals/catppuccin\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/catppuccin/delta/(?<currentDigest>[0-9a-f]{40})/"
      ],
      "depNameTemplate": "catppuccin/delta",
      "packageNameTemplate": "https://github.com/catppuccin/delta",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "The bun-termux installer, piped into bash on Android at a commit: read the new script in the pull request before merging it.",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/dytoy/nodejs\\.yaml\\.tmpl$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/Happ1ness-dev/bun-termux/(?<currentDigest>[0-9a-f]{40})/"
      ],
      "depNameTemplate": "Happ1ness-dev/bun-termux",
      "packageNameTemplate": "https://github.com/Happ1ness-dev/bun-termux",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "git-refs gives no release timestamp, so a minimum release age would hold the submodule and commit-pinned bumps forever.",
      "matchDatasources": [
        "git-refs"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "The dotfiles submodules follow their own branches; group their bumps into one pull request instead of one each.",
      "matchManagers": [
        "git-submodules"
      ],
      "groupName": "submodules",
      "schedule": [
        "before 9am on monday"
      ]
    }
  ]
}
