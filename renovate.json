{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "enabledManagers": ["pre-commit", "github-actions", "git-submodules", "custom.regex"],
  "pre-commit": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true,
    "ignorePaths": ["secrets/data"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The GitHub MCP server image, pinned by tag and digest in the dyai config.",
      "managerFilePatterns": ["/^home/private_dot_config/dyai/config\\.yaml\\.tmpl$/"],
      "matchStrings": ["\"(?<depName>ghcr\\.io/github/github-mcp-server):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "claude-mem, run through npx by the other agents' installers.",
      "managerFilePatterns": ["/^home/private_dot_config/dyai/config\\.yaml\\.tmpl$/"],
      "matchStrings": ["npx -y (?<depName>claude-mem)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "The dotfiles submodules follow their own branches; group their bumps into one pull request instead of one each.",
      "matchManagers": ["git-submodules"],
      "groupName": "submodules",
      "schedule": ["before 9am on monday"]
    }
  ]
}
