**/.DS_Store

{{/* OS related files */}}
{{- if ne .chezmoi.os "linux" }}
etc
usr
opt
var
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
Applications
private
{{- end }}
{{- if eq .osid "linux-arch" }}
usr/lib64
{{- end }}

{{/* Window manager and WM-related files */}}
{{- if ne .guiServer "W" }}
usr/share/wayland-sessions/dyland.desktop
etc/greetd
{{- end }}
{{- if eq .guiWinManager "N" }}
etc/greetd/hyprland.lua
{{- else }}
etc/greetd/niri.kdl
{{- end }}
{{/* DDC/CI to external monitors, for dymonitor */}}
{{- if eq .guiServer "0" }}
etc/modules-load.d/i2c-dev.conf
{{- end }}

{{/* Browser files */}}
{{- if ne .osid "linux-gentoo" }}
usr/lib64/firefox
opt/firefox
opt/zen
{{- end }}
{{- if ne .osid "linux-arch" }}
usr/lib/firefox
opt/zen-browser-bin
{{- end }}
{{- if ne .browser "F" }}
usr/lib/firefox
usr/lib64/firefox
opt/firefox
Applications/Firefox.app
{{- end }}
{{- if ne .browser "Z" }}
opt/zen
opt/zen-browser-bin
Applications/Zen.app
{{- end }}

{{/* Linux related files */}}
{{- if ne .initSystem "systemd" }}
etc/systemd
etc/vconsole.conf
{{- end }}
{{- if ne .initSystem "openrc" }}
etc/rc.conf.d
etc/syslog-ng
etc/chrony
{{- end }}
{{- if ne .osid "linux-arch" }}
etc/makepkg.conf
etc/pacman.d
etc/pacman.conf
{{- end }}
{{- if ne .osid "linux-gentoo" }}
etc/audit
etc/dracut.conf.d
etc/kernel
etc/chrony
etc/portage
etc/scx_loader
etc/selinux
etc/sandbox.d
var/lib/portage
{{- end }}
{{- /* Snapshots and scrub, for machines on btrfs (dytoy/btrbk.yaml.tmpl) */}}
{{- if not (has .code .btrfsMachines) }}
etc/btrbk
etc/cron.daily/btrbk
etc/cron.monthly/btrfs-scrub
{{- end }}
{{- /* smartd watches real disks only (dytoy/smartmontools.yaml.tmpl) */}}
{{- if eq .kind "container" "vm" }}
etc/smartd.conf
usr/local/bin/notify-desktop
{{- end }}
{{- /* Off-machine backup of desktops and laptops (dytoy/restic_system.yaml.tmpl) */}}
{{- if not (eq .kind "pc" "laptop" "workstation") }}
etc/restic
etc/cron.daily/restic-backup
{{- end }}
{{- /* Disk build dir of env/heavy.conf, beside the tmpfs of fstab */}}
{{- if ne .code "l30n4rd0d4v1nc1" }}
var/tmp/notmpfs
{{- end }}
{{- if not (eq .osid "linux-ubuntu" "linux-debian") }}
etc/apt
{{- end }}

{{/* Machine type files */}}
{{- if not (eq .kind "pc" "laptop") }}
etc/default/grub
{{- end }}
{{- if and (eq .kind "vm") (eq .place "office") }}
etc/hostname
etc/modprobe.d
etc/pam.d
{{- end }}
{{- if eq .kind "container" }}
{{/* The runtime owns these: Docker and Podman bind-mount hostname and hosts,
     so writing them fails with EBUSY, and the rest configure a kernel, a
     boot, hardware or services the container does not have. CA certificates,
     sudoers and package manager configuration still apply. */}}
etc/hostname
etc/hosts
etc/fstab
etc/localtime
etc/locale.gen
etc/vconsole.conf
etc/sysctl.d
etc/udev
etc/modprobe.d
etc/modules-load.d
etc/nftables.conf
etc/ssh/sshd_config.d
etc/security/limits.conf
etc/systemd
etc/rc.conf.d
etc/syslog-ng
etc/kernel
etc/dracut.conf.d
etc/default/grub
etc/default/docker
etc/pam.d
etc/tlp.conf
etc/NetworkManager
etc/fail2ban
etc/audit
etc/selinux
etc/greetd
etc/scx_loader
etc/conf.d/scx_loader
etc/chrony
usr/share/grub
usr/share/wayland-sessions
.chezmoiscripts/01-setup-selinux.sh
etc/.chezmoiscripts/01-setup-pam.sh
etc/.chezmoiscripts/03-setup-wifi.sh
{{- end }}
{{- if ne .kind "laptop" }}
etc/tlp.conf
{{- end }}

{{/* Certificates files */}}
{{- if ne .place "office" }}
etc/ca-certificates
usr/local/share/ca-certificates
{{- else }}
{{- /* Arch rebuilds its store with update-ca-trust from p11-kit anchors;
       Gentoo, Debian, Ubuntu and Alpine with update-ca-certificates from
       /usr/local/share (05-update-ca-store runs either). */}}
{{-   if ne .osid "linux-arch" }}
etc/ca-certificates/trust-source
{{-   else }}
usr/local/share/ca-certificates
{{-   end }}
{{- end }}

{{/* Input method */}}
{{- if empty .languages }}
etc/portage/**fcitx-configtool
etc/portage/**fcitx-m17n
{{- end }}
{{- if not (has "ja" .languages) }}
etc/portage/**mozc
{{- end }}
{{- if not (has "zh" .languages) }}
etc/portage/**fcitx-m17n
{{- end }}

{{/* Per machine */}}
{{- if ne .code "b0n9u4" }}
etc/pam.d/fprintd
etc/modprobe.d/rtw89.conf
{{- end }}
