# Paths are relative to the destination directory (/).

# The linux-firmware ebuild saves the list it installed as
# savedconfig/sys-kernel/linux-firmware-<version>, and savedconfig.eclass reads
# that file before the unversioned one managed here. Left in place, it silently
# overrides every later edit of linux-firmware.tmpl for the same version.
etc/portage/savedconfig/sys-kernel/linux-firmware-*

# Once applied from this repository, never read: gentoo-kernel only uses a
# saved config with USE=savedconfig, which is set nowhere. Dist kernels take
# config fragments from /etc/kernel/config.d instead.
etc/portage/savedconfig/sys-kernel/gentoo-kernel

# The hyprlang configuration of the login screen, replaced by hyprland.lua.
etc/greetd/hyprland.conf
