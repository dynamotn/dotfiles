{{- range .ntpServers }}
server {{ . }} iburst
{{- end }}

driftfile /var/lib/chrony/drift

# Step the clock when it is off by more than 1s in the first three updates,
# as ntpd -g did, so boot never waits for a one-shot sync.
makestep 1 3

# Keep the hardware clock in step with the system clock.
rtcsync
