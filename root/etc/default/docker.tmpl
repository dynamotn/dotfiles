{{- $secret := includeTemplate "machine/secret.tmpl" . | fromJson }}
{{- with $secret.httpProxy }}
export http_proxy={{ . | quote}}
export https_proxy={{ . | quote}}
{{- end }}
{{- with $secret.noProxyAddresses }}
export no_proxy={{ join "," . | quote }}
{{- end }}
{{- if $secret.httpProxy }}
# The NetworkManager dispatcher 90-dynet overrides the proxy above with the
# one of the network docker starts on, empty where it is out of reach
if [ -r /run/dynet/proxy.env ]; then
  set -a
  . /run/dynet/proxy.env
  set +a
fi
{{- end }}
