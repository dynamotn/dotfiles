#!/usr/bin/env bash
# @file 01-setup-pam.sh
# @brief Set up PAM for hardware key and fingerprint login
# @description Add the `pam_u2f` and `pam_fprintd` modules to the local login stack, when
# the machine is configured to use them.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

{{- if eq .chezmoi.os "linux" }}
dybatpho::header "Setup PAM"
{{-   range (joinPath .chezmoi.sourceDir "etc/pam.d/*" | glob) }}
# {{ . }} hash: {{ . | include | sha256sum }}
{{-   end }}
# An include of a missing file breaks the whole stack and locks out local
# login; an office VM gets no etc/pam.d from this repo.
if dybatpho::is file /etc/pam.d/system-local-login; then
  if dybatpho::is file /etc/pam.d/u2f \
    && ! grep -q '^auth\s*include\s*u2f' /etc/pam.d/system-local-login; then
    dybatpho::header "Adding pam_u2f to system-local-login"
    sed -i '1 i\auth include u2f' /etc/pam.d/system-local-login
  fi
  {{- if eq .code "b0n9u4" }}
  if dybatpho::is file /etc/pam.d/fprintd \
    && ! grep -q '^auth\s*include\s*fprintd' /etc/pam.d/system-local-login; then
    dybatpho::header "Adding pam_fprintd to system-local-login"
    sed -i '1 i\auth include fprintd' /etc/pam.d/system-local-login
  fi
  {{- end }}
fi
# sudo takes a touch of the key, else falls through to the password: u2f is
# `sufficient`, so a missing or unregistered key locks no one out.
if dybatpho::is file /etc/pam.d/sudo && dybatpho::is file /etc/pam.d/u2f \
  && ! grep -q '^auth\s*include\s*u2f' /etc/pam.d/sudo; then
  dybatpho::header "Adding pam_u2f to sudo"
  # dyshellint disable=BSG083 Linux only, where GNU and BusyBox sed take -i
  sed -i '1 i\auth include u2f' /etc/pam.d/sudo
fi
{{-   if eq .osid "linux-arch" "linux-ubuntu" }}
sed -i '/#auth\s*required\s*pam_wheel.so/s/^#//g' /etc/pam.d/su
sed -i '/#auth\s*required\s*pam_wheel.so/s/^#//g' /etc/pam.d/su-l
{{-   end }}
dybatpho::success "Setup PAM"
{{- end }}
