#!/usr/bin/env bash
# @file 03-setup-wifi.sh
# @brief Set up the known Wi-Fi networks
# @description Set up the known Wi-Fi networks for the network manager of this machine.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh
dybatpho::register_common_handlers

{{- if and (eq .chezmoi.os "linux") .hasWifi }}
dybatpho::header "Setup Wi-Fi"
if ! dybatpho::is command nmcli; then
  dybatpho::warn "nmcli is not installed. Please install NetworkManager if need."
  exit
fi

# Values are single-quoted for the shell: a quote, `$` or backtick in a
# password must reach nmcli as itself, not run as code.
device=$(nmcli --get-values GENERAL.DEVICE,GENERAL.TYPE device show | sed '/^wifi$/!{h;d;};x')
{{-   if .decryptPersonal }}
# hash: {{ joinPath .chezmoi.sourceDir "../secrets/data/personal/wifi.yaml.tmpl" | include | sha256sum }}
{{-     $wifiSecret := includeTemplate (join .chezmoi.sourceDir "../secrets/data/personal/wifi.yaml.tmpl") . | fromYaml }}
{{-     range $wifiSecret }}
rm -f -- /etc/NetworkManager/system-connections/{{ .name | replace "'" "'\\''" | printf "'%s'" }}-*.nmconnection
nmcli connection add type wifi \
  ifname "${device}" \
  con-name {{ .name | replace "'" "'\\''" | printf "'%s'" }} \
  autoconnect yes \
  ssid {{ .ssid | replace "'" "'\\''" | printf "'%s'" }} \
  wifi-sec.key-mgmt {{ .type | replace "'" "'\\''" | printf "'%s'" }} \
{{-       if eq .type "wpa-psk" }}
  wifi-sec.psk {{ .password | replace "'" "'\\''" | printf "'%s'" }}
{{-       else if eq .type "wpa-eap" }}
  802-1x.identity {{ .identity | replace "'" "'\\''" | printf "'%s'" }} \
  802-1x.password {{ .password | replace "'" "'\\''" | printf "'%s'" }} \
  {{- .params | nindent 2 }}
{{-       end }}
{{-     end }}
{{-   end }}
{{-   range .decryptEnterprise }}
{{-     if not (stat (printf "../secrets/data/enterprise-%s/wifi.yaml.age" . | joinPath $.chezmoi.sourceDir)) }}
{{-       continue }}
{{-     end }}
# hash: {{ printf "../secrets/data/enterprise-%s/common.yaml.age" . | joinPath $.chezmoi.sourceDir | include | sha256sum }}
# hash: {{ printf "../secrets/data/enterprise-%s/wifi.yaml.age" . | joinPath $.chezmoi.sourceDir | include | sha256sum }}
{{-     $commonSecret := printf "../secrets/data/enterprise-%s/common.yaml.age" . | joinPath $.chezmoi.sourceDir | include | decrypt | fromYaml }}
{{-     $wifiSecret := printf "../secrets/data/enterprise-%s/wifi.yaml.age" . | joinPath $.chezmoi.sourceDir | include | decrypt | fromYaml }}
{{-     range $wifiSecret }}
rm -f -- /etc/NetworkManager/system-connections/{{ .name | replace "'" "'\\''" | printf "'%s'" }}-*.nmconnection
nmcli connection add type wifi \
  ifname "${device}" \
  con-name {{ .name | replace "'" "'\\''" | printf "'%s'" }} \
  autoconnect yes \
  ssid {{ .ssid | replace "'" "'\\''" | printf "'%s'" }} \
  wifi-sec.key-mgmt {{ .type | replace "'" "'\\''" | printf "'%s'" }} \
{{-       if eq .type "wpa-psk" }}
  wifi-sec.psk {{ .password | replaceAllRegex "\\$ACCOUNT_PASSWORD" $commonSecret.account.password | replace "'" "'\\''" | printf "'%s'" }}
{{-       else if eq .type "wpa-eap" }}
  802-1x.identity {{ .identity | replaceAllRegex "\\$ACCOUNT_USERNAME" $commonSecret.account.username | replace "'" "'\\''" | printf "'%s'" }} \
  802-1x.password {{ .password | replaceAllRegex "\\$ACCOUNT_PASSWORD" $commonSecret.account.password | replace "'" "'\\''" | printf "'%s'" }} \
  {{- .params | nindent 2 }}
{{-       end }}
{{-     end }}
{{-   end }}

{{- if eq .initSystem "systemd" }}
systemctl restart NetworkManager
{{- else if eq .initSystem "openrc" }}
rc-service NetworkManager restart
{{- end }}
dybatpho::success "Setup Wi-Fi"
{{- end }}
