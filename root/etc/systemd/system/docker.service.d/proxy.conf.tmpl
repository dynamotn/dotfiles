{{- $secret := includeTemplate "machine/secret.tmpl" . | fromJson }}
{{- if $secret.httpProxy }}
[Service]
Environment="http_proxy={{ $secret.httpProxy }}"
Environment="https_proxy={{ $secret.httpProxy }}"
{{-   with $secret.noProxyAddresses }}
Environment="no_proxy={{ join "," . }}"
{{-   end }}
{{- end }}
