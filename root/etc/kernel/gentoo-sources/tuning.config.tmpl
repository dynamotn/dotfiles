{{- if eq .code "l30n4rd0d4v1nc1" -}}
{{/*
  Tuning merged over base.config by scripts/kernel.sh. Every line here is
  verified after `make olddefconfig`: one that Kconfig silently drops (a
  missing dependency, a renamed symbol) fails the build instead of shipping.
*/}}
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
{{/* use zstd for compress kernel and modules */}}
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_ZSTD=y
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_COMPRESS_ZSTD=y
{{/* keep EFI GPT and MBR (sda and most USB sticks are MBR), drop the rest */}}
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
# CONFIG_ACORN_PARTITION is not set
# CONFIG_AIX_PARTITION is not set
# CONFIG_OSF_PARTITION is not set
# CONFIG_AMIGA_PARTITION is not set
# CONFIG_ATARI_PARTITION is not set
# CONFIG_MAC_PARTITION is not set
# CONFIG_BSD_DISKLABEL is not set
# CONFIG_MINIX_SUBPARTITION is not set
# CONFIG_SOLARIS_X86_PARTITION is not set
# CONFIG_UNIXWARE_DISKLABEL is not set
# CONFIG_LDM_PARTITION is not set
# CONFIG_SGI_PARTITION is not set
# CONFIG_ULTRIX_PARTITION is not set
# CONFIG_SUN_PARTITION is not set
# CONFIG_KARMA_PARTITION is not set
# CONFIG_SYSV68_PARTITION is not set
# CONFIG_CMDLINE_PARTITION is not set
{{/* disable network protocols, matching etc/modprobe.d/unsecure-protocol.conf */}}
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_AF_RXRPC is not set
# CONFIG_IP_SCTP is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set
{{/* root, home and var are btrfs, the ESP is vfat */}}
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VFAT_FS=m
{{/* removable media and the Windows disk, as modules loaded on demand */}}
CONFIG_EXT4_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
{{/* disable unused filesystems */}}
# CONFIG_MSDOS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_ZONEFS_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_ORANGEFS_FS is not set
# CONFIG_ADFS_FS is not set
# CONFIG_AFFS_FS is not set
# CONFIG_ECRYPT_FS is not set
# CONFIG_HFS_FS is not set
# CONFIG_HFSPLUS_FS is not set
# CONFIG_BEFS_FS is not set
# CONFIG_BFS_FS is not set
# CONFIG_EFS_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_MINIX_FS is not set
# CONFIG_OMFS_FS is not set
# CONFIG_HPFS_FS is not set
# CONFIG_QNX4FS_FS is not set
# CONFIG_QNX6FS_FS is not set
# CONFIG_ROMFS_FS is not set
# CONFIG_UFS_FS is not set
{{/* SELinux as the major LSM, permissive-capable until relabelled */}}
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SMACK is not set
{{- if eq .initSystem "openrc" }}
CONFIG_GENTOO_LINUX_INIT_SCRIPT=y
# CONFIG_GENTOO_LINUX_INIT_SYSTEMD is not set
{{- else }}
# CONFIG_GENTOO_LINUX_INIT_SCRIPT is not set
CONFIG_GENTOO_LINUX_INIT_SYSTEMD=y
{{- end }}
{{/*
  Hardening that costs little stays on: KASLR, IBT, shadow stack, stack
  protector, FORTIFY, hardened usercopy and freelist, zeroed allocations and
  every CPU mitigation. The KSPP bundle is off: it forbids hibernation, forces
  strict IOMMU and panics on any oops, which with the proprietary NVIDIA
  module turns a recoverable driver bug into a lost session.
*/}}
# CONFIG_GENTOO_KERNEL_SELF_PROTECTION is not set
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_KFENCE=y
CONFIG_CPU_MITIGATIONS=y
{{/* debug-grade checks with a measurable cost on every allocation or list op */}}
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CONFIG_UBSAN is not set
# CONFIG_PAGE_TABLE_CHECK is not set
# CONFIG_PAGE_POISONING is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_SG is not set
# CONFIG_PANIC_ON_OOPS is not set
{{/* keep BTF for bcc and sched_ext, compress the debug info with zstd */}}
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=m
{{/* Zen 3 only: build for this CPU, drop other vendors and platforms */}}
CONFIG_X86_NATIVE_CPU=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_AMD=y
# CONFIG_CPU_SUP_INTEL is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set
{{/* 16 cores / 32 threads */}}
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=64
{{/* keep KVM for AMD, disable other virtualization hypervisor */}}
CONFIG_KVM=m
CONFIG_KVM_AMD=m
# CONFIG_KVM_AMD_SEV is not set
# CONFIG_KVM_INTEL is not set
# CONFIG_KVM_HYPERV is not set
# CONFIG_KVM_XEN is not set
CONFIG_KVM_MAX_NR_VCPUS=1024
CONFIG_KVM_GUEST=y
# CONFIG_XEN is not set
# CONFIG_PVH is not set
# CONFIG_ACRN_GUEST is not set
# CONFIG_INTEL_TDX_GUEST is not set
{{/* low latency desktop, still switchable at boot with preempt= */}}
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
{{/* tickless only when idle: NO_HZ_FULL taxes every syscall on a desktop */}}
CONFIG_NO_HZ_IDLE=y
CONFIG_SCHED_CLASS_EXT=y
{{/* keep a process's threads on one L3: the 5950X has two CCDs, each with its own */}}
CONFIG_SCHED_CACHE=y
{{/* CPU frequency scaling: amd-pstate active mode (EPP) */}}
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
{{/*
  Memory: THP only on madvise, avoiding compaction stalls with 16G of RAM;
  MGLRU and zstd zswap in front of the swap partition.
*/}}
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
{{/* the kernel command line resumes from swap */}}
CONFIG_HIBERNATION=y
{{/* boot from NVMe, lm-sensors for NVMe */}}
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_HWMON=y
{{/* drivers on mainboard & chipset */}}
CONFIG_I2C_PIIX4=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_SENSORS_IT87=m
CONFIG_GIGABYTE_WMI=m
CONFIG_SP5100_TCO=m
CONFIG_AMD_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
{{/*
  The proprietary NVIDIA module needs the DRM KMS and TTM helpers, which only
  a DRM driver can select: nouveau stays a module for that, and as a fallback,
  while nvidia-drivers blacklists it at runtime.
*/}}
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_KMS_HELPER=m
CONFIG_DRM_TTM_HELPER=m
CONFIG_SYSVIPC=y
CONFIG_X86_PAT=y
# CONFIG_LOCKDEP is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_SLUB_DEBUG_ON is not set
# CONFIG_PREEMPT_RT is not set
{{- end }}
