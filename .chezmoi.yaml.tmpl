{{- /* chezmoi reads this template through the home/.chezmoi.yaml.tmpl link,
       as .chezmoiroot points at home/. The source is the repository itself,
       its working tree, not home/ which .chezmoi.sourceDir names here. */}}
sourceDir: {{ .chezmoi.workingTree | quote }}
encryption: age
format: yaml
mode: symlink
{{- if stdinIsATTY }}
progress: true
{{- end }}

# Uncomment the following line to set umask for MacOS root system
# umask: 0o02

add:
  templateSymlinks: true

# A pager that is not installed makes every `chezmoi diff` fail.
{{- if lookPath "hunk" }}
diff:
  pager: hunk pager
{{- else if lookPath "delta" }}
diff:
{{-   if lookPath "ov" }}
  pager: delta --pager="ov -F --section-delimiter '^(added:|removed:|renamed:|Δ)' --section-header --pattern '•'"
{{-   else }}
  pager: delta
{{-   end }}
{{- end }}

data:
  {{- $osid := .chezmoi.os }}
  {{- if hasKey .chezmoi.osRelease "id" }}
  {{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id }}
  {{- end }}
  osid: {{ $osid | quote }}

  {{- /* Container detection. The markers come first: Docker and Podman drop a
         file, systemd-nspawn, LXC and toolbox export `container`, dev
         containers and Kubernetes set their own variables. The control groups
         of PID 1 are the last resort, as on cgroup v2 they rarely name the
         runtime. */}}
  {{- $inContainer := false }}
  {{- if eq .chezmoi.os "linux" }}
  {{-   if or (env "container") (stat "/run/.containerenv") (stat "/.dockerenv") }}
  {{-     $inContainer = true }}
  {{-   else if or (env "CODESPACES") (env "REMOTE_CONTAINERS") (env "DEVCONTAINER") (env "KUBERNETES_SERVICE_HOST") }}
  {{-     $inContainer = true }}
  {{-   else if stat "/proc/1/cgroup" }}
  {{-     if include "/proc/1/cgroup" | regexMatch "docker|containerd|kubepods|libpod|podman|lxc" }}
  {{-       $inContainer = true }}
  {{-     end }}
  {{-   end }}
  {{- end }}
  inContainer: {{ $inContainer }}

  {{- /* The init system that runs, not the one installed: a container image
         carries systemd or OpenRC files but boots neither. /proc/1/comm is
         read rather than `ps`, which BusyBox and minimal images lack. "none"
         means nothing manages services. */}}
  {{- $initSystem := "none" }}
  {{- if eq .chezmoi.os "android" }}
  {{-   $initSystem = "termux" }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $initSystem = "launchd" }}
  {{- else if eq .chezmoi.os "linux" }}
  {{-   $initCommand := "" }}
  {{-   if stat "/proc/1/comm" }}
  {{-     $initCommand = include "/proc/1/comm" | trim }}
  {{-   end }}
  {{-   if or (stat "/run/systemd/system") (eq $initCommand "systemd") }}
  {{-     $initSystem = "systemd" }}
  {{-   else if or (stat "/run/openrc") (eq $initCommand "openrc-init") }}
  {{-     $initSystem = "openrc" }}
  {{-   else if not $inContainer }}
  {{- /* Not booted from this root, as in a chroot during installation:
         fall back to the init system that is installed. */}}
  {{-     if or (eq $osid "linux-alpine") (lookPath "openrc") (stat "/sbin/openrc") }}
  {{-       $initSystem = "openrc" }}
  {{-     else if or (stat "/usr/lib/systemd/systemd") (stat "/lib/systemd/systemd") }}
  {{-       $initSystem = "systemd" }}
  {{-     end }}
  {{-   end }}
  {{- end }}
  initSystem: {{ $initSystem | quote }}
  {{- if eq .chezmoi.os "android" }}
  bash: {{ lookPath "bash" | quote }}
  {{- else }}
  bash: "/usr/bin/env bash"
  {{- end }}

  {{- /* The answers of a machine listed in .chezmoidata/machines.yaml are
         taken from there; only the fields it leaves out are prompted. The
         code comes first, as it is what picks the entry. */}}
  {{- $code := promptStringOnce . "code" "What is this machine's name" "t00lb0x" }}
  code: {{ $code | quote }}
  {{- $machines := dict }}
  {{- $machinesFile := joinPath .chezmoi.sourceDir ".chezmoidata" "machines.yaml" }}
  {{- if stat $machinesFile }}
  {{-   $machines = include $machinesFile | fromYaml | dig "machines" dict }}
  {{- end }}
  {{- $m := dig $code dict $machines }}

  {{- /* The options of the choice questions, from .chezmoidata/choices.yaml
         and companies.yaml. `$options` holds what each question offers, with
         " " for its empty option as promptChoice cannot offer "", `$defaults`
         its default and `$hints` the " (X for Y, ...)" of its prompt. */}}
  {{- $dataDir := joinPath .chezmoi.sourceDir ".chezmoidata" }}
  {{- $choices := include (joinPath $dataDir "choices.yaml") | fromYaml | dig "choices" dict }}
  {{- $companies := include (joinPath $dataDir "companies.yaml") | fromYaml | dig "companies" list }}
  {{- $options := dict }}
  {{- $defaults := dict }}
  {{- $hints := dict }}
  {{- range $field, $choice := $choices }}
  {{-   $values := list }}
  {{-   $parts := list }}
  {{-   $labels := dig "labels" dict $choice }}
  {{-   range $choice.options }}
  {{-     $option := toString . }}
  {{-     if $option }}
  {{-       $values = append $values $option }}
  {{-       if hasKey $labels $option }}
  {{-         $parts = append $parts (printf "%s for %s" $option (index $labels $option)) }}
  {{-       end }}
  {{-     else }}
  {{-       $values = append $values " " }}
  {{-     end }}
  {{-   end }}
  {{-   if and $parts (has " " $values) }}
  {{-     $parts = append $parts "or empty" }}
  {{-   end }}
  {{-   $_ := set $options $field $values }}
  {{-   $_ = set $defaults $field (dig "default" (first $values) $choice | toString) }}
  {{-   $_ = set $hints $field (ternary (printf " (%s)" (join ", " $parts)) "" (gt (len $parts) 0)) }}
  {{- end }}

  {{- $places := index $options "place" }}
  {{- $place := "" }}
  {{- if hasKey $m "place" }}
  {{-   $place = $m.place }}
  {{-   if not (has $place $places) }}
  {{-     fail (printf "machines.yaml: place=%s of %s is not one of %s" $place $code (join ", " $places)) }}
  {{-   end }}
  {{- else }}
  {{-   $place = promptChoiceOnce . "place" "Where does this machine place" $places (index $defaults "place") }}
  {{- end }}
  place: {{ $place | quote }}
  {{- /* DOTFILES_KIND wins over the stored answer and the prompt, so an image
         build or a provisioning script can say what it builds. */}}
  {{- $kinds := index $options "kind" }}
  {{- $kind := env "DOTFILES_KIND" }}
  {{- if $kind }}
  {{-   if not (has $kind $kinds) }}
  {{-     fail (printf "DOTFILES_KIND=%s is not one of %s" $kind (join ", " $kinds)) }}
  {{-   end }}
  {{- else if hasKey $m "kind" }}
  {{-   $kind = $m.kind }}
  {{-   if not (has $kind $kinds) }}
  {{-     fail (printf "machines.yaml: kind=%s of %s is not one of %s" $kind $code (join ", " $kinds)) }}
  {{-   end }}
  {{- else }}
  {{-   $defaultKind := index $defaults "kind" }}
  {{-   if $inContainer }}
  {{-     $defaultKind = "container" }}
  {{-   end }}
  {{-   $kind = promptChoiceOnce . "kind" "Which kind of this machine is" $kinds $defaultKind }}
  {{- end }}
  kind: {{ $kind | quote }}

  {{- $company := "" }}
  {{- if eq $place "office" }}
  {{-   if hasKey $m "company" }}
  {{-     $company = $m.company }}
  {{-     if not (has $company $companies) }}
  {{-       fail (printf "machines.yaml: company=%s of %s is not one of %s" $company $code (join ", " $companies)) }}
  {{-     end }}
  {{-   else }}
  {{-     $company = promptChoiceOnce . "company" "Which code of owner company is" $companies (first $companies) }}
  {{-   end }}
  {{- end }}
  {{- if $company }}
  company: {{ $company | quote }}
  {{- else }}
  company:
  {{- end }}

  {{- $decryptPersonal := false }}
  {{- if hasKey $m "decryptPersonal" }}
  {{-   $decryptPersonal = $m.decryptPersonal }}
  {{- else }}
  {{-   $decryptPersonal = promptBoolOnce . "decryptPersonal" "Do you want to decrypt personal's secrets (y/n)" false }}
  {{- end }}
  decryptPersonal: {{ $decryptPersonal }}
  {{- $decryptEnterprise := list }}
  {{- if hasKey $m "decryptEnterprise" }}
  {{-   $decryptEnterprise = $m.decryptEnterprise | default list }}
  {{-   range $decryptEnterprise }}
  {{-     if not (has . $companies) }}
  {{-       fail (printf "machines.yaml: decryptEnterprise of %s has %s, not one of %s" $code . (join ", " $companies)) }}
  {{-     end }}
  {{-   end }}
  {{- else }}
  {{-   $decryptEnterprise = promptMultichoiceOnce . "decryptEnterprise" "Which company's secrets do you want to decrypt" $companies list }}
  {{- end }}
  {{- if $decryptEnterprise }}
  decryptEnterprise:
    {{ toYaml $decryptEnterprise | indent 4 | trim }}
  {{- else }}
  decryptEnterprise: []
  {{- end }}

  {{- $guiServers := index $options "guiServer" }}
  {{- $guiServer := "" }}
  {{- if hasKey $m "guiServer" }}
  {{-   $guiServer = $m.guiServer | toString }}
  {{-   if not (has $guiServer $guiServers) }}
  {{-     fail (printf "machines.yaml: guiServer=%s of %s is not one of %s" $guiServer $code (join ", " $guiServers)) }}
  {{-   end }}
  {{- else }}
  {{-   $guiServer = promptChoiceOnce . "guiServer" (printf "Which GUI server of this machine is%s" (index $hints "guiServer")) $guiServers (index $defaults "guiServer") }}
  {{- end }}
  guiServer: {{ $guiServer | quote }}
  {{- $guiDrivers := index $options "guiDriver" }}
  {{- $guiDriver := "" }}
  {{- $guiWinManagers := index $options "guiWinManager" }}
  {{- $guiWinManager := "" }}
  {{- if ne $guiServer "0" }}
  {{-   if hasKey $m "guiDriver" }}
  {{-     $guiDriver = $m.guiDriver }}
  {{-     if not (has $guiDriver $guiDrivers) }}
  {{-       fail (printf "machines.yaml: guiDriver=%s of %s is not one of %s" $guiDriver $code (join ", " $guiDrivers)) }}
  {{-     end }}
  {{-   else }}
  {{-     $guiDriver = promptChoiceOnce . "guiDriver" (printf "Which GUI video driver of this machine is%s" (index $hints "guiDriver")) $guiDrivers (index $defaults "guiDriver") }}
  {{-   end }}
  {{-   if hasKey $m "guiWinManager" }}
  {{-     $guiWinManager = $m.guiWinManager }}
  {{-     if not (has $guiWinManager $guiWinManagers) }}
  {{-       fail (printf "machines.yaml: guiWinManager=%s of %s is not one of %s" $guiWinManager $code (join ", " $guiWinManagers)) }}
  {{-     end }}
  {{-   else }}
  {{-     $guiWinManager = promptChoiceOnce . "guiWinManager" (printf "Which GUI window manager of this machine is%s" (index $hints "guiWinManager")) $guiWinManagers (index $defaults "guiWinManager") }}
  {{-   end }}
  {{- end }}
  guiDriver: {{ $guiDriver | quote }}
  guiWinManager: {{ $guiWinManager | quote }}

  {{- $languages := list }}
  {{- if ne $guiServer "0" }}
  {{-   $supportedLanguages := index $options "languages" }}
  {{-   if hasKey $m "languages" }}
  {{-     $languages = $m.languages | default list }}
  {{-     range $languages }}
  {{-       if not (has . $supportedLanguages) }}
  {{-         fail (printf "machines.yaml: languages of %s has %s, not one of %s" $code . (join ", " $supportedLanguages)) }}
  {{-       end }}
  {{-     end }}
  {{-   else }}
  {{-     $languages = promptMultichoiceOnce . "languages" "Which languages do you want to use in input method framework" $supportedLanguages list }}
  {{-   end }}
  {{- end }}
  {{- if $languages }}
  languages:
    {{ toYaml $languages | indent 4 | trim }}
  {{- else }}
  languages: []
  {{- end }}

  {{- $browsers := index $options "browser" }}
  {{- $browser := "" }}
  {{- $browserEnterpriseProfiles := list }}
  {{- if ne $guiServer "0" }}
  {{-   if hasKey $m "browser" }}
  {{-     $browser = $m.browser | default "" | trim }}
  {{-     if and $browser (not (has $browser $browsers)) }}
  {{-       fail (printf "machines.yaml: browser=%s of %s is not one of %s" $browser $code (join ", " $browsers)) }}
  {{-     end }}
  {{-   else }}
  {{-     $browser = promptChoiceOnce . "browser" (printf "Which web browser do you use%s" (index $hints "browser")) $browsers (index $defaults "browser") | trim }}
  {{-   end }}
  {{-   if $browser }}
  {{-     if hasKey $m "browserEnterpriseProfiles" }}
  {{-       $browserEnterpriseProfiles = $m.browserEnterpriseProfiles | default list }}
  {{-       range $browserEnterpriseProfiles }}
  {{-         if not (has . $decryptEnterprise) }}
  {{-           fail (printf "machines.yaml: browserEnterpriseProfiles of %s has %s, which decryptEnterprise lacks" $code .) }}
  {{-         end }}
  {{-       end }}
  {{-     else }}
  {{-       $browserEnterpriseProfiles = promptMultichoiceOnce . "browserEnterpriseProfiles" "Which company's browser profiles do you want to decrypt" $decryptEnterprise list }}
  {{-     end }}
  {{-   end }}
  {{- end }}
  browser: {{ $browser | quote }}
  {{- if $browserEnterpriseProfiles }}
  browserEnterpriseProfiles:
    {{ toYaml $browserEnterpriseProfiles | indent 4 | trim }}
  {{- else }}
  browserEnterpriseProfiles: []
  {{- end }}

  {{- $mailClients := index $options "mailClient" }}
  {{- $mailClient := "" }}
  {{- $mailEnterpriseProfiles := list }}
  {{- if ne $guiServer "0" }}
  {{-   if hasKey $m "mailClient" }}
  {{-     $mailClient = $m.mailClient | default "" | trim }}
  {{-     if and $mailClient (not (has $mailClient $mailClients)) }}
  {{-       fail (printf "machines.yaml: mailClient=%s of %s is not one of %s" $mailClient $code (join ", " $mailClients)) }}
  {{-     end }}
  {{-   else }}
  {{-     $mailClient = promptChoiceOnce . "mailClient" (printf "Which email client do you use%s" (index $hints "mailClient")) $mailClients (index $defaults "mailClient") | trim }}
  {{-   end }}
  {{-   if $mailClient }}
  {{-     if hasKey $m "mailEnterpriseProfiles" }}
  {{-       $mailEnterpriseProfiles = $m.mailEnterpriseProfiles | default list }}
  {{-       range $mailEnterpriseProfiles }}
  {{-         if not (has . $decryptEnterprise) }}
  {{-           fail (printf "machines.yaml: mailEnterpriseProfiles of %s has %s, which decryptEnterprise lacks" $code .) }}
  {{-         end }}
  {{-       end }}
  {{-     else }}
  {{-       $mailEnterpriseProfiles = promptMultichoiceOnce . "mailEnterpriseProfiles" "Which company's mail profiles do you want to decrypt" $decryptEnterprise list }}
  {{-     end }}
  {{-   end }}
  {{- end }}
  mailClient: {{ $mailClient | quote }}
  {{- if $mailEnterpriseProfiles }}
  mailEnterpriseProfiles:
    {{ toYaml $mailEnterpriseProfiles | indent 4 | trim }}
  {{- else }}
  mailEnterpriseProfiles: []
  {{- end }}

  {{- $terminalMultiplexers := index $options "terminalMultiplexer" }}
  {{- $terminalMultiplexer := "" }}
  {{- if hasKey $m "terminalMultiplexer" }}
  {{-   $terminalMultiplexer = $m.terminalMultiplexer }}
  {{-   if not (has $terminalMultiplexer $terminalMultiplexers) }}
  {{-     fail (printf "machines.yaml: terminalMultiplexer=%s of %s is not one of %s" $terminalMultiplexer $code (join ", " $terminalMultiplexers)) }}
  {{-   end }}
  {{- else }}
  {{-   $terminalMultiplexer = promptChoiceOnce . "terminalMultiplexer" (printf "Which terminal multiplexer do you use%s" (index $hints "terminalMultiplexer")) $terminalMultiplexers (index $defaults "terminalMultiplexer") }}
  {{- /* promptChoiceOnce hands a stored answer back unchecked: one that is
           no longer offered, as tmux, becomes the default instead of leaving
           the machine with no multiplexer at all. */}}
  {{-   if not (has $terminalMultiplexer $terminalMultiplexers) }}
  {{-     $terminalMultiplexer = index $defaults "terminalMultiplexer" }}
  {{-   end }}
  {{- end }}
  terminalMultiplexer: {{ $terminalMultiplexer | quote }}

  {{- /* The yes/no questions, as field, prompt and default. */}}
  {{- $booleans := list
        (list "hasSound" "Does this machine has a sound card (y/n)" false)
        (list "hasBluetooth" "Does this machine has a bluetooth card (y/n)" false)
        (list "hasWifi" "Does this machine has a wifi card (y/n)" false)
        (list "preferGitSSH" "Do you want to prefer SSH than HTTPS for git (y/n)" false)
        (list "darkMode" "Do you want to use dark mode (y/n)" true) }}
  {{- range $booleans }}
  {{-   $field := index . 0 }}
  {{-   if hasKey $m $field }}
  {{ $field }}: {{ index $m $field }}
  {{-   else }}
  {{ $field }}: {{ promptBoolOnce $ $field (index . 1) (index . 2) }}
  {{-   end }}
  {{- end }}
  {{- /* httpProxy, noProxyAddresses and customHostname are not asked here:
         they are secrets of the machine, which machine/secret.tmpl decrypts
         at apply time from secrets/data/<identity>/machine.yaml.age. */}}

age:
  identities:
    {{- if $decryptPersonal }}
    - {{ .chezmoi.homeDir }}/.config/chezmoi/personal.key
    {{- end }}
    {{- if $decryptEnterprise }}
    - {{ .chezmoi.homeDir }}/.config/chezmoi/enterprise-shared.key
    {{- end }}
    {{-  range $decryptEnterprise }}
    - {{ $.chezmoi.homeDir }}/.config/chezmoi/enterprise-{{ . }}.key
    {{-  end }}
  {{- /* The public keys of every identity, from .chezmoidata/age.yaml: a
         company without one fails here rather than encrypting without it. */}}
  {{- $recipients := include (joinPath $dataDir "age.yaml") | fromYaml | dig "ageRecipients" dict }}
  {{- $enterpriseRecipients := dig "enterprise" dict $recipients }}
  {{- $wanted := list }}
  {{- if $decryptPersonal }}
  {{-   $wanted = append $wanted (list "personal" (dig "personal" "" $recipients)) }}
  {{- end }}
  {{- if $decryptEnterprise }}
  {{-   $wanted = append $wanted (list "enterprise.shared" (dig "shared" "" $enterpriseRecipients)) }}
  {{- end }}
  {{- range $decryptEnterprise }}
  {{-   $wanted = append $wanted (list (printf "enterprise.%s" .) (dig . "" $enterpriseRecipients)) }}
  {{- end }}
  recipients:
    {{- range $wanted }}
    {{-   if not (index . 1) }}
    {{-     fail (printf "age.yaml: no ageRecipients.%s" (index . 0)) }}
    {{-   end }}
    - {{ index . 1 }}
    {{- end }}
