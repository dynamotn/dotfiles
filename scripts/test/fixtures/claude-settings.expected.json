{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 20,
  "effortLevel": "medium",
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "appsec-skills@agent-sec-ops-kit-skills": false,
    "caveman@caveman": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "claude-security@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "compliance-skills@agent-sec-ops-kit-skills": false,
    "context-mode@context-mode": true,
    "context7@claude-plugins-official": true,
    "devsecops-skills@agent-sec-ops-kit-skills": false,
    "differential-review@trailofbits": true,
    "duckdb-skills@claude-plugins-official": false,
    "dyai-lsp@dyai-lsp": true,
    "elements-of-style@superpowers-marketplace": true,
    "episodic-memory@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "incident-response-skills@agent-sec-ops-kit-skills": false,
    "insecure-defaults@trailofbits": true,
    "lua-lsp@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "modern-python@trailofbits": true,
    "obsidian@obsidian-skills": true,
    "offsec-skills@agent-sec-ops-kit-skills": false,
    "playwright@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "redis-development@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "second-opinion@trailofbits": true,
    "secsdlc-skills@agent-sec-ops-kit-skills": false,
    "secskills-core@secskills-marketplace": false,
    "secskills-defense@secskills-marketplace": false,
    "secskills-offense@secskills-marketplace": false,
    "security-guidance@claude-plugins-official": true,
    "semgrep@claude-plugins-official": true,
    "sharp-edges@trailofbits": true,
    "skill-creator@claude-plugins-official": true,
    "static-analysis@trailofbits": true,
    "superpowers@claude-plugins-official": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "telegram@claude-plugins-official": true,
    "testing-handbook-skills@trailofbits": false,
    "threatmodel-skills@agent-sec-ops-kit-skills": false,
    "trailmark@trailofbits": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "agent-sec-ops-kit-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/AgentSecOps/SecOpsAgentKit.git"
      }
    },
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "context-mode": {
      "source": {
        "repo": "mksglu/context-mode",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "source": {
        "repo": "ayghri/i-have-adhd",
        "source": "github"
      }
    },
    "obsidian-skills": {
      "source": {
        "repo": "kepano/obsidian-skills",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "secskills-marketplace": {
      "source": {
        "repo": "trilwu/secskills",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    },
    "thedotmack": {
      "source": {
        "repo": "thedotmack/claude-mem",
        "source": "github"
      }
    },
    "trailofbits": {
      "source": {
        "repo": "trailofbits/skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Prompt waiting for your input!' --icon=dialog-information; true",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Permission requested' --icon=dialog-question; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/window-question.oga ] && paplay /usr/share/sounds/freedesktop/stereo/window-question.oga; } 2>/dev/null; true",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/lint-shell.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.claude/hooks/log-skill.sh",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/AGENTS.md\"; if [ -f \"$f\" ] && ! [ -f \"${f%AGENTS.md}CLAUDE.md\" ]; then echo '=== AGENTS.md (project rules) ==='; cat \"$f\"; else true; fi",
            "statusMessage": "Loading AGENTS.md...",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Task finished!' --icon=dialog-information; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/complete.oga ] && paplay /usr/share/sounds/freedesktop/stereo/complete.oga; } 2>/dev/null; true",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/verify-on-stop.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/worktree-create.sh",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/worktree-remove.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(rtk git push)",
      "Bash(rtk git push *)",
      "Bash(git reset --hard:*)",
      "Bash(rtk git reset --hard:*)",
      "Bash(git clean *)",
      "Bash(rtk git clean *)",
      "Bash(git branch -D *)",
      "Bash(rtk git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(rtk git tag -d *)",
      "Bash(git stash drop:*)",
      "Bash(rtk git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(rtk git stash clear:*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(shred *)",
      "Bash(sudo *)",
      "Bash(emerge *)",
      "Bash(pacman *)",
      "Bash(paru *)",
      "Bash(chezmoi apply:*)",
      "Bash(chezmoi destroy:*)",
      "Bash(chezmoi forget:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(**/secrets/data/**)",
      "Edit(**/secrets/data/**)",
      "Read(**/*.age)",
      "Edit(**/*.age)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.password-store/**)",
      "Read(~/.local/share/keyrings/**)",
      "Bash(chezmoi-dycrypt:*)",
      "Bash(age -d *)",
      "Bash(age --decrypt *)",
      "Bash(sops -d *)",
      "Bash(sops --decrypt *)",
      "Bash(gpg -d *)",
      "Bash(gpg --decrypt *)",
      "Bash(pass show *)",
      "Bash(vault read *)",
      "Bash(op read *)",
      "Bash(aws configure get *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "git *",
      "rtk git *",
      "docker *",
      "podman *",
      "chezmoi *",
      "dyai *",
      "mise *",
      "sudo *",
      "emerge *",
      "systemctl *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/.bun/install/cache",
        "~/.cache/go-build",
        "~/.cache/pip",
        "~/.cache/uv",
        "~/.cargo/registry",
        "~/.local/share/rtk"
      ],
      "denyWrite": [
        "~/.local/bin",
        "~/.cache/.bun/bin",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.local/share/nvim/mason",
        "~/.claude/plugins",
        "~/.krew/bin",
        "~/.hunk/bin"
      ]
    },
    "network": {
      "allowedDomains": [
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "index.crates.io",
        "static.crates.io"
      ]
    }
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen"
}
