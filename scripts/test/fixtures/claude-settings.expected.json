{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 20,
  "effortLevel": "medium",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Prompt waiting for your input!' --icon=dialog-information; true",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": true,
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Permission requested' --icon=dialog-question; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/window-question.oga ] && paplay /usr/share/sounds/freedesktop/stereo/window-question.oga; } 2>/dev/null; true",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/lint-shell.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.claude/hooks/log-skill.sh",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "bash ~/.claude/hooks/log-agent.sh",
            "type": "command"
          }
        ],
        "matcher": "Agent|Task"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/AGENTS.md\"; if [ -f \"$f\" ] && ! [ -f \"${f%AGENTS.md}CLAUDE.md\" ]; then echo '=== AGENTS.md (project rules) ==='; cat \"$f\"; else true; fi",
            "statusMessage": "Loading AGENTS.md...",
            "type": "command"
          },
          {
            "command": "command -v dyai >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0; out=\"$(dyai status --quiet 2>&1)\"; [ -z \"$out\" ] || jq -n --arg m \"$out\" '{systemMessage: (\"dyai drift:\\n\" + $m), hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: (\"dyai drift between the config and the installed agents:\\n\" + $m)}}'; true",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Task finished!' --icon=dialog-information; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/complete.oga ] && paplay /usr/share/sounds/freedesktop/stereo/complete.oga; } 2>/dev/null; true",
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/verify-on-stop.sh",
            "timeout": 30,
            "type": "command"
          },
          {
            "async": true,
            "command": "command -v dyai-hunk >/dev/null 2>&1 && dyai-hunk; true",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/worktree-create.sh",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/worktree-remove.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(rtk git push)",
      "Bash(rtk git push *)",
      "Bash(git reset --hard:*)",
      "Bash(rtk git reset --hard:*)",
      "Bash(git clean *)",
      "Bash(rtk git clean *)",
      "Bash(git branch -D *)",
      "Bash(rtk git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(rtk git tag -d *)",
      "Bash(git stash drop:*)",
      "Bash(rtk git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(rtk git stash clear:*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(shred *)",
      "Bash(sudo *)",
      "Bash(emerge *)",
      "Bash(pacman *)",
      "Bash(paru *)",
      "Bash(chezmoi apply:*)",
      "Bash(chezmoi destroy:*)",
      "Bash(chezmoi forget:*)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(**/secrets/data/**)",
      "Edit(**/secrets/data/**)",
      "Read(*.age)",
      "Edit(**/*.age)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.password-store/**)",
      "Read(~/.local/share/keyrings/**)",
      "Bash(chezmoi-dycrypt:*)",
      "Bash(age -d *)",
      "Bash(age --decrypt *)",
      "Bash(sops -d *)",
      "Bash(sops --decrypt *)",
      "Bash(gpg -d *)",
      "Bash(gpg --decrypt *)",
      "Bash(pass show *)",
      "Bash(vault read *)",
      "Bash(op read *)",
      "Bash(aws configure get *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "git *",
      "rtk git *",
      "docker *",
      "podman *",
      "chezmoi *",
      "dyai *",
      "mise *",
      "sudo *",
      "emerge *",
      "systemctl *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/.bun/install/cache",
        "~/.cache/go-build",
        "~/.cache/pip",
        "~/.cache/uv",
        "~/.cargo/registry",
        "~/.local/share/rtk"
      ],
      "denyRead": [
        "@DOTFILES@/secrets",
        "@DOTFILES@/.worktrees/*/secrets",
        "@DOTFILES@/home/private_dot_ssh/keys",
        "@DOTFILES@/home/private_dot_config/firefox/profiles",
        "@DOTFILES@/home/private_dot_config/thunderbird/profiles",
        "@DOTFILES@/home/private_dot_config/tstruct/encrypted_auth.json.age",
        "@DOTFILES@/home/private_dot_config/nvim/lua/per_machine/encrypted_F1.lua.age"
      ],
      "denyWrite": [
        "~/.local/bin",
        "~/.cache/.bun/bin",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.local/share/nvim/mason",
        "~/.claude/plugins",
        "~/.krew/bin",
        "~/.hunk/bin"
      ]
    },
    "network": {
      "allowedDomains": [
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "index.crates.io",
        "static.crates.io"
      ]
    }
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen"
}
