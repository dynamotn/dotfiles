#!{{ .bash }}
# @file volume.sh
# @brief Show the output volume
# @description Run by the `volume` item on volume_change, which passes the new
# volume in INFO; asks osascript for it when run any other way.
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh" || exit 1
dybatpho::register_common_handlers

name=${NAME:-volume}
volume=${INFO:-}
if [[ "${SENDER:-}" != "volume_change" || -z "${volume}" ]]; then
  volume=$(osascript -e 'output volume of (get volume settings)')
fi

if ((volume > 60)); then
  icon="󰕾"
elif ((volume > 30)); then
  icon="󰖀"
elif ((volume > 0)); then
  icon="󰕿"
else
  icon="󰖁"
fi
sketchybar --set "${name}" icon="${icon}" label="${volume}%"
