layout {
{{ includeTemplate "zellij/tab-templates.kdl.tmpl" . }}
  tab name="notes" cwd="~/Documents/DyBrain" split_direction="vertical" {
    pane focus=true
    pane {
      cwd "~/Documents/DyBrain/.publish"
    }
    floating_panes {
      pane {
        command "git"
        args "pull"
      }
      pane {
        command "git"
        args "status"
      }
    }
  }
}
