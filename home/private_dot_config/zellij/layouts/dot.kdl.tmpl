layout {
{{ includeTemplate "zellij/tab-templates.kdl.tmpl" . }}
  tab name="dot" cwd="~/Dotfiles" split_direction="vertical" {
    pane focus=true
    floating_panes {
      pane {
        command "git"
        args "pull"
      }
      pane {
        command "git"
        args "status"
      }
      pane {
        command "chezmoi"
        args "diff"
      }
      pane {
        command "chezmoi"
        args "apply"
      }
    }
  }
  tab name="devcontainer" cwd="~/Working/personal/infra/container-toolbox" split_direction="vertical" {
    pane focus=true
    floating_panes {
      pane {
        command "git"
        args "pull"
      }
    }
  }
  tab name="nvim" cwd="~/Dotfiles/silos/neovim" split_direction="vertical" {
    pane focus=true
    floating_panes {
      pane {
        command "git"
        args "pull"
      }
    }
  }
}
