{{- $firefoxSettings := includeTemplate "firefox/settings.yaml.tmpl" . | fromYaml }}
{{- $thunderbirdSettings := includeTemplate "thunderbird/settings.yaml.tmpl" . | fromYaml }}
{{- $browser := $firefoxSettings.executableFile }}
{{- $mailClient := $thunderbirdSettings.executableFile }}
{{- $rules := includeTemplate "wm/rules.yaml.tmpl" . | fromYaml }}
{{- /* What each action of the rules' bindings does on niri; an action left out
       here is not bound */}}
{{- $actions := dict
  "quit" `quit;`
  "hotkey-overlay" `show-hotkey-overlay;`
  "launcher" `spawn-sh "noctalia msg panel-toggle launcher";`
  "swap-monitors" `move-workspace-to-monitor-next;`
  "workspace-to-monitor-left" `move-workspace-to-monitor-left;`
  "workspace-to-monitor-right" `move-workspace-to-monitor-right;`
  "overview" `toggle-overview;`
  "focus-left" `focus-column-left;`
  "focus-right" `focus-column-right;`
  "focus-up" `focus-window-up;`
  "focus-down" `focus-window-down;`
  "cycle-next" `focus-column-right-or-first;`
  "resize-left" `set-column-width "-10%";`
  "resize-right" `set-column-width "+10%";`
  "resize-up" `set-window-height "-10%";`
  "resize-down" `set-window-height "+10%";`
  "close" `close-window;`
  "fullscreen" `fullscreen-window;`
  "float" `toggle-window-floating;`
  "layout" `switch-preset-column-width;`
  "group" `toggle-column-tabbed-display;`
  "swap" `consume-or-expel-window-right;`
  "terminal" `spawn "kitty" "zellij";`
  "control-center" `spawn-sh "noctalia msg panel-toggle control-center";`
  "notification-dnd" `spawn-sh "noctalia msg notification-dnd-toggle";`
  "notification-latest" `spawn-sh "noctalia msg notification-invoke-latest";`
  "clipboard" `spawn-sh "noctalia msg panel-toggle clipboard";`
  "password" `spawn-sh "rbw-pick password";`
  "totp" `spawn-sh "rbw-pick totp";`
  "lock" `spawn-sh "noctalia msg session lock";`
  "screenshot" `spawn-sh "noctalia msg screenshot-region";`
  "system-monitor" `spawn-sh "~/.config/niri/scripts/scratchpad.sh btop kitty --class btop --session ~/.config/kitty/sessions/monitor.conf";`
  "brightness-up" `spawn "dymonitor" "--notify" "brightness" "up";`
  "brightness-down" `spawn "dymonitor" "--notify" "brightness" "down";`
  "contrast-up" `spawn "dymonitor" "--notify" "contrast" "up";`
  "contrast-down" `spawn "dymonitor" "--notify" "contrast" "down";`
  "volume-up" `spawn-sh "noctalia msg volume-up";`
  "volume-down" `spawn-sh "noctalia msg volume-down";`
  "mute" `spawn-sh "noctalia msg volume-mute";`
  "mic-mute" `spawn-sh "noctalia msg mic-mute";`
  "play-pause" `spawn-sh "playerctl play-pause";`
  "pause" `spawn-sh "playerctl pause";`
  "next" `spawn-sh "playerctl next";`
  "previous" `spawn-sh "playerctl previous";` }}
{{- with $rules.profiles.main }}
{{-   $_ := set $actions "browser" (printf `spawn "%s" "-P" "%s";` $browser .) }}
{{-   $_ := set $actions "mail" (printf `spawn "%s" "-P" "%s";` $mailClient .) }}
{{- end }}
{{- with $rules.profiles.other }}
{{-   $_ := set $actions "browser-other" (printf `spawn "%s" "-P" "%s";` $browser .) }}
{{-   $_ := set $actions "mail-other" (printf `spawn "%s" "-P" "%s";` $mailClient .) }}
{{- end -}}
// Generated from the bindings in home/.chezmoitemplates/wm/rules.yaml.tmpl,
// shared with Hyprland, aerospace and OmniWM (docs/key_bindings/niri.md). Mod
// is Super. niri also moves a window with Mod + left drag and resizes it with
// Mod + right drag on its own.
binds {
{{- range $rules.bindings }}
{{-   if and (hasKey $actions .action) (ne (get . "os") "darwin") }}
  {{ .key }}{{ if get . "locked" }} allow-when-locked=true{{ end }}{{ if eq (toString (get . "repeat")) "false" }} repeat=false{{ end }} { {{ get $actions .action }} }
{{-   end }}
{{- end }}

  // Switch workspaces with Mod + [0-9], move the active column there without
  // following it with Mod + Shift + [0-9], in the order of the rules
{{- range $index, $workspace := $rules.workspaces }}
{{-   $key := mod (add $index 1) 10 }}
{{-   $name := includeTemplate "wm/workspace-name.tmpl" $workspace }}
  Mod+{{ $key }} { focus-workspace "{{ $name }}"; }
  Mod+Shift+{{ $key }} { move-column-to-workspace "{{ $name }}" focus=false; }
{{- end }}

  // Scroll through workspaces with Mod + scroll
  Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

  // Switch the input source of the external monitors with Mod + Alt + [1-9]
{{- range $index, $input := $rules.monitorInputs }}
  Mod+Alt+{{ add $index 1 }} repeat=false { spawn "dymonitor" "--notify" "input" "{{ $input }}"; }
{{- end }}
}
