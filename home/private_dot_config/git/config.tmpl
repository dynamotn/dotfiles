# vim:expandtab:shiftwidth=8:tabstop=8:softtabstop=8:ft=gitconfig
[user]
        # Tôi ra đây có phải xưng danh không nhỉ?
        name = Trần Đức Nam
        email = me@dynamotn.dev
        {{- /* Only a decrypted key can sign, so signing is turned on with it */}}
        {{- $signingKey := "" }}
        {{- if .decryptPersonal }}
        {{-   $signingKey = "~/.ssh/keys/personal_ed25519.pub" }}
        {{- else if .decryptEnterprise }}
        {{-   $signingKey = "~/.ssh/keys/enterprise-shared_ed25519.pub" }}
        {{- end }}
        {{- if $signingKey }}
        # Signing SSH key
        signingkey = {{ $signingKey }}
        {{- end }}
[feature]
        # Optimize for repos with many files in the working directory
        manyFiles = true
[advice]
        # I don't like git advice
        skippedCherryPicks = false
        addEmptyPathspec = false
        detachedHead = false
        statusHints = false
{{- if $signingKey }}
[gpg]
        # Use SSH instead of GPG to sign
        format = ssh
{{- end }}
[commit]
        {{- if $signingKey }}
        # Always sign commit
        gpgsign = true
        {{- end }}
        # Use my template for commit message
        template = ~/.config/git/COMMITMSG
        cleanup = scissors
[tag]
        # Sort tags by version
        sort = version:refname
        {{- if $signingKey }}
        # Always sign tag
        forceSignAnnotated = true
        gpgsign = true
        {{- end }}
{{- if lookPath "git" }}
{{-   $gitVersion := output "git" "--version" | regexFind "[0-9]+\\.[0-9]+(\\.[0-9]+)?" }}
{{-   if and $gitVersion (gt (semver "2.35" | (semver $gitVersion).Compare) 0) }}
[merge]
        conflictstyle = zdiff3
{{-   end }}
{{- end }}
[rerere]
        enabled = true
        autoupdate = true
[versionsort]
        suffix = ""
        suffix = "-rc"
        suffix = "-pre"
[diff]
        # Diff with vim
        tool = nvimdiff
        # Not show a/, b/ when diff, I'm angry with this
        noprefix = true
        # Use extended form of Bram Cohen's patience diff algorithm
        algorithm = histogram
        # Detect move blocks
        colorMoved = default
[mergetool]
        # Not prompt launch apps, I have no time to confirm that don't think why I used it
        prompt = false
        # Not generate .orig files
        keepBackup = false
[difftool]
        # Not prompt launch apps, I have no time to confirm that don't think why I used it
        prompt = false
[difftool "nvimdiff"]
        # Nvim diff 2 files
        cmd = "nvim -d $LOCAL $REMOTE"
[difftool "kitty"]
        # Use kitten of kitty/ to diff each hunk
        cmd = "kitty +kitten diff $LOCAL $REMOTE"
[mergetool "nvimdiff"]
        # Nvim diff 4 files
        cmd = "nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'"
[help]
        # Okay sometimes I type so f*cking bad
        autocorrect = 1
[color]
        # Be careful with pipe when redirected output
        ui = auto
[color "status"]
        # I don't like default color
        added = green
        changed = blue
        untracked = magenta
        deleted = red
[color "diff"]
        # I don't like default color
        meta = cyan
        frag = magenta bold
        old = red
        new = blue
        commit = yellow bold
        whitespace = red reverse
[color "diff-highlight"]
        oldNormal = red bold
        oldHighLight = red bold 52
        newNormal = blue bold
        newHighLight = blue bold 45
[core]
        # Some Windows programmer in team, so no auto convert CRLF
        autocrlf = false
        # Work with standard or convention
        whitespace = trailing-space,space-before-tab,cr-at-eol
        {{- if lookPath "nvim" }}
        # Use neovim to edit message
        editor = nvim
        {{- else }}
        editor = vi
        {{- end }}
        # Custom global ignore file
        excludesfile = ~/.config/git/ignore
        # Custom global attributes file
        attributesfile = ~/.config/git/attributes
        {{- if eq .chezmoi.os "darwin" }}
        # Built-in watcher daemon: `git status` stops scanning the whole tree.
        # Git has no Linux backend for it.
        fsmonitor = true
        {{- end }}
{{- /* A pager that is not installed breaks every paging command and `add -p` */}}
{{- if lookPath "hunk" }}
        # Use hunk to review diff, it passes non-diff output through
        pager = hunk pager
{{- else if and (lookPath "delta") (lookPath "ov") }}
        # Use delta to prettier diff
        pager = delta --pager='ov -F'
[pager]
        # Use ov for pager
        show = delta --features ov-diff
        diff = delta --features ov-diff
        log = delta --features ov-log
{{- else if lookPath "delta" }}
        # Use delta to prettier diff
        pager = delta
{{- else }}
        pager = less -R
{{- end }}
{{- if lookPath "delta" }}
[interactive]
        # Use delta to show diff when interactive each hunks, hunk has no
        # --color-only filter yet (modem-dev/hunk#575)
        diffFilter = delta --color-only
{{- end }}
[delta]
        # Use delta with catppuccin theme
        {{- $theme := "macchiato" }}
        {{- if not .darkMode }}
        {{-   $theme = "latte" }}
        {{- end }}
        features = catppuccin-{{ $theme }}
        # Change decorations
        features = decorations
        # Show navigate section
        navigate = true
        # Show line number & Two side
        side-by-side = true
        line-numbers = true
        # Style of whitespace error
        whitespace-error-style = red reverse
[delta "ov-diff"]
        pager = ov -F --section-delimiter '^(commit|added:|removed:|renamed:|Δ)' --section-header --pattern '•'
[delta "ov-log"]
        pager = ov -F --section-delimiter '^(commit|\\* commit|\\* \\w{7})' --section-header-num 1
[status]
        # Show summary of submodule
        submoduleSummary = true
[apply]
        # Auto fix white space
        whitespace = fix
[rebase]
        # More clear when rebase
        instructionFormat = "[%an - %ar] %s"
[stash]
        # Show stash with diff
        showPatch = true
[transfer]
        # Avoid paranoid
        fsckobjects = true
[fetch]
        # Prune remote-tracking branches that no longer exist on the remote
        prune = true
        pruneTags = true
        # Keep the commit-graph current, which speeds up log, merge-base, push
        writeCommitGraph = true
        # Fetch several remotes and submodules at once, one job per CPU
        parallel = 0
[push]
        # Only push current branch to same name branch
        default = current
        # Push follow tags
        followTags = true
[submodule]
        # Fetch submodules parallel
        fetchJobs = 0
[alias]
        # Get main branch
        main = "!_() { git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'; }; _"
        # Graph log view
        graph = log --graph --abbrev-commit
        # Meaning stash
        snapshot = !git stash save "Snapshot: $(date)"
        # Rename stash
        stash-rename = "!_() { rev=$(git rev-parse $1) && git stash drop $1 || exit 1 ; git diff-index --quiet HEAD; s=$?; [ $s != 0 ] && git stash save \"tmp stash from stash-rename\"; git stash apply $rev && shift && git stash save \"$@\" && [ $s != 0 ] && git stash pop stash@{1}; }; _"
        # Find commits with source code
        find-source = "!_() { git log --pretty=format:'%C(yellow)%h %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; _"
        # Find commits with message
        find-message = "!_() { git log --pretty=format:'%C(yellow)%h %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; _"
        # Find branches containing commit
        find-branch = "!_() { git branch -a --contains $1; }; _"
        # Stop tracking a file that already in staged but keep in worktree
        stop-track = "!_() { git update-index --assume-unchanged $1; }; _"
        # Redo above
        track = "!_() { git update-index --no-assume-unchanged $1; }; _"
        # Keep independent version file forever
        keep-forever = "!_() { git update-index --skip-worktree $1; }; _"
        # Redo above
        stop-keep-forever = "!_() { git update-index --no-skip-worktree $1; }; _"
        # Show root level directory
        root = "!_() { git rev-parse --show-toplevel; }; _"
        # Leave a linked worktree for its main checkout, then a submodule for its superproject
        # NOTE: git exports GIT_DIR to aliases, and a submodule checkout is only reachable
        # through core.worktree in its git dir, not by trimming .git/modules/<name>
        up = "!_() { unset GIT_DIR GIT_WORK_TREE; _m() { c=$(git -C \"$1\" rev-parse --path-format=absolute --git-common-dir); w=$(git -C \"$c\" rev-parse --path-format=absolute --show-toplevel 2>/dev/null); [ -n \"$w\" ] || w=$(dirname \"$c\"); echo \"$w\"; }; dir=$(_m .); super=$(git -C \"$dir\" rev-parse --show-superproject-working-tree); [ -n \"$super\" ] && dir=$(_m \"$super\"); echo \"$dir\"; }; _"
        # Show file with conflicts
        conflicts = "!_() { git ls-files -u | awk '{print $4}' | sort -u; }; _"
        # Delete dangling commits
        delete-dangling = "!_() { git reflog expire --expire=now --all; git gc --prune=now; }; _"
        # Delete merged branch
        delete-merged = "!_() { git branch --merged | grep -v $(git main) | grep -v develop | xargs git branch -d; }; _"
        # Submodule clean
        submodule-clean = "!_() { git submodule update --init --recursive && git submodule foreach --recursive 'git reset --hard' && git submodule foreach --recursive 'git clean -fd' }; _"
        # Update main branch
        update-main = !bash ~/.config/git/scripts/update_main.sh
        # Push-mirror the GitLab project to GitHub via GitLab mirroring (default: origin -> gh)
        mirror = !bash ~/.config/git/scripts/gitlab_mirror.sh
        # Unshallow
        unshallow = "!_() { git fetch --unshallow; git config remote.$1.fetch "+refs/heads/*:refs/remotes/$1/*"; git fetch $1; }; _"
        # Generate patch from git diff
        gen-patch = "!_() { git -c diff.noprefix=false diff --output $1; }; _"
        # Create worktree with new branch, in the repository itself even inside a submodule
        wt = "!_() { branch=$1; branch_safe=${branch//\\//-}; unset GIT_DIR GIT_WORK_TREE; c=$(git rev-parse --path-format=absolute --git-common-dir); repo=$(git -C \"$c\" rev-parse --path-format=absolute --show-toplevel 2>/dev/null); [ -n \"$repo\" ] || repo=$(dirname \"$c\"); mkdir -p \"${repo}/.worktrees\"; git -C \"$repo\" worktree add -b \"$branch\" \"${repo}/.worktrees/${branch_safe}\"; }; _"
{{- /* Hooks from config (git 2.54+) run in every repository, before its own
       hooks; an older git ignores them */}}
[hook "agent-credit"]
        # Drop the lines crediting an AI agent from every commit message
        event = commit-msg
        command = ~/.config/git/scripts/strip_agent_credit.sh
[hook "commit-signed"]
        # Flag a commit left unsigned while the global config asks for signing
        event = post-commit
        command = "[ \"$(git config --global --type=bool commit.gpgsign)\" != true ] || git cat-file commit HEAD | grep -q '^gpgsig' || echo 'error: HEAD is not signed; sign it with: git commit --amend --no-edit -S' >&2"
[hook "worktree-submodules"]
        # Check out the submodules marked worktreeInit in a new linked worktree
        event = post-checkout
        command = ~/.config/git/scripts/worktree_submodules.sh
[hook "worktree-cleanup"]
        # Remove a clean worktree once a merge brought its branch in, keep the branch
        event = post-merge
        command = ~/.config/git/scripts/worktree_cleanup.sh
[gc]
        # Don't auto git gc, with large project can slow when working
        auto = 0
[init]
        defaultBranch = main
        templatedir = ~/.config/git/templates
[include]
        path = ~/.config/git/diff-filter
        path = ~/.config/git/delta
{{- range .decryptEnterprise }}
[includeIf "gitdir/i:~/Working/enterprise/{{ . }}/**"]
        # Include config file from enterprise {{ . }} projects
        path = ~/Working/enterprise/{{ . }}/.gitconfig
{{- end }}
[include]
        # SSH or HTTPS, GitLab or its GitHub mirror: whichever this network
        # allows, as dynet found on the last network change
        path = ~/.local/state/dynet/git.config
{{- if eq .osid "android" }}
[safe]
        directory = /storage/emulated/0/Documents/DyBrain
{{- end }}
