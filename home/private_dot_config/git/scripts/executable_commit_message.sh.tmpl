#!{{ .bash }}
# @file commit_message.sh
# @brief Reject a commit message that breaks the commit conventions
# @description Run by the global `commit-msg` hook (`hook.commit-message` in the git
# config), after `strip_agent_credit.sh` has dropped any agent credit. Reject an
# empty message and a subject over 72 characters, and warn when the subject goes
# over the 50 character mark.
{{ template "git/hooks/modern_bash.sh.tmpl" . }}
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

readonly SUBJECT_WARN_LENGTH=50
readonly SUBJECT_MAX_LENGTH=72

message_file="${1-}"
dybatpho::is file "${message_file}" \
  || dybatpho::die "commit-msg hook expects the path of the message file"

# Drop everything the editor added: the scissors line and its diff, then the
# comments and the blank lines git would strip on its own anyway.
message="$(sed '/^# ------------------------ >8 ------------------------$/,$d' "${message_file}" \
  | git stripspace --strip-comments)"

if dybatpho::string_is_blank "${message}"; then
  dybatpho::die "Empty commit message, nothing to commit"
fi

subject="${message%%$'\n'*}"

# A merge, a revert and a fixup all get their subject from git or from the
# commit they point at, so holding them to the length rule helps nobody.
if [[ ${subject} =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
  exit 0
fi

if ((${#subject} > SUBJECT_MAX_LENGTH)); then
  dybatpho::error "Subject is ${#subject} characters, the limit is ${SUBJECT_MAX_LENGTH}:"
  dybatpho::error "${subject}"
  dybatpho::die "Shorten the subject and move the detail into the body"
fi

if ((${#subject} > SUBJECT_WARN_LENGTH)); then
  dybatpho::warn "Subject is ${#subject} characters, ${SUBJECT_WARN_LENGTH} reads better: ${subject}"
fi
