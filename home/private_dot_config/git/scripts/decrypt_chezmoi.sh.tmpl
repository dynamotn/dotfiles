#!{{ .bash }}
# @file decrypt_chezmoi.sh
# @brief Decrypt a chezmoi managed file for git to read
# @description Decrypt an age encrypted file with the identity key of a chezmoi identity,
# so that git can diff it. Takes the name of the decoder to use, `_normal` for
# a plain file or `_sqlite` for a dump of an encrypted SQLite database.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

#######################################
# @description Decode a plain age encrypted file
# @arg $1 string Name of the chezmoi identity holding the key
# @arg $2 string Path of the encrypted file
# @stdout Decrypted content
#######################################
function _normal {
  local identity encrypted_file
  dybatpho::expect_args identity encrypted_file -- "$@"
  age -d -i ~/.config/chezmoi/"${identity}".key "${encrypted_file}" 2> /dev/null
}

#######################################
# @description Decode an age encrypted SQLite database as its SQL dump
# @arg $1 string Name of the chezmoi identity holding the key
# @arg $2 string Path of the encrypted file
# @stdout SQL dump of the decrypted database
#######################################
function _sqlite {
  local identity encrypted_file
  dybatpho::expect_args identity encrypted_file -- "$@"
  local decrypted_file
  dybatpho::create_temp decrypted_file ".sqlite"

  if ! age -d -i ~/.config/chezmoi/"${identity}".key "${encrypted_file}" > "${decrypted_file}" 2> /dev/null; then
    dybatpho::die "Could not decrypt SQLite file."
  fi
  sqlite3 "${decrypted_file}" .dump
}

#######################################
# @description Decode a sops encrypted file
# @arg $1 string Path of the encrypted file
# @stdout Decrypted content
#######################################
function _sops {
  local encrypted_file
  dybatpho::expect_args encrypted_file -- "$@"
  sops -d "${encrypted_file}"
}

#######################################
# @description Run the decoder named by the first argument, only for a
# process with a controlling terminal and after a `y` typed there: git runs
# outside the agents' sandbox, and an agent that got git to load this driver
# has no terminal, or one nobody answers on.
# shortcut: an agent that can type into its own terminal still gets through;
# keep the identity keys away from such an agent to close that.
# @arg $1 string Decoder to use, `_normal`, `_sqlite` or `_sops`
# @arg $@ string Arguments of that decoder
# @stdout Decrypted content, or a placeholder line when it was not allowed
#######################################
function _main {
  local decoder
  dybatpho::expect_args decoder -- "$@"
  shift
  if ! (exec 3< /dev/tty) 2> /dev/null; then
    printf '<encrypted: decrypting a diff needs a terminal>\n'
    return 0
  fi
  # One key, read from the terminal itself: stdin belongs to git. The file
  # is the last argument of every decoder. A terminal nobody watches gets the
  # placeholder after a minute instead of holding git for ever.
  local answer=""
  printf 'Decrypt %s for this diff? [y/N] ' "${!#}" > /dev/tty
  read -r -t 60 -n 1 answer < /dev/tty || answer=""
  printf '\n' > /dev/tty
  if [[ "${answer}" != [yY] ]]; then
    printf '<encrypted: decrypting was not confirmed>\n'
    return 0
  fi
  case "${decoder}" in
    _normal | _sqlite | _sops) "${decoder}" "$@" ;;
    *) dybatpho::die "Unknown decoder '${decoder}'" ;;
  esac
}

_main "$@"
