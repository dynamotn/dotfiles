#!{{ .bash }}
# @file sdiff.sh
# @brief Diff that decrypts age and sops files, asking before each
# @description `git sdiff`, with the arguments of `git diff`. The drivers of
# ~/.config/git/diff-secret ask on the terminal before they decrypt a file,
# so the whole diff is taken before the pager starts: a pager that already
# owned the terminal would swallow the answers, and the diff would hang.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

#######################################
# @description Take the diff, then show it as `git diff` would
# @arg $@ string Arguments of `git diff`
# @exitcode The status of `git diff`, which `--exit-code` sets to 1 for a difference
#######################################
function _main {
  # git runs an alias from the top of the repository; paths are the caller's.
  cd "${GIT_PREFIX:-.}" || dybatpho::die "Cannot return to ${GIT_PREFIX:-}"
  local color="never" pager="" output status=0
  if [[ -t 1 ]]; then
    color="always"
    # The pager `git diff` itself would take: pager.diff first.
    pager="$(git config pager.diff 2> /dev/null)" || pager=""
    case "${pager}" in
      false | no | off | 0) pager="cat" ;;
      "" | true | yes | on | 1) pager="$(git var GIT_PAGER)" ;;
      *) ;;
    esac
  fi
  output="$(git --no-pager -c "include.path=~/.config/git/diff-secret" diff "--color=${color}" "$@")" \
    || status=$?
  if [[ -n "${output}" ]]; then
    if [[ -n "${pager}" && "${pager}" != "cat" ]]; then
      # A shell command line, which git itself hands to `sh -c`, with the
      # LESS git sets. A pager quit before the end is no failure.
      printf '%s\n' "${output}" | LESS="${LESS-FRX}" sh -c "${pager}" || true
    else
      printf '%s\n' "${output}"
    fi
  fi
  return "${status}"
}

# The status of `git diff --exit-code` is an answer, not an error to report.
# dyshellint disable=SC2310 errexit off inside _main is the point: it returns git's status
_main "$@" || exit $?
