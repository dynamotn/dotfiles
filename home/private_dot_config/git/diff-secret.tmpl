# Diff drivers that decrypt. Git loads none of them by default, so no plain
# `git diff`, `log -p` or `show` (an agent's included) prints a secret: only
# `git sdiff` does, which loads this file.
{{ if .decryptPersonal }}
[diff "age-personal"]
        textconv = "bash ~/.config/git/scripts/decrypt_chezmoi.sh _normal personal"
[diff "sqlite3-personal"]
        binary = true
        textconv = "bash ~/.config/git/scripts/decrypt_chezmoi.sh _sqlite personal"
{{- end }}
{{- if .decryptEnterprise }}
[diff "age-enterprise-shared"]
        textconv = "bash ~/.config/git/scripts/decrypt_chezmoi.sh _normal enterprise-shared"
[diff "sqlite3-enterprise-shared"]
        binary = true
        textconv = "bash ~/.config/git/scripts/decrypt_chezmoi.sh _sqlite enterprise-shared"
{{- end }}
{{- range .decryptEnterprise }}
[diff "age-enterprise-{{ . }}"]
        textconv = "bash ~/.config/git/scripts/decrypt_chezmoi.sh _normal enterprise-{{ . }}"
[diff "sqlite3-enterprise-{{ . }}"]
        binary = true
        textconv = "bash ~/.config/git/scripts/decrypt_chezmoi.sh _sqlite enterprise-{{ . }}"
{{- end }}
[diff "sopsdiffer"]
        # A differ for secret encoded
        textconv = sops -d
