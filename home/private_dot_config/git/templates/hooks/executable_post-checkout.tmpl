#!{{ .bash }}
# @file post-checkout
# @brief Warn when switching branches brought in dependency changes
# @description Warn when a branch checkout changed the submodules, the lockfiles or the
# pinned tool versions, so the install step is not forgotten. After a clone of a
# repository mirrored from GitLab to GitHub, give it `origin` on GitLab and `gh` on GitHub.
{{ template "git/hooks/modern_bash.sh.tmpl" . }}
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh" --modules array
dybatpho::register_common_handlers

{{ template "git/hooks/dependency_changes.sh.tmpl" . }}

previous_head="${1-}"
new_head="${2-}"
is_branch_checkout="${3-0}"
null_ref="0000000000000000000000000000000000000000"

# Git calls this hook for file checkouts and for the checkout a clone ends with
# too. Neither is a branch switch, so there is no range worth comparing.
if [[ ${is_branch_checkout} == "1" ]] \
  && [[ ${previous_head} != "${null_ref}" ]] \
  && [[ ${previous_head} != "${new_head}" ]]; then
  dependency_changes::report "${previous_head}..${new_head}"
fi

# The checkout a clone ends with starts from the null ref. A clone of anything
# not in the mirrors keeps its remotes, and no failure here fails the clone.
if [[ ${previous_head} == "${null_ref}" ]]; then
  . "{{ .chezmoi.sourceDir }}/../scripts/lib/mirror.sh"
  mirror::set_remotes {{ joinPath .chezmoi.homeDir ".config/dynet/mirrors.json" | squote }} . || true
fi
