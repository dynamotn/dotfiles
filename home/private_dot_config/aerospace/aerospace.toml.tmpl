{{- $rules := includeTemplate "wm/rules.yaml.tmpl" . | fromYaml }}
{{- $browser := "" }}
{{- if eq .browser "F" }}
{{-   $browser = "Firefox" }}
{{- else if eq .browser "Z" }}
{{-   $browser = "Zen" }}
{{- end }}
{{- $mailClient := "" }}
{{- if eq .mailClient "T" }}
{{-   $mailClient = "Thunderbird" }}
{{- else if eq .mailClient "B" }}
{{-   $mailClient = "Betterbird" }}
{{- end }}
# See: https://nikitabobko.github.io/AeroSpace/guide#config-version
config-version = 2

# Workspaces that always exist; version 2 no longer infers them from the
# key bindings below, so keep this in sync with the cmd-<n> bindings
persistent-workspaces = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]

after-startup-command = [
  ## SketchyBar
  'exec-and-forget sketchybar --reload ~/.config/sketchybar/sketchybarrc',
  ## Kitty
  'exec-and-forget open -na kitty --args zellij',
  ## Firefox/Zen
  'exec-and-forget open -na {{ $browser }} --args -P {{ $rules.profiles.main }} ',
  ## Thunderbird/Betterbird
  'exec-and-forget open -na {{ $mailClient }} --args -P {{ $rules.profiles.main }} ',
  ## Obsidian
  'exec-and-forget open -a Obsidian',
  ## Hammerspoon
  'exec-and-forget open -a Hammerspoon',
]
exec-on-workspace-change = [
  ## SketchyBar
  '/usr/bin/env',
  'bash',
  '-c',
  'sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$AEROSPACE_FOCUSED_WORKSPACE',
]

# Start AeroSpace at login
start-at-login = true

# Normalizations. See: https://nikitabobko.github.io/AeroSpace/guide#normalization
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

# See: https://nikitabobko.github.io/AeroSpace/guide#layouts
# The 'accordion-padding' specifies the size of accordion padding
# You can set 0 to disable the padding feature
accordion-padding = 0

# Possible values: tiles|accordion
default-root-container-layout = 'tiles'

# Possible values: horizontal|vertical|auto
# 'auto' means: wide monitor (anything wider than high) gets horizontal orientation,
#               tall monitor (anything higher than wide) gets vertical orientation
default-root-container-orientation = 'auto'

# Mouse follows focus when focused monitor changes
# Drop it from your config, if you don't like this behavior
# See https://nikitabobko.github.io/AeroSpace/guide#on-focus-changed-callbacks
# See https://nikitabobko.github.io/AeroSpace/commands#move-mouse
# Fallback value (if you omit the key): on-focused-monitor-changed = []
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

# You can effectively turn off macOS "Hide application" (cmd-h) feature by toggling this flag
# Useful if you don't use this macOS feature, but accidentally hit cmd-h or cmd-alt-h key
# Also see: https://nikitabobko.github.io/AeroSpace/goodness#disable-hide-app
automatically-unhide-macos-hidden-apps = false

# [[on-window-detected]]
# if.app-id = 'com.apple.systempreferences'
# if.app-name-regex-substring = 'settings'
# if.window-title-regex-substring = 'substring'
# if.workspace = 'workspace-name'
# if.during-aerospace-startup = true
# check-further-callbacks = true
# run = ['layout floating', 'move-node-to-workspace S']  # The callback itself

# The drop-down btop of Hammerspoon floats on the workspace it was called to
[[on-window-detected]]
if.app-name-regex-substring = 'kitty'
if.window-title-regex-substring = '^btop$'
run = 'layout floating'

[[on-window-detected]]
if.app-name-regex-substring = 'kitty'
run = 'move-node-to-workspace 1'

[[on-window-detected]]
if.app-name-regex-substring = 'Firefox|Zen'
run = 'move-node-to-workspace 2'

[[on-window-detected]]
if.app-name-regex-substring = 'Thunderbird|Betterbird'
run = 'move-node-to-workspace 3'

[[on-window-detected]]
if.app-name-regex-substring = 'Obsidian'
run = 'move-node-to-workspace 4'

[[on-window-detected]]
if.app-name-regex-substring = 'Telegram'
run = 'move-node-to-workspace 5'

[[on-window-detected]]
if.app-name-regex-substring = 'mpv'
run = 'move-node-to-workspace 6'

[[on-window-detected]]
if.app-name-regex-substring = 'Bluestacks'
run = 'move-node-to-workspace 7'

[[on-window-detected]]
if.app-name-regex-substring = 'Omnissa'
run = ['layout floating', 'move-node-to-workspace 8']

[[on-window-detected]]
if.app-name-regex-substring = 'Finder'
run = ['layout floating', 'move-node-to-workspace 8']

# Possible values: (qwerty|dvorak)
# See https://nikitabobko.github.io/AeroSpace/guide#key-mapping
[key-mapping]
preset = 'qwerty'

# Gaps between windows (inner-*) and between monitor edges (outer-*).
# Possible values:
# - Constant:     gaps.outer.top = 8
# - Per monitor:  gaps.outer.top = [{ monitor.main = 16 }, { monitor."some-pattern" = 32 }, 24]
#                 In this example, 24 is a default value when there is no match.
#                 Monitor pattern is the same as for 'workspace-to-monitor-force-assignment'.
#                 See: https://nikitabobko.github.io/AeroSpace/guide#assign-workspaces-to-monitors
[gaps]
inner.horizontal = 10
inner.vertical = 10
outer.left = 10
outer.bottom = 10
# macOS keeps the notch strip (32px) of the built-in display free, and the
# 32px sketchybar fits in it; other monitors keep nothing, so leave room there
# for the bar (its height is in sketchybarrc) plus the usual gap
outer.top = [{ monitor."built-in" = 10 }, 42]
outer.right = 10

# 'main' binding mode declaration
# See: https://nikitabobko.github.io/AeroSpace/guide#binding-modes
# 'main' binding mode must be always presented
# Fallback value (if you omit the key): mode.main.binding = {}
[mode.main.binding]
# Generated from the bindings in home/.chezmoitemplates/wm/rules.yaml.tmpl,
# shared with niri, Hyprland and OmniWM (docs/key_bindings/aerospace.md); Mod
# is cmd. Commands: https://nikitabobko.github.io/AeroSpace/commands
{{- /* What each action does on aerospace, as a TOML value; an action left out
       here is not bound. Moving a workspace to another monitor does not change
       the focused workspace, so sketchybar is told explicitly */}}
{{- $toMonitor := `['move-workspace-to-monitor --wrap-around %s', 'exec-and-forget sketchybar --trigger aerospace_workspace_change']` }}
{{- $actions := dict
  "swap-monitors" `'exec-and-forget ~/.config/aerospace/swap-monitors.sh'`
  "workspace-to-monitor-left" (printf $toMonitor "left")
  "workspace-to-monitor-right" (printf $toMonitor "right")
  "workspace-to-monitor-next" (printf $toMonitor "next")
  "workspace-back-and-forth" `'workspace-back-and-forth'`
  "focus-left" `'focus left'`
  "focus-down" `'focus down'`
  "focus-up" `'focus up'`
  "focus-right" `'focus right'`
  "cycle-next" `'focus --boundaries workspace --boundaries-action wrap-around-the-workspace dfs-next'`
  "cycle-prev" `'focus --boundaries workspace --boundaries-action wrap-around-the-workspace dfs-prev'`
  "join-left" `'join-with left'`
  "join-down" `'join-with down'`
  "join-up" `'join-with up'`
  "join-right" `'join-with right'`
  "move-left" `'move left'`
  "move-down" `'move down'`
  "move-up" `'move up'`
  "move-right" `'move right'`
  "resize-smaller" `'resize smart -50'`
  "resize-larger" `'resize smart +50'`
  "layout" `'layout tiles horizontal vertical'`
  "fullscreen" `'fullscreen'`
  "float" `'layout floating tiling'`
  "mode-service" `'mode service'`
  "mode-apps" `'mode apps'`
  "terminal" `'exec-and-forget open -na kitty --args zellij'` }}
{{- with $rules.profiles.main }}
{{-   $_ := set $actions "browser" (printf `'exec-and-forget open -na %s --args -P %s '` $browser .) }}
{{-   $_ := set $actions "mail" (printf `'exec-and-forget open -na %s --args -P %s '` $mailClient .) }}
{{- end }}
{{- with $rules.profiles.other }}
{{-   $_ := set $actions "browser-other" (printf `'exec-and-forget open -na %s --args -P %s '` $browser .) }}
{{-   $_ := set $actions "mail-other" (printf `'exec-and-forget open -na %s --args -P %s '` $mailClient .) }}
{{- end }}
{{- $modifiers := dict "Alt" "alt" "Ctrl" "ctrl" "Mod" "cmd" "Shift" "shift" }}
{{- $keys := dict "Apostrophe" "quote" "Return" "enter" "Escape" "esc" }}
{{- range $rules.bindings }}
{{-   if and (hasKey $actions .action) (ne (get . "os") "linux") }}
{{-     $parts := splitList "+" .key }}
{{-     $chord := list }}
{{- /* aerospace's own order: alt, ctrl, cmd, shift */}}
{{-     range $modifier := list "Alt" "Ctrl" "Mod" "Shift" }}
{{-       if has $modifier (initial $parts) }}
{{-         $chord = append $chord (get $modifiers $modifier) }}
{{-       end }}
{{-     end }}
{{-     $key := last $parts }}
{{-     $chord = append $chord (get $keys $key | default (lower $key)) }}
{{ join "-" $chord }} = {{ get $actions .action }}
{{-   end }}
{{- end }}

# Like Hyprland, cmd + [0-9] switches workspace, and cmd + shift + [0-9] moves
# the window there while the focus stays on this workspace
{{- range $index, $workspace := $rules.workspaces }}
{{-   $key := mod (add $index 1) 10 }}
cmd-{{ $key }} = 'workspace {{ $key }}'
cmd-shift-{{ $key }} = 'move-node-to-workspace {{ $key }}'
{{- end }}

# 'service' binding mode declaration.
# See: https://nikitabobko.github.io/AeroSpace/guide#binding-modes
[mode.service.binding]
esc = ['reload-config', 'mode main']
r = ['flatten-workspace-tree', 'mode main'] # reset layout
f = [
  'layout floating tiling',
  'mode main',
] # Toggle between floating and tiling layout
backspace = ['close-all-windows-but-current', 'mode main']

[mode.apps.binding]
esc = ['reload-config', 'mode main']
