        prometheus:
          command: uvx
          args: ["prometheus-mcp-server@1.6.2"]
          env: {}
          readonly: true
        grafana:
          command: docker
          args: ["run", "-i", "--rm", "-e", "GRAFANA_URL", "-e", "GRAFANA_SERVICE_ACCOUNT_TOKEN", "grafana/mcp-grafana:2.1.1", "-t", "stdio"]
