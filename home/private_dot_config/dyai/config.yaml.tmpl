{{- /*
  dyai: single declarative source for AI-agent extensions and settings.
  The AI setup hook (run_onchange_after_03-setup-ai.sh) reads this to install.
  `global` is shared across agents; `agents.<name>` is agent-specific.
  Claude's marketplaces, plugins and policy come from the shared data partial
  so this file and ~/.claude/settings.json never drift.
*/ -}}
{{- $d := fromYaml (includeTemplate "ai/dyai-data.yaml.tmpl" .) -}}
global:
  # Community skills from https://skills.sh, installed for every agent with the
  # skills CLI. Only cross-cutting skills every project benefits from live here;
  # everything tied to a language, tool or domain moved to a registry preset
  # (`dyai use <name>`) so this baseline stays lean.
  # Pinned to a commit by a GitHub tree URL; `dyai skills update` takes a new
  # one once the SHA here changes. design-doc-mermaid keeps its SKILL.md at
  # the repository root, which no tree URL names, so it follows upstream.
  skills:
    - https://github.com/vercel-labs/skills/tree/b716f9dc2ba36b6aa8f0080615e5a3a6caeac63b/skills/find-skills
    - https://github.com/wshobson/agents/tree/9c61ab243def98f72da12abd41cfcf5bcd91af9d/plugins/backend-development/skills/api-design-principles
    - https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/api-and-interface-design
    - spillwavesolutions/design-doc-mermaid@design-doc-mermaid
    - https://github.com/softaworks/agent-toolkit/tree/3027f20f3181758385a1bb8c022d4041dfb4de84/dist/plugins/c4-architecture/skills/c4-architecture
    - https://github.com/addyosmani/agent-skills/tree/301b02b12bff98e4688e6984af6556802322bbde/skills/documentation-and-adrs
    - https://github.com/wshobson/agents/tree/9c61ab243def98f72da12abd41cfcf5bcd91af9d/plugins/backend-development/skills/architecture-patterns
    - https://github.com/wondelai/skills/tree/d8d5d75f83da9f16d8aad5bab5f5b341a4770a30/domain-driven-design
    - https://github.com/anthropics/skills/tree/2c5958ecac7cee2b583967a2c4981d0f4a75c579/skills/mcp-builder
    - https://github.com/wshobson/agents/tree/9c61ab243def98f72da12abd41cfcf5bcd91af9d/plugins/llm-application-dev/skills/prompt-engineering-patterns
    - https://github.com/wshobson/agents/tree/9c61ab243def98f72da12abd41cfcf5bcd91af9d/plugins/developer-essentials/skills/git-advanced-workflows
  # Agent role definitions and commands/prompts (populated in a later phase).
  # Baseline subagents: VoltAgent categories installed into every agent's
  # agents dir (Claude-format today). Pinned to a commit, never a branch.
  subagents:
    - repo: VoltAgent/awesome-claude-code-subagents
      ref: 408d3c9eee2d
      include:
        - categories/01-core-development
        - categories/04-quality-security
        - categories/09-meta-orchestration
        - categories/10-research-analysis
      # Domain-specific agents kept out of the always-installed baseline; each
      # is pulled per project by the matching preset below (desktop, mobile,
      # graphql, realtime), which resolves it from the same pinned repo.
      # Every agent here is listed in every session's context, so the business
      # analysis and niche security agents go behind `research` / `security`,
      # and the two that fight dyai or target Windows/Azure ops are dropped.
      exclude:
        - electron-pro
        - mobile-developer
        - graphql-architect
        - websocket-engineer
        - webhook-engineer
        - ad-security-reviewer
        - powershell-security-hardening
        - gdpr-ccpa-compliance
        - compliance-auditor
        - penetration-tester
        - ab-test-analysis
        - cohort-analysis
        - competitive-analyst
        - market-researcher
        - project-idea-validator
        - trend-analyst
        - scientific-literature-researcher
        - agent-installer
        - it-ops-orchestrator
      # Abstract tier where the upstream choice is wrong for the job (review
      # and security judgments never run below the strongest tier). Each
      # agent translates it through its own agents.<name>.model_tiers.
      models:
        code-reviewer: strong
        security-auditor: strong
        architect-reviewer: strong
        research-analyst: standard
        # Search and lookups on the fast tier; running tests on the standard one.
        search-specialist: fast
        data-researcher: fast
        accessibility-tester: standard
  commands: []
  # MCP servers registered into every MCP-capable agent, in its own format.
  mcp:
    # laya-mcp shares one loopback laya-serve between every session instead
    # of loading the checkpoints (~3.4 GB) in each one (scripts/lib/laya_mcp.sh).
    laya:
      command: {{ printf "%s/.local/bin/laya-mcp" .chezmoi.homeDir | quote }}
      args: []
      env:
        HF_HUB_DISABLE_TELEMETRY: "1"
    # dyai itself: lets an agent list the registry presets and opt the
    # project it works in into one (`dyai mcp`, scripts/lib/dyai_mcp.sh).
    dyai:
      command: {{ printf "%s/.local/bin/dyai" .chezmoi.homeDir | quote }}
      args: ["mcp"]
      env: {}
    # projekt: where each project is, its tags, description, note, working
    # trees and git state (`projekt mcp`). Without --write it only reads, so
    # it is readonly. Needs a projekt newer than v4.1.0, the first with `mcp`.
    projekt:
      command: {{ printf "%s/.local/bin/projekt" .chezmoi.homeDir | quote }}
      args: ["mcp"]
      env: {}
      readonly: true
    # Community servers from the official modelcontextprotocol registry (and
    # Upstash's context7), pinned. Node servers run via bunx, Python via uvx,
    # github via docker. An agent missing the launcher is skipped by the hook.
    # uv (exclude-newer) and bun (minimum-release-age) refuse any release
    # younger than 7 days, so a pin must be at least that old or the server
    # never starts; the "MCP pins clear the cooldown" bats test checks it.
    # readonly marks a server with no side effects or call-to-call state, whose
    # tools Codex may then call in parallel.
    sequential-thinking:
      command: bunx
      args: ["@modelcontextprotocol/server-sequential-thinking@1.0.0"]
      env: {}
    fetch:
      command: uvx
      args: ["mcp-server-fetch@2026.10.10"]
      env: {}
      readonly: true
    time:
      command: uvx
      args: ["mcp-server-time@2026.10.10"]
      env: {}
      readonly: true
    git:
      command: uvx
      args: ["mcp-server-git@2026.10.10"]
      env: {}
    context7:
      command: bunx
      args: ["@upstash/context7-mcp@4.4.2"]
      env: {}
      readonly: true
    filesystem:
      command: bunx
      args:
        - "@modelcontextprotocol/server-filesystem@1.0.0"
        - {{ printf "%s/Working/personal" .chezmoi.homeDir | quote }}
        - {{ printf "%s/Working/community" .chezmoi.homeDir | quote }}
      env: {}
    playwright:
      command: bunx
      args: ["@playwright/mcp@0.0.83"]
      env: {}
{{- if eq .kind "pc" "laptop" "tablet" }}
    # The Dybrain vault's own server (search, read, capture, create_*,
    # link and health checks, edits, move/rename through Obsidian): it
    # refuses `ai: sensitive` notes, which no community Obsidian server
    # does. Only where Obsidian is installed; create_* also needs `node`.
    # dybrain-mcp shares one backend between every session instead of a
    # ~120 MB Python server in each one (scripts/lib/dybrain_mcp.sh).
    dybrain:
      command: {{ printf "%s/.local/bin/dybrain-mcp" .chezmoi.homeDir | quote }}
      args:
        - {{ printf "%s/Documents/DyBrain/99_System/99.03_Scripts/dev/vault-mcp.py" .chezmoi.homeDir | quote }}
      env: {}
{{- end }}
    # github needs Docker and a GITHUB_PERSONAL_ACCESS_TOKEN in the agent's
    # runtime environment; only the variable name is stored here, never a value.
    github:
      command: docker
      args: ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server:v2.2.0@sha256:040c4e99810076035eb1d9beb4b4a96fcf589c43cefed6ff51a46a553eb4e174"]
      env: {}
  # Abstract event automation, translated to each hook-capable agent's format.
  hooks:
    stop:
      event: stop
      # dyai-hunk opens the changes side by side; Claude and opencode wire it on their own.
      # The notification is shared with Claude's hooks (ai/notify-hook.sh.tmpl).
      run: {{ includeTemplate "ai/notify-hook.sh.tmpl" (dict "title" "AI agent" "body" "Task finished!" "icon" "dialog-information" "then" "command -v dyai-hunk >/dev/null 2>&1 && dyai-hunk") | trim | quote }}
    input:
      event: input
      run: {{ includeTemplate "ai/notify-hook.sh.tmpl" (dict "title" "AI agent" "body" "Waiting for your input!" "icon" "dialog-information") | trim | quote }}
  # Tools with their own per-agent installer, run once by `dyai install`.
  installers:
    # claude-mem (memory across sessions). Claude gets it via the plugin above
    # (claude-mem@thedotmack); other agents use its own installer, and every
    # agent shares one local worker and database, so one memory serves them all
    # (CLAUDE_MEM_SESSION_START_INCLUDE_ALL_SOURCES in fish shares the context).
    # --provider claude keeps the observer local and skips the hosted sign-in.
    # Gemini has no integration; Copilot's is MCP-only and writes
    # .github/copilot-instructions.md into the current directory, so it is left out.
    claude-mem:
      commands:
        opencode: "npx -y claude-mem@16.0.0 install --ide opencode --provider claude"
        codex: "npx -y claude-mem@16.0.0 install --ide codex-cli --provider claude"
        agy: "npx -y claude-mem@16.0.0 install --ide antigravity --provider claude"
        hermes: "npx -y claude-mem@16.0.0 install --ide hermes --provider claude"
  # Neovim's configured language servers, shared with every agent (dyai-lsp).
  # exclude keeps noisy/non-code-intelligence servers out of every agent;
  # serena.ref pins the MCP bridge Codex, Gemini and agy use for the
  # languages Claude's LSP plugin covers natively (ls_base_cmd override).
  lsp:
    exclude: [harper_ls, typos_lsp, sonarlint, copilot, ast_grep, tailwindcss]
    serena:
      ref: abb0a0f01b94bc8050086f0fb860077d17730324
      contexts: { codex: codex, gemini: ide, agy: antigravity }
  # Shared settings translated into each agent's settings file.
  policy:
{{ $d.policy | toYaml | indent 4 }}
  # dyai run / review / merge: headless agents in their own worktrees.
  # docs/dyai.md#crew. claude and copilot first: the two verified live.
  crew:
    fallback: [claude, copilot, gemini, opencode, codex]
    reviewer: {claude: copilot, copilot: claude, gemini: claude, opencode: claude, codex: claude}
    # model: per-agent model string. Set opencode's when its default provider
    # has no key, and copilot's to a non-Anthropic model so a copilot review
    # of a claude task is a real second provider.
    # copilot's default model is Claude: an OpenAI one keeps its review of a
    # claude task a second provider (gpt-6-luna is the lighter option).
    # opencode's default provider (Copilot) rejects its default model and
    # github-copilot/gpt-6-sol ("model is not supported"), so it uses the free
    # OpenCode Zen model; the codex and gemini names are untested on this machine.
    # claude codes on sonnet and consults the advisor of the user's settings (policy.advisorModel).
    model:
      claude: sonnet
      copilot: gpt-6-sol
      opencode: opencode/deepseek-v4.1-flash-free
      codex: gpt-5.3-codex
      gemini: gemini-4-argon
    # dyai review --by consensus: every seat reviews at once from its stance
    # and a strict majority passes; the writer's own seat sits out.
    consensus:
      - {agent: copilot, stance: neutral}
      - {agent: gemini, stance: against}
      - {agent: codex, stance: for}
      - {agent: claude, stance: against}
    # An hour: a big feature outruns half of one.
    timeout: 3600
    cooldown: 900
    # Crew state in one repository every machine shares (docs/dyai-store.md):
    # signed with ~/.config/dyai/node/signing and pushed with the deploy key
    # ~/.config/dyai/node/deploy, both rendered from
    # secrets/data/personal/dyai.yaml.age and made on a new machine by
    # .chezmoiscripts/run_onchange_after_04-setup-dyai-node.sh. Trust lives in
    # nodes/allowed_signers on the store's main, which no deploy key may push.
    # Only a machine with keys (dyai/node-identity.tmpl: the personal
    # secrets, or its company's) joins; the others keep their crew state on
    # their own (the local backend).
    {{- if includeTemplate "dyai/node-identity.tmpl" . | trim }}
    store:
      backend: git
      url: git@gitlab.com:dynamo-brain/dyai-state.git
      node: {{ .code | quote }}
      ssh_key: ~/.config/dyai/node/deploy
      signing_key: ~/.config/dyai/node/signing
      # Who may sign accounts.yaml on the store's main (`dyai accounts sign`):
      # the user's own key, never a node's.
      registry_signers:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPLc0+n6eOPVVVpa/PXNkniyWLlxVXjlS3xzllA+bLhD dynamo
      # The other machines, by their code (also their SSH host name), to reach
      # the store through when this one cannot: personal ones only, as the
      # store is, always-on ones first, never a phone or a tablet.
      relays:
      {{- range $kind := list "vm" "pc" "laptop" }}
      {{-   range $code, $m := $.machines }}
      {{-     if and (ne $code $.code) (eq $m.kind $kind) $m.decryptPersonal }}
        - {{ $code | quote }}
      {{-     end }}
      {{-   end }}
      {{- end }}
    {{- end }}
    require_review: true
    # A first failed review asks one more provider for the root cause and
    # the smallest fix, which `dyai fix` hands the writer.
    advice: {enabled: true, by: auto}
    # lean: a worker loads the policy and the agent rules, not the plugins
    # and MCP servers (claude: ~57k to ~30k input tokens per call).
    profile: lean
    # A zellij pane per started worker (its log) and per review (hunk).
    panes: auto
    # dyai judge (and after every pass, with auto): laya, on this machine,
    # scores risk, scope and whether a person should read it; jev, a hosted
    # model that gets the diff and needs its provider key in the environment,
    # gates the change and the writer's claims. Advice only: merging stays yours.
    judge: {auto: true, laya: true, jev: false}
    # Through the dybrain MCP server, when one is configured: a failed review
    # becomes a fleeting note (a lesson to promote at the weekly review), a
    # merge a line in the daily note.
    dybrain: true
    fences:
      - ":(glob).github/**"
      - ":(glob)**/.chezmoiscripts/**"
      - ":(glob)secrets/**"
      - ":(glob)**/*.age"
      - ":(glob)**/.env*"
      # The agent policy itself: a worker that loosens it loosens it for every agent.
      - ":(glob)**/.claude/**"
      - ":(glob)**/private_dot_claude/**"
      - ":(glob)**/private_dot_codex/**"
      - ":(glob)**/private_dot_gemini/**"
      - ":(glob)**/private_dot_copilot/**"
      - ":(glob)**/private_dot_hermes/**"
      - ":(glob)**/private_dot_config/opencode/**"
      - ":(glob)**/private_dot_config/dyai/**"
      - ":(glob)**/dot_agents/**"
      - ":(glob)**/.chezmoitemplates/ai/**"
      - ":(glob)**/.chezmoitemplates/dyai/**"
      - ":(glob)**/dyai*.sh"
      # What hooks, git and the shell run outside the sandbox, as the
      # denyWrite list of Claude's settings names it: a worker that changes
      # them changes code every agent runs unsandboxed.
      - ":(glob)scripts/lib/**"
      - ":(glob)scripts/*.sh"
      - ":(glob).pre-commit-config.yaml"
      - ":(glob)mise.toml"
      - ":(glob).gitmodules"
      - ":(glob)cascadeur/**"
      - ":(glob)**/private_dot_config/git/**"
      - ":(glob)**/private_dot_config/fish/**"
# Roots whose mise config moves an agent's home (CLAUDE_CONFIG_DIR,
# COPILOT_HOME, ...): dyai installs the same setup into each moved home. Read
# off those mise configs, so moving a home there is all a new context takes.
{{- $work := joinPath .chezmoi.sourceDir "private_Working" }}
{{- $contexts := list }}
{{- range $f := concat (glob (joinPath $work "*" "*" "dot_mise.toml.tmpl")) (glob (joinPath $work "*" "*" "*" "dot_mise.toml.tmpl")) }}
{{- /* The raw source, not the render (that would decrypt): match the shared partial too */}}
{{-   if regexMatch "(?m)^(CLAUDE_CONFIG_DIR|COPILOT_HOME|CODEX_HOME|OPENCODE_CONFIG) =|\"mise/env_ai\\.toml\\.tmpl\"" (include $f) }}
{{-     $contexts = append $contexts (printf "~/Working/%s" ($f | dir | trimPrefix (printf "%s/" $work))) }}
{{-   end }}
{{- end }}
{{- /* toJson, not a block list: with no context it must stay [], not null */}}
contexts: {{ $contexts | toJson }}
agents:
  claude:
    marketplaces:
{{ $d.marketplaces | toYaml | indent 6 }}
    plugins:
{{- range $d.plugins }}
      - {{ . }}
{{- end }}
    # Installed but off globally; a preset's `plugins` switches them on.
    optional_plugins:
{{- range $d.optional_plugins }}
      - {{ . }}
{{- end }}
    # Claude's own name for each abstract tier. Other agents map theirs the
    # same way, as a string or {model, provider, effort} (a self-hosted
    # Ollama or LM Studio provider included) once they get subagents.
    model_tiers:
{{ $d.model_tiers | toYaml | trim | indent 6 }}
  # Copilot on its own GPT line, a provider apart from Claude; each checked
  # live on 2026-11-15. Its main model is gpt-6-sol (~/.copilot/settings.json).
  copilot:
    model_tiers:
      fast: gpt-6-luna
      standard: gpt-6-sol
      strong: gpt-6.1-sol
# Opt-in presets pulled per project by `dyai use <name>`; kept out of the
# global baseline so the discovery index stays lean. One preset per tool, so a
# project pulls only what it uses. Subagent names resolve against the pinned
# global.subagents repo (materialize finds a <name>.md anywhere in the tree) —
# so every name below is coupled to global.subagents[0].ref. A missing name
# only warns at install time, never fails; re-verify these whenever that ref is
# bumped. The "registry subagent names exist" bats test guards this when the
# pinned repo is cached. A skill is pinned to a commit by a GitHub tree URL,
# whose last part must be the skill's name; the `owner/repo@name` ones left
# follow upstream, as their repository has no single directory of that name.
registry:
  languages:
    go:
      subagents: [golang-pro]
      skills:
        - https://github.com/samber/cc-skills-golang/tree/d68d80aec298e1b74b37c2a472c002b5217248b3/skills/golang-code-style
        - https://github.com/samber/cc-skills-golang/tree/d68d80aec298e1b74b37c2a472c002b5217248b3/skills/golang-testing
        - https://github.com/samber/cc-skills-golang/tree/d68d80aec298e1b74b37c2a472c002b5217248b3/skills/golang-error-handling
        - https://github.com/samber/cc-skills-golang/tree/d68d80aec298e1b74b37c2a472c002b5217248b3/skills/golang-grpc
        - https://github.com/samber/cc-skills-golang/tree/d68d80aec298e1b74b37c2a472c002b5217248b3/skills/golang-security
    python:
      subagents: [python-pro]
      plugins:
        - modern-python@trailofbits
      skills:
        - https://github.com/mindrally/skills/tree/7682ca77710e0971eab4e0ae5dddfa281aea0ba5/fastapi-python
        - affaan-m/ecc@python-patterns
        - affaan-m/ecc@python-testing
    rust:
      subagents: [rust-engineer]
      skills:
        - https://github.com/apollographql/skills/tree/9dda1397730370aeb8df4ff8f2015c34c86b5003/skills/rust-best-practices
        - affaan-m/ecc@rust-patterns
        - affaan-m/ecc@rust-testing
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/cargo-workflows
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-async-internals
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-build-times
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-cross
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-debugging
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-ffi
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-no-std
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-profiling
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-sanitizers-miri
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-security
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rust-unsafe
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/rust/rustc-basics
    # Skills-only: no VoltAgent subagent for Zig.
    zig:
      skills:
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-build-system
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-cinterop
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-compiler
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-comptime
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-cross
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-debugging
        - https://github.com/mohitmishra786/low-level-dev-skills/tree/18f29518a47fda070e6ec1268cb577692fae9a10/skills/zig/zig-testing
    typescript:
      subagents: [typescript-pro]
      skills:
        - mcollina/skills@fastify-best-practices
        - affaan-m/ecc@nestjs-patterns
        - affaan-m/ecc@vite-patterns
    frontend:
      subagents: [react-specialist]
      plugins:
        - frontend-design@claude-plugins-official
      skills:
