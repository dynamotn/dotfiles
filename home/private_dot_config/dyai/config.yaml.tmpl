        - mcp-server-dev@claude-plugins-official
        - agent-sdk-dev@claude-plugins-official
      skills:
        - https://github.com/wshobson/agents/tree/91ff75307f5668916f3eb77d5ba556266c961376/plugins/llm-application-dev/skills/rag-implementation
        - https://github.com/wshobson/agents/tree/91ff75307f5668916f3eb77d5ba556266c961376/plugins/llm-application-dev/skills/llm-evaluation
        - axiomhq/skills@writing-evals
        - arize-ai/phoenix@phoenix-evals
        - https://github.com/anthropics/skills/tree/e4bb5d960d87126ff3b3a8af1a104b7db67560ba/skills/claude-api
        - openai/skills@openai-docs
    langchain:
      skills:
        - langchain-ai/langchain-skills@langgraph-fundamentals
        - langchain-ai/langchain-skills@langgraph-persistence
        - langchain-ai/langchain-skills@langgraph-human-in-the-loop
        - langchain-ai/langchain-skills@langchain-rag
    huggingface:
      skills:
        - https://github.com/huggingface/skills/tree/5291c2b9365e06b175dc04817610c778623f4836/skills/huggingface-datasets
        - https://github.com/huggingface/skills/tree/5291c2b9365e06b175dc04817610c778623f4836/skills/huggingface-llm-trainer
        - https://github.com/huggingface/skills/tree/5291c2b9365e06b175dc04817610c778623f4836/skills/huggingface-community-evals
    # Leftover VoltAgent developer-experience agents, opt in per project.
    modernization:
      subagents: [legacy-modernizer, refactoring-specialist, dependency-manager, git-workflow-manager]
    apidocs:
      subagents: [api-documenter, documentation-engineer, docs-drift-editor]
    # Code knowledge graph: codegraph_explore returns the source and call paths
    # a question needs in one call, which pays off on large repos (no bash
    # support). Needs `codegraph init` in the project; telemetry is off.
    codegraph:
      mcp:
        codegraph:
          command: bunx
          args: ["@colbymchenry/codegraph@1.6.2", "serve", "--mcp"]
          env: { CODEGRAPH_TELEMETRY: "0" }
    # Getting to know an unfamiliar repo. understand-anything builds a graph
    # with guided tours and a dashboard (Claude only; the first /understand
    # spends many tokens); archify draws source-backed interactive diagrams
    # (needs node).
    onboarding:
      plugins:
        - understand-anything@understand-anything
      skills:
        - https://github.com/tt-a1i/archify/tree/8509a3d63e763b4d454ea9aafa1f939545fcb1ea/archify
    # Spec-driven changes (propose, apply, archive under openspec/). The skills
    # drive the `openspec` CLI (dytoy openspec); run `openspec init` in the
    # project first. OPENSPEC_TELEMETRY=0 turns its usage stats off.
    openspec:
      skills:
{{- range list "explore" "propose" "new-change" "continue-change" "ff-change" "update-change" "apply-change" "verify-change" "sync-specs" "archive-change" "bulk-archive-change" "onboard" }}
        - Fission-AI/OpenSpec@openspec-{{ . }}
{{- end }}
    # Context engineering for building agents, from
    # muratcankoylan/Agent-Skills-for-Context-Engineering pinned to a commit.
    # Its root SKILL.md (a collection index) hides the nested skills from the
    # skills CLI, so each is pinned by tree URL.
    context:
      skills:
{{- range list "context-fundamentals" "context-degradation" "context-compression" "context-optimization" "multi-agent-patterns" "memory-systems" "tool-design" "evaluation" }}
        - https://github.com/muratcankoylan/Agent-Skills-for-Context-Engineering/tree/9ff0c99108b36d3b886defd825d8ac1f47dba374/skills/{{ . }}
{{- end }}
