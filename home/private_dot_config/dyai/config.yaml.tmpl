{{- /*
  dyai: single declarative source for AI-agent extensions and settings.
  The AI setup hook (run_onchange_after_03-setup-ai.sh) reads this to install.
  `global` is shared across agents; `agents.<name>` is agent-specific.
  Claude's marketplaces, plugins and policy come from the shared data partial
  so this file and ~/.claude/settings.json never drift.
*/ -}}
{{- $d := fromYaml (includeTemplate "ai/dyai-data.yaml.tmpl" .) -}}
global:
  # Community skills from https://skills.sh, installed for every agent with the
  # skills CLI. Only cross-cutting skills every project benefits from live here;
  # everything tied to a language, tool or domain moved to a registry preset
  # (`dyai use <name>`) so this baseline stays lean.
  skills:
    - vercel-labs/skills@find-skills
    - wshobson/agents@api-design-principles
    - addyosmani/agent-skills@api-and-interface-design
    - spillwavesolutions/design-doc-mermaid@design-doc-mermaid
    - softaworks/agent-toolkit@c4-architecture
    - addyosmani/agent-skills@documentation-and-adrs
    - wshobson/agents@architecture-patterns
    - wondelai/skills@domain-driven-design
    - anthropics/skills@mcp-builder
    - wshobson/agents@prompt-engineering-patterns
    - wshobson/agents@git-advanced-workflows
  # Agent role definitions and commands/prompts (populated in a later phase).
  # Baseline subagents: VoltAgent categories installed into every agent's
  # agents dir (Claude-format today). Pinned to a commit, never a branch.
  subagents:
    - repo: VoltAgent/awesome-claude-code-subagents
      ref: 408d3c9eee2d
      include:
        - categories/01-core-development
        - categories/04-quality-security
        - categories/09-meta-orchestration
        - categories/10-research-analysis
      # Domain-specific agents kept out of the always-installed baseline; each
      # is pulled per project by the matching preset below (desktop, mobile,
      # graphql, realtime), which resolves it from the same pinned repo.
      # Every agent here is listed in every session's context, so the business
      # analysis and niche security agents go behind `research` / `security`,
      # and the two that fight dyai or target Windows/Azure ops are dropped.
      exclude:
        - electron-pro
        - mobile-developer
        - graphql-architect
        - websocket-engineer
        - webhook-engineer
        - ad-security-reviewer
        - powershell-security-hardening
        - gdpr-ccpa-compliance
        - compliance-auditor
        - penetration-tester
        - ab-test-analysis
        - cohort-analysis
        - competitive-analyst
        - market-researcher
        - project-idea-validator
        - trend-analyst
        - scientific-literature-researcher
        - agent-installer
        - it-ops-orchestrator
      # Abstract tier where the upstream choice is wrong for the job (review
      # and security judgments never run below the strongest tier). Each
      # agent translates it through its own agents.<name>.model_tiers.
      models:
        code-reviewer: strong
        security-auditor: strong
        architect-reviewer: strong
        research-analyst: standard
  commands: []
  # MCP servers registered into every MCP-capable agent, in its own format.
  mcp:
    # laya-mcp shares one loopback laya-serve between every session instead
    # of loading the checkpoints (~3.4 GB) in each one (scripts/lib/laya_mcp.sh).
    laya:
      command: {{ printf "%s/.local/bin/laya-mcp" .chezmoi.homeDir | quote }}
      args: []
      env:
        HF_HUB_DISABLE_TELEMETRY: "1"
    # dyai itself: lets an agent list the registry presets and opt the
    # project it works in into one (`dyai mcp`, scripts/lib/dyai_mcp.sh).
    dyai:
      command: {{ printf "%s/.local/bin/dyai" .chezmoi.homeDir | quote }}
      args: ["mcp"]
      env: {}
    # Community servers from the official modelcontextprotocol registry (and
    # Upstash's context7), pinned. Node servers run via bunx, Python via uvx,
    # github via docker. An agent missing the launcher is skipped by the hook.
    # uv (exclude-newer) and bun (minimum-release-age) refuse any release
    # younger than 7 days, so a pin must be at least that old or the server
    # never starts; the "MCP pins clear the cooldown" bats test checks it.
    # readonly marks a server with no side effects or call-to-call state, whose
    # tools Codex may then call in parallel.
    sequential-thinking:
      command: bunx
      args: ["@modelcontextprotocol/server-sequential-thinking@1.0.0"]
      env: {}
    fetch:
      command: uvx
      args: ["mcp-server-fetch@2026.10.10"]
      env: {}
      readonly: true
    time:
      command: uvx
      args: ["mcp-server-time@2026.10.10"]
      env: {}
      readonly: true
    git:
      command: uvx
      args: ["mcp-server-git@2026.10.10"]
      env: {}
    memory:
      command: bunx
      args: ["@modelcontextprotocol/server-memory@1.0.0"]
      env: {}
    context7:
      command: bunx
      args: ["@upstash/context7-mcp@4.4.2"]
      env: {}
      readonly: true
    filesystem:
      command: bunx
      args:
        - "@modelcontextprotocol/server-filesystem@1.0.0"
        - {{ printf "%s/Working/personal" .chezmoi.homeDir | quote }}
        - {{ printf "%s/Working/community" .chezmoi.homeDir | quote }}
      env: {}
    playwright:
      command: bunx
      args: ["@playwright/mcp@0.0.83"]
      env: {}
{{- if eq .kind "pc" "laptop" "tablet" }}
    # The Dybrain vault's own server (search, read, capture, create_*,
    # link and health checks, edits, move/rename through Obsidian): it
    # refuses `ai: sensitive` notes, which no community Obsidian server
    # does. Only where Obsidian is installed; create_* also needs `node`.
    # dybrain-mcp shares one backend between every session instead of a
    # ~120 MB Python server in each one (scripts/lib/dybrain_mcp.sh).
    dybrain:
      command: {{ printf "%s/.local/bin/dybrain-mcp" .chezmoi.homeDir | quote }}
      args:
        - {{ printf "%s/Documents/DyBrain/99_System/99.03_Scripts/dev/vault-mcp.py" .chezmoi.homeDir | quote }}
      env: {}
{{- end }}
    # github needs Docker and a GITHUB_PERSONAL_ACCESS_TOKEN in the agent's
    # runtime environment; only the variable name is stored here, never a value.
    github:
      command: docker
      args: ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"]
      env: {}
  # Abstract event automation, translated to each hook-capable agent's format.
  hooks:
    stop:
      event: stop
      # dyai-hunk opens the changes side by side; Claude and opencode wire it on their own.
      # A crew worker (DYAI_CREW set) stays quiet: nobody is at its desktop.
      run: "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v notify-send > /dev/null 2>&1 && notify-send 'AI agent' 'Task finished!' --icon=dialog-information; command -v dyai-hunk > /dev/null 2>&1 && dyai-hunk; true"
    input:
      event: input
      run: "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v notify-send > /dev/null 2>&1 && notify-send 'AI agent' 'Waiting for your input!' --icon=dialog-information; true"
  # Tools with their own per-agent installer, run once by `dyai install`.
  installers:
    # claude-mem (memory across sessions). Claude gets it via the plugin above
    # (claude-mem@thedotmack); other agents use its own installer, and every
    # agent shares one local worker and database, so one memory serves them all
    # (CLAUDE_MEM_SESSION_START_INCLUDE_ALL_SOURCES in fish shares the context).
    # --provider claude keeps the observer local and skips the hosted sign-in.
    # Gemini has no integration; Copilot's is MCP-only and writes
    # .github/copilot-instructions.md into the current directory, so it is left out.
    claude-mem:
      commands:
        opencode: "npx -y claude-mem install --ide opencode --provider claude"
        codex: "npx -y claude-mem install --ide codex-cli --provider claude"
        agy: "npx -y claude-mem install --ide antigravity --provider claude"
        hermes: "npx -y claude-mem install --ide hermes --provider claude"
  # Neovim's configured language servers, shared with every agent (dyai-lsp).
  # exclude keeps noisy/non-code-intelligence servers out of every agent;
  # serena.ref pins the MCP bridge Codex, Gemini and agy use for the
  # languages Claude's LSP plugin covers natively (ls_base_cmd override).
  lsp:
    exclude: [harper_ls, typos_lsp, sonarlint, copilot, ast_grep, tailwindcss]
    serena:
      ref: abb0a0f01b94bc8050086f0fb860077d17730324
      contexts: { codex: codex, gemini: ide, agy: antigravity }
  # Shared settings translated into each agent's settings file.
  policy:
{{ $d.policy | toYaml | indent 4 }}
  # dyai run / review / merge: headless agents in their own worktrees.
  # docs/dyai.md#crew. claude and copilot first: the two verified live.
  crew:
    fallback: [claude, copilot, gemini, opencode, codex]
    reviewer: {claude: copilot, copilot: claude, gemini: claude, opencode: claude, codex: claude}
    # model: per-agent model string. Set opencode's when its default provider
    # has no key, and copilot's to a non-Anthropic model so a copilot review
    # of a claude task is a real second provider.
    # copilot's default model is Claude: an OpenAI one keeps its review of a
    # claude task a second provider (gpt-6-luna is the lighter option).
    model: {copilot: gpt-6-sol}
    # dyai review --by consensus: every seat reviews at once from its stance
    # and a strict majority passes; the writer's own seat sits out.
    consensus:
      - {agent: copilot, stance: neutral}
      - {agent: gemini, stance: against}
      - {agent: codex, stance: for}
      - {agent: claude, stance: against}
    timeout: 1800
    cooldown: 900
    require_review: true
    # lean: a worker loads the policy and the agent rules, not the plugins
    # and MCP servers (claude: ~57k to ~30k input tokens per call).
    profile: lean
    # A zellij pane per started worker (its log) and per review (hunk).
    panes: auto
    # dyai judge (and after every pass, with auto): laya, on this machine,
    # scores risk, scope and whether a person should read it; jev, a hosted
    # model that gets the diff and needs its provider key in the environment,
    # gates the change and the writer's claims. Advice only: merging stays yours.
    judge: {auto: true, laya: true, jev: false}
    # Through the dybrain MCP server, when one is configured: a failed review
    # becomes a fleeting note (a lesson to promote at the weekly review), a
    # merge a line in the daily note.
    dybrain: true
    fences:
      - ":(glob).github/**"
      - ":(glob)**/.chezmoiscripts/**"
      - ":(glob)secrets/**"
      - ":(glob)**/*.age"
      - ":(glob)**/.env*"
      # The agent policy itself: a worker that loosens it loosens it for every agent.
      - ":(glob)**/.claude/**"
      - ":(glob)**/private_dot_claude/**"
      - ":(glob)**/.chezmoitemplates/ai/**"
      - ":(glob)**/dyai*.sh"
# Roots whose mise config moves an agent's home (CLAUDE_CONFIG_DIR,
# COPILOT_HOME, ...): dyai installs the same setup into each moved home. Read
# off those mise configs, so moving a home there is all a new context takes.
contexts:
{{- $work := joinPath .chezmoi.sourceDir "private_Working" }}
{{- range $f := concat (glob (joinPath $work "*" "*" "dot_mise.toml.tmpl")) (glob (joinPath $work "*" "*" "*" "dot_mise.toml.tmpl")) }}
{{-   if regexMatch "(?m)^(CLAUDE_CONFIG_DIR|COPILOT_HOME|CODEX_HOME|OPENCODE_CONFIG) =" (include $f) }}
  - "~/Working/{{ $f | dir | trimPrefix (printf "%s/" $work) }}"
{{-   end }}
{{- end }}
agents:
  claude:
    marketplaces:
{{ $d.marketplaces | toYaml | indent 6 }}
    plugins:
{{- range $d.plugins }}
      - {{ . }}
{{- end }}
    # Installed but off globally; a preset's `plugins` switches them on.
    optional_plugins:
{{- range $d.optional_plugins }}
      - {{ . }}
{{- end }}
    # Claude's own name for each abstract tier. Other agents map theirs the
    # same way, as a string or {model, provider, effort} (a self-hosted
    # Ollama or LM Studio provider included) once they get subagents.
    model_tiers:
      fast: haiku
      standard: sonnet
      strong: opus
# Opt-in presets pulled per project by `dyai use <name>`; kept out of the
# global baseline so the discovery index stays lean. One preset per tool, so a
# project pulls only what it uses. Subagent names resolve against the pinned
# global.subagents repo (materialize finds a <name>.md anywhere in the tree) —
# so every name below is coupled to global.subagents[0].ref. A missing name
# only warns at install time, never fails; re-verify these whenever that ref is
# bumped. The "registry subagent names exist" bats test guards this when the
# pinned repo is cached.
registry:
