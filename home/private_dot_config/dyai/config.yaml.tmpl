        - ollygarden/opentelemetry-agent-skills@otel-semantic-conventions
        - ollygarden/opentelemetry-agent-skills@otel-ottl
    # SLOs, incidents, on-call and the Prometheus/Grafana/Loki stack.
    # prometheus reads PROMETHEUS_URL; grafana reads GRAFANA_URL and
    # GRAFANA_SERVICE_ACCOUNT_TOKEN, all from the runtime env.
    sre:
      subagents: [sre-engineer, incident-responder, devops-incident-responder]
      skills:
        - wshobson/agents@slo-implementation
        - wshobson/agents@incident-runbook-templates
