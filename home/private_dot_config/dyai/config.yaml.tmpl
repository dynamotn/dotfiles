{{- /*
  dyai: single declarative source for AI-agent extensions and settings.
  The AI setup hook (run_onchange_after_03-setup-ai.sh) reads this to install.
  `global` is shared across agents; `agents.<name>` is agent-specific.
  Claude's marketplaces, plugins and policy come from the shared data partial
  so this file and ~/.claude/settings.json never drift.
*/ -}}
{{- $d := fromYaml (includeTemplate "ai/dyai-data.yaml.tmpl" .) -}}
global:
  # Community skills from https://skills.sh, installed for every agent with the
  # skills CLI. Only cross-cutting skills every project benefits from live here;
  # everything tied to a language, tool or domain moved to a registry preset
  # (`dyai use <name>`) so this baseline stays lean.
  skills:
    - vercel-labs/skills@find-skills
    - wshobson/agents@api-design-principles
    - addyosmani/agent-skills@api-and-interface-design
    - spillwavesolutions/design-doc-mermaid@design-doc-mermaid
    - softaworks/agent-toolkit@c4-architecture
    - addyosmani/agent-skills@documentation-and-adrs
    - wshobson/agents@architecture-patterns
    - wondelai/skills@domain-driven-design
    - anthropics/skills@mcp-builder
    - wshobson/agents@prompt-engineering-patterns
  # Agent role definitions and commands/prompts (populated in a later phase).
  # Baseline subagents: VoltAgent categories installed into every agent's
  # agents dir (Claude-format today). Pinned to a commit, never a branch.
  subagents:
    - repo: VoltAgent/awesome-claude-code-subagents
      ref: 408d3c9eee2d
      include:
        - categories/01-core-development
        - categories/04-quality-security
        - categories/09-meta-orchestration
        - categories/10-research-analysis
      # Domain-specific agents kept out of the always-installed baseline; each
      # is pulled per project by the matching preset below (desktop, mobile,
      # graphql, realtime), which resolves it from the same pinned repo.
      # Every agent here is listed in every session's context, so the business
      # analysis and niche security agents go behind `research` / `security`,
      # and the two that fight dyai or target Windows/Azure ops are dropped.
      exclude:
        - electron-pro
        - mobile-developer
        - graphql-architect
        - websocket-engineer
        - webhook-engineer
        - ad-security-reviewer
        - powershell-security-hardening
        - gdpr-ccpa-compliance
        - compliance-auditor
        - penetration-tester
        - ab-test-analysis
        - cohort-analysis
        - competitive-analyst
        - market-researcher
        - project-idea-validator
        - trend-analyst
        - scientific-literature-researcher
        - agent-installer
        - it-ops-orchestrator
  commands: []
  # MCP servers registered into every MCP-capable agent, in its own format.
  mcp:
    laya:
      command: {{ printf "%s/.local/bin/laya-mcp-server" .chezmoi.homeDir | quote }}
      args: []
      env:
        HF_HUB_DISABLE_TELEMETRY: "1"
    # Community servers from the official modelcontextprotocol registry (and
    # Upstash's context7), pinned. Node servers run via bunx, Python via uvx,
    # github via docker. An agent missing the launcher is skipped by the hook.
    # uv (exclude-newer) and bun (minimum-release-age) refuse any release
    # younger than 7 days, so a pin must be at least that old or the server
    # never starts; the "MCP pins clear the cooldown" bats test checks it.
    # readonly marks a server with no side effects or call-to-call state, whose
    # tools Codex may then call in parallel.
    sequential-thinking:
      command: bunx
      args: ["@modelcontextprotocol/server-sequential-thinking@1.0.0"]
      env: {}
    fetch:
      command: uvx
      args: ["mcp-server-fetch@2026.10.10"]
      env: {}
      readonly: true
    time:
      command: uvx
      args: ["mcp-server-time@2026.10.10"]
      env: {}
      readonly: true
    git:
      command: uvx
      args: ["mcp-server-git@2026.10.10"]
      env: {}
    memory:
      command: bunx
      args: ["@modelcontextprotocol/server-memory@1.0.0"]
      env: {}
    context7:
      command: bunx
      args: ["@upstash/context7-mcp@4.4.2"]
      env: {}
      readonly: true
    filesystem:
      command: bunx
      args:
        - "@modelcontextprotocol/server-filesystem@1.0.0"
        - {{ printf "%s/Working/personal" .chezmoi.homeDir | quote }}
        - {{ printf "%s/Working/community" .chezmoi.homeDir | quote }}
      env: {}
    playwright:
      command: bunx
      args: ["@playwright/mcp@0.0.83"]
      env: {}
    # github needs Docker and a GITHUB_PERSONAL_ACCESS_TOKEN in the agent's
    # runtime environment; only the variable name is stored here, never a value.
    github:
      command: docker
      args: ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"]
      env: {}
  # Abstract event automation, translated to each hook-capable agent's format.
  hooks:
    stop:
      event: stop
      run: "command -v notify-send > /dev/null 2>&1 && notify-send 'AI agent' 'Task finished!' --icon=dialog-information; true"
    input:
      event: input
      run: "command -v notify-send > /dev/null 2>&1 && notify-send 'AI agent' 'Waiting for your input!' --icon=dialog-information; true"
  # Tools with their own per-agent installer, run once by `dyai install`.
  installers:
    # claude-mem (memory across sessions). Claude gets it via the plugin above
    # (claude-mem@thedotmack); other agents use its own installer. Only opencode
    # has a documented --ide flag today; add others once their flag is known.
    claude-mem:
      commands:
        opencode: "npx -y claude-mem install --ide opencode"
  # Neovim's configured language servers, shared with every agent (dyai-lsp).
  # exclude keeps noisy/non-code-intelligence servers out of every agent;
  # serena.ref pins the MCP bridge Codex, Gemini and agy use for the
  # languages Claude's LSP plugin covers natively (ls_base_cmd override).
  lsp:
    exclude: [harper_ls, typos_lsp, sonarlint, copilot, ast_grep, tailwindcss]
    serena:
      ref: abb0a0f01b94bc8050086f0fb860077d17730324
      contexts: { codex: codex, gemini: ide, agy: antigravity }
  # Shared settings translated into each agent's settings file.
  policy:
{{ $d.policy | toYaml | indent 4 }}
agents:
  claude:
    marketplaces:
{{ $d.marketplaces | toYaml | indent 6 }}
    plugins:
{{- range $d.plugins }}
      - {{ . }}
{{- end }}
    # Installed but off globally; a preset's `plugins` switches them on.
    optional_plugins:
{{- range $d.optional_plugins }}
      - {{ . }}
{{- end }}
# Opt-in presets pulled per project by `dyai use <name>`; kept out of the
# global baseline so the discovery index stays lean. One preset per tool, so a
# project pulls only what it uses. Subagent names resolve against the pinned
# global.subagents repo (materialize finds a <name>.md anywhere in the tree) —
# so every name below is coupled to global.subagents[0].ref. A missing name
# only warns at install time, never fails; re-verify these whenever that ref is
# bumped. The "registry subagent names exist" bats test guards this when the
# pinned repo is cached.
registry:
  languages:
    go:
      subagents: [golang-pro]
      skills:
        - samber/cc-skills-golang@golang-code-style
        - samber/cc-skills-golang@golang-testing
        - samber/cc-skills-golang@golang-error-handling
        - samber/cc-skills-golang@golang-grpc
        - samber/cc-skills-golang@golang-security
    python:
      subagents: [python-pro]
      skills:
        - mindrally/skills@fastapi-python
        - affaan-m/ecc@python-patterns
        - affaan-m/ecc@python-testing
    rust:
      subagents: [rust-engineer]
      skills:
        - apollographql/skills@rust-best-practices
        - affaan-m/ecc@rust-patterns
        - affaan-m/ecc@rust-testing
    typescript:
      subagents: [typescript-pro]
      skills:
        - mcollina/skills@fastify-best-practices
        - affaan-m/ecc@nestjs-patterns
        - affaan-m/ecc@vite-patterns
    frontend:
      subagents: [react-specialist]
      skills:
        - vercel-labs/agent-skills@vercel-react-best-practices
        - leonxlnx/taste-skill@design-taste-frontend
        - addyosmani/web-quality-skills@accessibility
        - addyosmani/web-quality-skills@core-web-vitals
        - addyosmani/web-quality-skills@performance
        - affaan-m/ecc@react-testing
        - affaan-m/ecc@react-performance
    vue:
      subagents: [vue-expert]
      skills:
        - vuejs-ai/skills@vue-best-practices
        - vuejs-ai/skills@vue-pinia-best-practices
        - vuejs-ai/skills@vue-router-best-practices
        - affaan-m/ecc@nuxt4-patterns
    angular:
      subagents: [angular-architect]
      skills:
        - angular/skills@angular-developer
        - angular/skills@angular-new-app
    java:
      subagents: [java-architect, spring-boot-engineer]
      skills:
        - github/awesome-copilot@java-springboot
        - affaan-m/ecc@java-coding-standards
        - affaan-m/ecc@springboot-security
        - affaan-m/ecc@jpa-patterns
    csharp:
      subagents: [csharp-developer, dotnet-core-expert]
      skills:
        - github/awesome-copilot@csharp-async
        - github/awesome-copilot@csharp-xunit
        - github/awesome-copilot@csharp-docs
        - affaan-m/ecc@dotnet-patterns
    cpp:
      subagents: [cpp-pro]
      skills:
        - affaan-m/ecc@cpp-coding-standards
        - affaan-m/ecc@cpp-testing
    php:
      subagents: [php-pro, laravel-specialist]
      skills:
        - jeffallan/claude-skills@laravel-specialist
        - jeffallan/claude-skills@php-pro
        - affaan-m/ecc@laravel-tdd
        - affaan-m/ecc@laravel-security
    ruby:
      subagents: [rails-expert]
      skills:
        - jeffallan/claude-skills@rails-expert
        - affaan-m/ecc@rails-patterns
    swift:
      subagents: [swift-expert]
      skills:
        - emilkowalski/skills@write-swift
        - avdlee/swiftui-agent-skill@swiftui-expert-skill
        - avdlee/swift-concurrency-agent-skill@swift-concurrency
        - affaan-m/ecc@swift-protocol-di-testing
    dart:
      subagents: [flutter-expert]
      skills:
        - flutter/agent-plugins@flutter-apply-architecture-best-practices
        - dart-lang/skills@dart-add-unit-test
        - affaan-m/ecc@dart-flutter-patterns
        - flutter/skills@flutter-add-widget-test
        - flutter/skills@flutter-fix-layout-issues
  infra:
    terraform:
      subagents: [terraform-engineer]
      skills:
        - hashicorp/agent-skills@terraform-style-guide
        - hashicorp/agent-skills@terraform-test
        - hashicorp/agent-skills@refactor-module
        - hashicorp/agent-skills@terraform-search-import
        - hashicorp/agent-skills@terraform-stacks
        - hashicorp/agent-skills@terraform-policy
        - wshobson/agents@terraform-module-library
      # Registry and provider docs lookup; needs Docker, no credential.
      mcp:
        terraform:
          command: docker
          args: ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.4.1"]
          env: {}
    kubernetes:
      subagents: [kubernetes-specialist]
      skills:
        - jeffallan/claude-skills@kubernetes-specialist
        - wshobson/agents@helm-chart-scaffolding
        - affaan-m/ecc@kubernetes-patterns
        - wshobson/agents@k8s-security-policies
        - akin-ozer/cc-devops-skills@k8s-yaml-validator
        - akin-ozer/cc-devops-skills@helm-validator
        - akin-ozer/cc-devops-skills@k8s-debug
      # Talks to the cluster of the current kubeconfig context.
      mcp:
        kubernetes:
          command: bunx
          args: ["kubernetes-mcp-server@0.0.67"]
          env: {}
    docker:
      subagents: [docker-expert]
      skills: [affaan-m/ecc@docker-patterns]
    aws:
      subagents: [cloud-architect]
      skills:
        - aws/agent-toolkit-for-aws@aws-iam
        - aws/agent-toolkit-for-aws@aws-observability
      # Docs, list prices and architecture diagrams; none reads the account.
      mcp:
        aws-docs:
          command: uvx
          args: ["awslabs.aws-documentation-mcp-server@1.2.3"]
          env: {}
          readonly: true
        aws-pricing:
          command: uvx
          args: ["awslabs.aws-pricing-mcp-server@1.1.1"]
          env: {}
          readonly: true
        aws-diagram:
          command: uvx
          args: ["awslabs.aws-diagram-mcp-server@1.0.23"]
          env: {}
    azure:
      subagents: [azure-infra-engineer]
      skills:
        - hashicorp/agent-skills@azure-verified-modules
        - akin-ozer/cc-devops-skills@azure-pipelines-generator
        - akin-ozer/cc-devops-skills@azure-pipelines-validator
      # Signs in through the az CLI session; no credential stored here.
      mcp:
        azure:
          command: bunx
          args: ["@azure/mcp@3.0.0", "server", "start"]
          env: {}
    # Uses the gcloud CLI's active account; no credential stored here.
    gcp:
      mcp:
        gcloud:
          command: bunx
          args: ["@google-cloud/gcloud-mcp@0.5.3"]
          env: {}
        gcp-observability:
          command: bunx
          args: ["@google-cloud/observability-mcp@0.2.3"]
          env: {}
    # GitOps on top of the cicd preset's gitops-workflow skill. Reads
    # ARGOCD_BASE_URL and ARGOCD_API_TOKEN from the runtime env.
    argocd:
      mcp:
        argocd:
          command: bunx
          args: ["argocd-mcp@0.9.0", "stdio"]
          env: {}
    cicd:
      subagents: [deployment-engineer]
      skills:
        - wshobson/agents@github-actions-templates
        - wshobson/agents@gitlab-ci-patterns
        - wshobson/agents@gitops-workflow
        - openai/skills@gh-fix-ci
        - openai/skills@gh-address-comments
    database:
      subagents: [postgres-pro]
      plugins:
        - redis-development@claude-plugins-official
        - duckdb-skills@claude-plugins-official
      skills:
        - supabase/agent-skills@supabase-postgres-best-practices
        - wshobson/agents@sql-optimization-patterns
        - affaan-m/ecc@postgres-patterns
        - affaan-m/ecc@prisma-patterns
        - affaan-m/ecc@redis-patterns
      # Registered per project in Claude's local scope; connection inherited
      # from the runtime env (postgres: DATABASE_URI; mysql: MYSQL_*), so no
      # credential is stored. SQLite is omitted — it needs a per-project path.
      mcp:
        postgres:
          command: uvx
          args: ["postgres-mcp@0.3.0"]
          env: {}
        mysql:
          command: bunx
          args: ["@benborla29/mcp-server-mysql@2.0.9"]
          env: {}
    terragrunt:
      subagents: [terragrunt-expert]
      skills:
        - akin-ozer/cc-devops-skills@terragrunt-generator
        - akin-ozer/cc-devops-skills@terragrunt-validator
    ansible:
      subagents: [devops-engineer]
      skills:
        - akin-ozer/cc-devops-skills@ansible-validator
        - akin-ozer/cc-devops-skills@ansible-generator
    # Workers, Wrangler and Durable Objects, from Cloudflare's own skills repo.
    cloudflare:
      skills:
        - cloudflare/skills@cloudflare
        - cloudflare/skills@workers-best-practices
        - cloudflare/skills@wrangler
        - cloudflare/skills@durable-objects
    # Document databases sit apart from the SQL-focused database preset.
    mongodb:
      skills:
        - mongodb/agent-skills@mongodb-schema-design
        - mongodb/agent-skills@mongodb-query-optimizer
        - mongodb/agent-skills@mongodb-connection
  presets:
    # Cross-language domains with no single language/tool owner.
    testing:
      skills:
        - currents-dev/playwright-best-practices-skill@playwright-best-practices
        - wshobson/agents@e2e-testing-patterns
        - affaan-m/ecc@tdd-workflow
        - cypress-io/ai-toolkit@cypress-author
    # Skills-only: the 04-quality-security subagents stay in the global
    # baseline, so this opt-in collection does not duplicate them.
    security:
      subagents:
        - security-engineer
        - penetration-tester
        - compliance-auditor
        - gdpr-ccpa-compliance
        - ad-security-reviewer
        - powershell-security-hardening
      # Switched on in .claude/settings.local.json; off everywhere else.
      plugins:
        - appsec-skills@agent-sec-ops-kit-skills
        - compliance-skills@agent-sec-ops-kit-skills
        - devsecops-skills@agent-sec-ops-kit-skills
        - incident-response-skills@agent-sec-ops-kit-skills
        - offsec-skills@agent-sec-ops-kit-skills
        - secsdlc-skills@agent-sec-ops-kit-skills
        - threatmodel-skills@agent-sec-ops-kit-skills
        - secskills-core@secskills-marketplace
        - secskills-defense@secskills-marketplace
        - secskills-offense@secskills-marketplace
        - testing-handbook-skills@trailofbits
      skills:
        - openai/skills@security-threat-model
        - openai/skills@security-best-practices
        - wshobson/agents@stride-analysis-patterns
        - Eyadkelleh/awesome-skills-security@llm-testing
        - Eyadkelleh/awesome-skills-security@security-fuzzing
        - Eyadkelleh/awesome-skills-security@security-passwords
        - Eyadkelleh/awesome-skills-security@security-patterns
        - Eyadkelleh/awesome-skills-security@security-payloads
        - Eyadkelleh/awesome-skills-security@security-usernames
        - Eyadkelleh/awesome-skills-security@security-webshells
        - affaan-m/ecc@security-review
        - affaan-m/ecc@security-scan
        - wshobson/agents@attack-tree-construction
        - wshobson/agents@threat-mitigation-mapping
        - wshobson/agents@security-requirement-extraction
        - wshobson/agents@sast-configuration
        - wshobson/agents@pci-compliance
        - wshobson/agents@gdpr-data-handling
    # Notebooks, R and Quarto — the data-science filetypes nvim supports.
    datascience:
      subagents: [data-scientist]
      skills:
        - openai/skills@jupyter-notebook
        - posit-dev/skills@quarto-authoring
        - posit-dev/skills@r-tidyverse-style
    # Authoring: LaTeX, Typst, academic writing.
    docs:
      subagents: [technical-writer]
      skills:
        - bahayonghang/academic-writing-skills@latex-paper-en
        - lucifer1004/claude-skill-typst@typst
    # Product and market analysis: experiments, cohorts, competitors, trends.
    research:
      subagents:
        - ab-test-analysis
        - cohort-analysis
        - competitive-analyst
        - market-researcher
        - project-idea-validator
        - trend-analyst
        - scientific-literature-researcher
    # Shell scripting (bash, fish): defensive patterns, shellcheck, bats.
    shell:
      subagents: [cli-developer]
      skills:
        - wshobson/agents@bash-defensive-patterns
        - wshobson/agents@shellcheck-configuration
        - wshobson/agents@bats-testing-patterns
    # Perl (nvim supports it; no VoltAgent subagent, so skills-only).
    perl:
      skills:
        - affaan-m/ecc@perl-patterns
        - affaan-m/ecc@perl-security
        - affaan-m/ecc@perl-testing
    # Domain subagents split out of the global baseline (see global.subagents
    # exclude); opt in per project when the work needs them.
    desktop:
      subagents: [electron-pro]
    mobile:
      subagents: [mobile-developer]
      skills:
        - expo/skills@expo-native-ui
        - expo/skills@expo-router
        - expo/skills@expo-data-fetching
        - expo/skills@expo-upgrade
        - callstackincubator/agent-skills@react-native-best-practices
