        - wshobson/agents@multi-cloud-architecture
        - wshobson/agents@hybrid-cloud-networking
      mcp:
        aws-cost-explorer:
          command: uvx
          args: ["awslabs.cost-explorer-mcp-server@0.0.21"]
          env: {}
    # Distributed-system patterns beyond the baseline architecture skills.
    architecture:
      skills:
        - wshobson/agents@microservices-patterns
        - wshobson/agents@saga-orchestration
        - wshobson/agents@cqrs-implementation
        - wshobson/agents@event-store-design
        - wshobson/agents@projection-patterns
    # Business analysis and product ownership: PRDs, stories, roadmaps.
    # atlassian reads JIRA_* and CONFLUENCE_* from the runtime env.
    product:
      subagents:
        - business-analyst
        - product-manager
        - project-manager
        - scrum-master
        - ux-researcher
        - backlog-grooming
