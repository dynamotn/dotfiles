    # Code knowledge graph: codegraph_explore returns the source and call paths
    # a question needs in one call, which pays off on large repos (no bash
    # support). Needs `codegraph init` in the project; telemetry is off.
    codegraph:
      mcp:
        codegraph:
          command: bunx
          args: ["@colbymchenry/codegraph@1.6.2", "serve", "--mcp"]
          env: { CODEGRAPH_TELEMETRY: "0" }
    # Getting to know an unfamiliar repo. understand-anything builds a graph
    # with guided tours and a dashboard (Claude only; the first /understand
    # spends many tokens); archify draws source-backed interactive diagrams
    # (needs node).
    onboarding:
      plugins:
        - understand-anything@understand-anything
      skills:
        - tt-a1i/archify@archify
    # Spec-driven changes (propose, apply, archive under openspec/). The skills
    # drive the `openspec` CLI (dytoy openspec); run `openspec init` in the
    # project first. OPENSPEC_TELEMETRY=0 turns its usage stats off.
    openspec:
      skills:
{{- range list "explore" "propose" "new-change" "continue-change" "ff-change" "update-change" "apply-change" "verify-change" "sync-specs" "archive-change" "bulk-archive-change" "onboard" }}
        - Fission-AI/OpenSpec@openspec-{{ . }}
