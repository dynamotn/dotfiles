    go:
      subagents: [golang-pro]
      skills:
        - samber/cc-skills-golang@golang-code-style
        - samber/cc-skills-golang@golang-testing
        - samber/cc-skills-golang@golang-error-handling
        - samber/cc-skills-golang@golang-grpc
        - samber/cc-skills-golang@golang-security
    python:
      subagents: [python-pro]
      plugins:
        - modern-python@trailofbits
      skills:
        - mindrally/skills@fastapi-python
        - affaan-m/ecc@python-patterns
        - affaan-m/ecc@python-testing
    rust:
      subagents: [rust-engineer]
      skills:
        - apollographql/skills@rust-best-practices
        - affaan-m/ecc@rust-patterns
        - affaan-m/ecc@rust-testing
        - mohitmishra786/low-level-dev-skills@cargo-workflows
        - mohitmishra786/low-level-dev-skills@rust-async-internals
        - mohitmishra786/low-level-dev-skills@rust-build-times
        - mohitmishra786/low-level-dev-skills@rust-cross
        - mohitmishra786/low-level-dev-skills@rust-debugging
        - mohitmishra786/low-level-dev-skills@rust-ffi
        - mohitmishra786/low-level-dev-skills@rust-no-std
        - mohitmishra786/low-level-dev-skills@rust-profiling
        - mohitmishra786/low-level-dev-skills@rust-sanitizers-miri
        - mohitmishra786/low-level-dev-skills@rust-security
        - mohitmishra786/low-level-dev-skills@rust-unsafe
        - mohitmishra786/low-level-dev-skills@rustc-basics
    # Skills-only: no VoltAgent subagent for Zig.
    zig:
