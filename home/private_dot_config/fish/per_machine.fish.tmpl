{{- $secret := includeTemplate "machine/secret.tmpl" . | fromJson }}
{{- if eq .chezmoi.os "darwin" }}
fish_add_path -mpPg /opt/homebrew/opt/coreutils/libexec/gnubin
fish_add_path -mpPg /opt/homebrew/opt/findutils/libexec/gnubin
fish_add_path -mpPg /opt/homebrew/opt/gnu-tar/libexec/gnubin
fish_add_path -mpPg /opt/homebrew/opt/gnu-sed/libexec/gnubin
fish_add_path -mpPg /opt/homebrew/opt/gawk/libexec/gnubin
fish_add_path -mpPg /opt/homebrew/opt/gnu-indent/libexec/gnubin
fish_add_path -mpPg /opt/homebrew/opt/gnu-getopt/bin
fish_add_path -mpPg /opt/homebrew/opt/grep/libexec/gnubin

set -gx HOMEBREW_PREFIX "/opt/homebrew"
set -gx HOMEBREW_CELLAR "/opt/homebrew/Cellar"
set -gx HOMEBREW_REPOSITORY "/opt/homebrew"
{{- end }}

{{- if eq .chezmoi.os "linux" }}
if type -q manpath
    set -gx MANPATH (manpath -g)
end
{{- end }}

{{- if eq .chezmoi.os "android" }}
set -gx XDG_RUNTIME_DIR $PREFIX/tmp
{{- end }}

{{- if and (eq .place "home") (eq .kind "pc") }}
if fish_is_root_user
    builtin cd /etc
end
{{- end }}

{{- if eq .place "office" }}
set -gx NODE_TLS_REJECT_UNAUTHORIZED 0
set -gx GRPC_DEFAULT_SSL_ROOTS_FILE_PATH /etc/ssl/certs/ca-certificates.crt
set -gx REQUESTS_CA_BUNDLE /etc/ssl/certs/ca-certificates.crt
set -gx NODE_EXTRA_CA_CERTS /etc/ssl/certs/ca-certificates.crt
set -gx DENO_TLS_CA_STORE system
set -gx UV_SYSTEM_CERTS true
{{- end }}

{{- if eq .kind "container" }}
set -gx MISE_OFFLINE 1
{{- else if eq .kind "vdi" }}
set -gx MISE_PREFER_OFFLINE 1
{{- end }}

{{- if $secret.httpProxy }}

# The proxy follows the network: dynet rewrites proxy.fish on every network
# change, and every running shell picks it up at its next prompt
set -g __dynet_proxy_file $HOME/.local/state/dynet/proxy.fish
function __dynet_proxy --on-event fish_prompt
    test -r $__dynet_proxy_file; or return
    set -l mtime (path mtime $__dynet_proxy_file)
    test "$mtime" = "$__dynet_proxy_mtime"; and return
    set -g __dynet_proxy_mtime $mtime
    source $__dynet_proxy_file
end
__dynet_proxy
{{- end }}
