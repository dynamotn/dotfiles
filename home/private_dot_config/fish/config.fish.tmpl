# vim:foldmethod=marker:foldmarker={,}
## Some environment variables {
# Path of Fish config
set -gx CONFIG_PATH (dirname (readlink -f (status --current-filename)))

{{- if eq .chezmoi.os "linux" }}
# XDG base directories
set -gx XDG_CACHE_HOME $HOME/.cache
set -gx XDG_CONFIG_HOME $HOME/.config
set -gx XDG_DATA_HOME $HOME/.local/share
set -gx XDG_STATE_HOME $HOME/.local/state
{{-   if eq .osid "linux-gentoo" }}
set -gx XDG_RUNTIME_DIR /tmp/user-(id -u)
{{-   else }}
set -gx XDG_RUNTIME_DIR /run/user/(id -u)
{{-   end }}
{{- end }}

# GPG interface to insert passphrase
set -gx GPG_TTY (tty)

# GO workspace
set -gx GOPATH $HOME/.go

# PATH, highest precedence first
fish_add_path -mpPg \
    $HOME/.krew/bin \
    $HOME/.local/share/nvim/mason/bin \
    $HOME/.go/bin \
    $HOME/.cargo/bin \
    $HOME/.cache/.bun/bin \
    $HOME/.yarn/bin \
    $HOME/.fzf/bin \
    $HOME/.local/bin \
    /opt/homebrew/sbin \
    /opt/homebrew/bin

# MANPATH, once: a nested shell inherits it already prepended
if test -d $HOME/.local/man; and not contains -- $HOME/.local/man $MANPATH
    set -gxp MANPATH $HOME/.local/man
end

# Package manager
type -q brew; and brew shellenv | source
if command -sq mise
    set -gx MISE_PREFER_OFFLINE true
    mise activate fish | source
    command -sq usage; and mise completion fish | source
end

# Set default editor
abbr -a v vim
command -sq nvim; and begin
    set -gx EDITOR nvim
    set -gx MANPAGER 'nvim +Man!'
    # nvimpager execs nvim with argv[0] "nvimpager"; a mise shim resolves
    # the tool from argv[0] and would run nvimpager itself again.
    set -gx NVIMPAGER_NVIM (command -sa nvim | string match -v '*/mise/shims/*')[1]
    # Only at the prompt: a script calling `vim` means the real one
    if status is-interactive
        alias vim nvim
        alias vimdiff 'nvim -d'
        alias nvims 'NVIM_APPNAME=nvim-stable mise exec neovim@stable -- nvim'
    end
end
or begin
    set -gx EDITOR vim
    set -gx MANPAGER 'vim -M +MANPAGER -'
end
## }

## Fish or shell miscellaneous config {
# Enable vi key bindings
if test -n "$TERM"
    fish_vi_key_bindings
    # Cursor shape per mode, as in Neovim
    set -g fish_cursor_default block
    set -g fish_cursor_insert line
    set -g fish_cursor_replace_one underscore
    set -g fish_cursor_replace underscore
    set -g fish_cursor_visual block
end

# grc for color output
if type -q grc
    set -gx grcplugin_ls --color -Chl --group-directories-first
    set -gx grcplugin_df -H
end

# Color for Virtual console
if test "$TERM" = linux; and test -f $CONFIG_PATH/console_color
    for i in (sed -n "s/.*\*color\([0-9]\{1,\}\).*#\([0-9a-fA-F]\{6\}\).*/\1 \2/p" $CONFIG_PATH/console_color | awk '$1 < 16 {printf "\\\e]P%X%s", $1, $2}')
        echo -en "$i"
    end
    set -g theme_nerd_fonts no
end
## }

## Other tools {
if status is-interactive
    {{- $themeName := "macchiato" }}
    {{- $theme := .catppuccin.macchiato }}
    {{- if not .darkMode }}
    {{-   $themeName = "latte" }}
    {{-   $theme = .catppuccin.latte }}
    {{- end }}
    # Theme
    fish_config theme choose catppuccin-{{ $themeName }}
    {{- if not .darkMode }}
    set -gx canaudua_host_context_fg brwhite
    set -gx canaudua_pwd_bg white
    set -gx canaudua_pwd_fg black
    set -gx canaudua_git_fg brwhite
    {{- end }}
    # Glamour integrated tools
    set -gx GLAMOUR_STYLE "$HOME/.config/glamour/catppuccin.json"
    # Plugins
    set sponge_successful_exit_codes 0 127
    set sponge_purge_only_on_exit true
    # Vale
    set -gx VALE_CONFIG_PATH "$HOME/.config/vale.ini"
    set -gx VALE_STYLES_PATH "$HOME/.local/share/vale"
    # Gitlint
    set -gx GITLINT_CONFIG "$XDG_CONFIG_HOME/gitlint/gitlint"

    # Hooks
    # Fzf config
    # Set before __fzf_setup: it guards this with `set --query`, so naming
    # the previewer here is what keeps it off its own default. The `-c`
    # forces cat mode -- fzf hands the preview a pipe, and on a pipe
    # nvimpager execs plain cat and the colours are lost.
    type -q nvimpager; and set -gx FZF_PREVIEW_TEXT_FILE_CMD 'nvimpager -c'
    type -q __fzf_setup; and __fzf_setup
    set -gx FZF_COLOR_OPTS "\
        --color=bg+:{{ $theme.surface0 }},bg:{{ $theme.base }},spinner:{{ $theme.rosewater }},hl:{{ $theme.red}} \
        --color=fg:{{ $theme.text }},header:{{ $theme.red }},info:{{ $theme.mauve }},pointer:{{ $theme.rosewater }} \
        --color=marker:{{ $theme.lavender }},fg+:{{ $theme.text }},prompt:{{ $theme.mauve }},hl+:{{ $theme.red }} \
        --color=selected-bg:{{ $theme.surface1 }} \
        --color=border:{{ $theme.overlay0 }},label:{{ $theme.text }}"
    set -gx FZF_DEFAULT_OPTS "\
        $FZF_COLOR_OPTS \
        --cycle --layout=reverse --preview-window=wrap \
        --marker=\"*\" --prompt=\" \" --pointer=\"=>\""
    type -q tmux; and test -n "$TMUX"; and set -g FZF_TMUX 1
    if type -q fdfind
        alias fd fdfind
    end
    if type -q fd
        set -gx FZF_FIND_FILE_COMMAND "fd -Ht f -E .git . \$dir 2> /dev/null"
        set -gx FZF_CD_COMMAND "fd -t d . \$dir 2> /dev/null"
        set -gx FZF_CD_WITH_HIDDEN_COMMAND "fd -Ht d -E .git . \$dir 2> /dev/null"
    end

    # Navi
    type -q navi; and navi widget fish | source
    # Projekt
    if type -q projekt
        projekt init fish | source
    end
    # ov, as the pager of everything that takes one
    if type -q ov
        set -gx PAGER ov
        type -q psql; and set -gx PSQL_PAGER 'ov -F -C -d "|" -H1 --column-rainbow --align'
        type -q tspin; and set -gx TAILSPIN_PAGER 'ov -f [FILE]'
    end
    # Vivid
    type -q vivid; and set -gx LS_COLORS (vivid generate catppuccin-{{ $themeName }})
    # Zellij
    if type -q zellij
        set -gx ZELLIJ_AUTO_ATTACH true
        set -q SSH_TTY; and set -gx ZELLIJ_CONFIG_FILE $HOME/.config/zellij/ssh.kdl
    end

    # Completions of fd, projekt, t, b, ov, zellij, task, ltcc, rg, rbw,
    # limactl, gh and glab are generated by stubs in completions/, which fish
    # loads on first use: generating them here was two thirds of startup.
end
## }

## Load per-machine & secret config {
if test -e $HOME/.config/fish/per_machine.fish
    source $HOME/.config/fish/per_machine.fish
end
## }
