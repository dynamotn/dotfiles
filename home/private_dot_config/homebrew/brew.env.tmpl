# Homebrew fetches git-based casks (such as the Google fonts) inside a sandbox
# that forbids writing to /tmp, where the SSH ControlMaster socket lives. Use an
# SSH config without connection sharing instead. The path must be absolute:
# brew exports each line verbatim, without expanding `~`.
HOMEBREW_SSH_CONFIG_PATH={{ .chezmoi.homeDir }}/.config/homebrew/ssh_config
