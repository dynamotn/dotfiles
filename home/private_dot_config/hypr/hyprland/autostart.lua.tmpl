local app = require("hyprland.app")

-- Once, when Hyprland starts
hl.on("hyprland.start", function()
{{- $configHash := joinPath .chezmoi.sourceDir "private_dot_config/hypr/hyprland/plugins.list" | include | sha256sum }}
{{- if ne $configHash "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }}
  -- Plugin manager
  hl.exec_cmd("hyprpm reload -n && hyprctl reload")
{{- end }}

  -- Sound & Screencast
{{- if .hasSound }}
{{-   if eq .chezmoi.osRelease.id "gentoo" }}
  hl.exec_cmd("gentoo-pipewire-launcher restart")
{{-   else }}
  hl.exec_cmd("systemctl --user start wireplumber")
  hl.exec_cmd("systemctl --user start pipewire-pulse")
{{-   end }}
{{- end }}
  hl.exec_cmd("~/.config/hypr/hyprland/scripts/screencast.sh")

  -- Gtk theme
  hl.exec_cmd("~/.config/hypr/hyprland/scripts/gtk.sh")

  -- Desktop shell: bar, launcher, clipboard, notifications, OSD, wallpaper,
  -- idle, lock screen and the polkit agent
  hl.exec_cmd("noctalia")

  -- Screen changes detection
  hl.exec_cmd("shikane")

  -- IM
  hl.exec_cmd("fcitx5 -d --replace")

  -- Terminal
  hl.exec_cmd(app.terminal)

  -- Browser and email client
{{- if eq .place "home" }}
  hl.exec_cmd(app.browser .. " -P Personal")
  hl.exec_cmd(app.mail_client .. " -P Personal")
{{- else if eq .place "office" }}
  hl.exec_cmd(app.browser .. " -P Enterprise-{{ .company }}")
  hl.exec_cmd(app.mail_client .. " -P Enterprise-{{ .company }}")
{{- end }}

  -- Note-taking
  hl.exec_cmd("obsidian-app")

  -- Headless monitor
  hl.exec_cmd("hyprctl output create headless Wayvnc-1")
  hl.exec_cmd("wayvnc 0.0.0.0 1411 Wayvnc-1")
end)

-- On every load of this config, including the first: the screen shader
-- follows the time of day set in hyprshade.toml
hl.exec_cmd("hyprshade auto")
