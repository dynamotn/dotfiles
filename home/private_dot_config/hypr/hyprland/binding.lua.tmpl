{{- $rules := includeTemplate "wm/rules.yaml.tmpl" . | fromYaml }}
{{- /* What each action of the rules' bindings does on Hyprland: a dispatcher,
       or `exec <Lua string expression>` for a command. An action left out
       here is not bound */}}
{{- $actions := dict
  "quit" `hl.dsp.exit()`
  "reload" `exec "hyprctl reload"`
  "launcher" `exec "noctalia msg panel-toggle launcher"`
  "swap-monitors" `hl.dsp.workspace.swap_monitors({ monitor1 = 0, monitor2 = 1 })`
  "workspace-to-monitor-left" `hl.dsp.workspace.move({ monitor = "-1" })`
  "workspace-to-monitor-right" `hl.dsp.workspace.move({ monitor = "+1" })`
  "focus-left" `hl.dsp.focus({ direction = "left" })`
  "focus-right" `hl.dsp.focus({ direction = "right" })`
  "focus-up" `hl.dsp.focus({ direction = "up" })`
  "focus-down" `hl.dsp.focus({ direction = "down" })`
  "cycle-next" `hl.dsp.window.cycle_next()`
  "resize-left" `hl.dsp.window.resize({ x = -100, y = 0, relative = true })`
  "resize-right" `hl.dsp.window.resize({ x = 100, y = 0, relative = true })`
  "resize-up" `hl.dsp.window.resize({ x = 0, y = -100, relative = true })`
  "resize-down" `hl.dsp.window.resize({ x = 0, y = 100, relative = true })`
  "close" `hl.dsp.window.close()`
  "fullscreen" `hl.dsp.window.fullscreen()`
  "float" `hl.dsp.window.float({ action = "toggle" })`
  "layout" `hl.dsp.layout("togglesplit")`
  "group" `hl.dsp.group.toggle()`
  "swap" `hl.dsp.layout("swapnext")`
  "terminal" `exec app.terminal`
  "control-center" `exec "noctalia msg panel-toggle control-center"`
  "notification-dnd" `exec "noctalia msg notification-dnd-toggle"`
  "notification-latest" `exec "noctalia msg notification-invoke-latest"`
  "clipboard" `exec "noctalia msg panel-toggle clipboard"`
  "password" `exec "rbw-pick password"`
  "totp" `exec "rbw-pick totp"`
  "lock" `exec "noctalia msg session lock"`
  "screenshot" `exec "noctalia msg screenshot-region"`
  "system-monitor" `hl.dsp.workspace.toggle_special("monitor")`
  "brightness-up" `exec "dymonitor --notify brightness up"`
  "brightness-down" `exec "dymonitor --notify brightness down"`
  "contrast-up" `exec "dymonitor --notify contrast up"`
  "contrast-down" `exec "dymonitor --notify contrast down"`
  "volume-up" `exec "noctalia msg volume-up"`
  "volume-down" `exec "noctalia msg volume-down"`
  "mute" `exec "noctalia msg volume-mute"`
  "mic-mute" `exec "noctalia msg mic-mute"`
  "play-pause" `exec "playerctl play-pause"`
  "pause" `exec "playerctl pause"`
  "next" `exec "playerctl next"`
  "previous" `exec "playerctl previous"` }}
{{- with $rules.profiles.main }}
{{-   $_ := set $actions "browser" (printf `exec app.browser .. " -P %s"` .) }}
{{-   $_ := set $actions "mail" (printf `exec app.mail_client .. " -P %s"` .) }}
{{- end }}
{{- with $rules.profiles.other }}
{{-   $_ := set $actions "browser-other" (printf `exec app.browser .. " -P %s"` .) }}
{{-   $_ := set $actions "mail-other" (printf `exec app.mail_client .. " -P %s"` .) }}
{{- end }}
{{- $modifiers := dict "Mod" "SUPER" "Ctrl" "CTRL" "Alt" "ALT" "Shift" "SHIFT" }}
{{- $keys := dict "Left" "left" "Right" "right" "Up" "up" "Down" "down"
  "Period" "period" "Comma" "comma" "Slash" "slash" "Semicolon" "semicolon"
  "Apostrophe" "apostrophe" "Equal" "equal" "Minus" "minus" -}}
-- Generated from the bindings in home/.chezmoitemplates/wm/rules.yaml.tmpl,
-- shared with niri, aerospace and OmniWM (docs/key_bindings/hyprland.md)
local app = require("hyprland.app")

local mainMod = "SUPER"

local function exec(keys, cmd, opts)
  hl.bind(keys, hl.dsp.exec_cmd(cmd), opts)
end
{{  range $rules.bindings }}
{{-   if and (hasKey $actions .action) (ne (get . "os") "darwin") }}
{{-     $parts := splitList "+" .key }}
{{-     $chord := list }}
{{-     range initial $parts }}
{{-       $chord = append $chord (get $modifiers .) }}
{{-     end }}
{{-     $key := last $parts }}
{{-     $chord = append $chord (get $keys $key | default $key) }}
{{-     $options := list }}
{{-     if get . "locked" }}{{ $options = append $options "locked = true" }}{{ end }}
{{-     if eq (toString (get . "repeat")) "true" }}{{ $options = append $options "repeating = true" }}{{ end }}
{{-     $options := ternary "" (printf ", { %s }" (join ", " $options)) (empty $options) }}
{{-     $action := get $actions .action }}
{{-     if hasPrefix "exec " $action }}
exec("{{ join " + " $chord }}", {{ trimPrefix "exec " $action }}{{ $options }})
{{-     else }}
hl.bind("{{ join " + " $chord }}", {{ $action }}{{ $options }})
{{-     end }}
{{-   end }}
{{- end }}

-- Switch workspaces with mainMod + [0-9], move the active window there
-- without following it with mainMod + SHIFT + [0-9], in the order of the rules
{{- $workspaces := list }}
{{- range $rules.workspaces }}
{{-   $workspaces = append $workspaces (printf "\"%s\"" (includeTemplate "wm/workspace-name.tmpl" .)) }}
{{- end }}
local workspaces = { {{ join ", " $workspaces }} }
for i, name in ipairs(workspaces) do
  local key = tostring(i % 10)
  hl.bind(mainMod .. " + " .. key, hl.dsp.focus({ workspace = "name:" .. name }))
  hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = "name:" .. name, follow = false }))
end

-- Scroll through existing workspaces with mainMod + scroll
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize windows with mainMod + LMB/RMB and dragging
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Switch the input source of the external monitors with mainMod + ALT + [1-9]
{{- range $index, $input := $rules.monitorInputs }}
exec(mainMod .. " + ALT + {{ add $index 1 }}", "dymonitor --notify input {{ $input }}")
{{- end }}
