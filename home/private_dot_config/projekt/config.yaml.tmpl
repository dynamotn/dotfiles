{{- $machine := printf "%s_%s" .place .kind -}}
folders:
  - path: {{ .chezmoi.sourceDir }}/..
    name: "dot"
    is_workspace: false
    priority: 0
  - path: {{ .chezmoi.sourceDir }}/../secrets/data
    name: "dotsec"
    is_workspace: false
    priority: 0
  - path: {{ .chezmoi.sourceDir }}/../silos
    prefix: ""
    is_workspace: true
    regex: ""
    priority: 0
  - path: {{ .chezmoi.homeDir }}/Temp
    prefix: "tmp"
    is_workspace: true
    regex: ""
    priority: 0
  - path: {{ .chezmoi.homeDir }}/Working/community
    prefix: ""
    is_workspace: true
    regex: ""
    priority: 0
  - path: {{ .chezmoi.homeDir }}/Working/personal
    prefix: ""
    is_workspace: true
    regex: ""
    priority: 0
  - path: {{ .chezmoi.homeDir }}/Working/freelancer
    prefix: ""
    is_workspace: true
    regex: ""
    priority: 0
  - path: {{ .chezmoi.homeDir }}/Working/personal/fish
    prefix: "fish"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-config/fish-packages
      repos:
        - name: autopairs
          path: autopairs
        - name: canaudua
          path: canaudua
        - name: caran
          path: caran
        - name: fzf
          path: fzf
  - path: {{ .chezmoi.homeDir }}/Working/personal/vim
    prefix: "vim"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-config/vim-plugins
      repos:
        - name: blink-cmp-fuzzy-path
          path: blink-cmp-fuzzy-path
        - name: blink-cmp-kitty
          path: blink-cmp-kitty
        - name: blink-cmp-zellij
          path: blink-cmp-zellij
        - name: blink-cmp-tmux
          path: blink-cmp-tmux
  - path: {{ .chezmoi.homeDir }}/Working/personal/tools
    prefix: "tool"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-tools
      repos:
        - name: projekt
          path: projekt
        - name: datme
          path: datme
        - name: sh-docs
          path: sh-docs
        - name: dybatpho
          path: dybatpho
        - name: dyshellint
          path: dyshellint
        - name: foxsync
          path: foxsync
        - name: blackduck-tui
          path: blackduck-tui
        - name: dysyncal
          path: dysyncal
        - name: dye
          path: dye
  - path: {{ .chezmoi.homeDir }}/Working/personal/infra
    prefix: "infra"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-infra
      repos:
        - name: homeops
          path: homeops
        - name: terragrunt
          path: terragrunt
        - name: helm-charts
          path: helm-charts
  - path: {{ .chezmoi.homeDir }}/Working/personal/config
    prefix: "config"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-config
      repos:
        - name: projekt-templates
          path: projekt-templates
  - path: {{ .chezmoi.homeDir }}/Working/personal/obsidian
    prefix: "obsidian"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-brain/obsidian
      repos:
        - name: datme
          path: datme
        - name: lang-blocks
          path: lang-blocks
  - path: {{ .chezmoi.homeDir }}/Working/personal/games
    prefix: "game"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-games
      repos:
        - name: DreaMaker
          path: dreamaker
  - path: {{ .chezmoi.homeDir }}/Working/personal/misc
    prefix: "misc"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo.foss
      repos:
        - name: stars-collection
          path: stars-collection
        - name: action-awesome-list
          path: stars-action
        - name: Iosevka-Dynamo
          path: font
        - name: bash-coding-style
          path: bash-coding-style
        - name: tree-sitter-dbml
          path: tree-sitter-dbml
        - name: tree-sitter-yara-x
          path: tree-sitter-yara-x
  {{- if eq .kind "pc" "laptop" }}
  - path: {{ .chezmoi.homeDir }}/Working/personal/finance
    prefix: "finance"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-finance
      repos:
        - name: ledger
          path: ledger
        - name: paisa
          path: paisa
  - path: {{ .chezmoi.homeDir }}/Documents/Notes
    name: "notes"
    is_workspace: false
    priority: 0
  - path: {{ .chezmoi.homeDir }}/Documents/Notes/_assets/books
    prefix: "book"
    is_workspace: true
    regex: ""
    priority: 0
    git:
      host: gl
      group: dynamo-brain/books
      repos:
        - name: self-development
          path: self-development
  {{- end }}
  {{- $top := . }}
  {{- range .decryptEnterprise }}
  {{-   $projektSecret := printf "../secrets/data/enterprise-%s/projekt.yaml.age" . | joinPath $.chezmoi.sourceDir | include | decrypt | fromYaml }}
  {{-   range $projektSecret.folders }}
  {{-     $folder := . }}
  - {{-   $folder | toYaml | replaceAllRegex "\\$HOME" $top.chezmoi.homeDir | nindent 4 }}
  {{-   end }}
  {{- end }}
gitServers:
  {{- if .decryptPersonal }}
  {{-   $gitSecret := print "../secrets/data/personal/git.yaml.age" | joinPath $.chezmoi.sourceDir | include | decrypt | fromYaml }}
  {{-   range $gitSecret.servers }}
  - name: {{ .name | quote }}
    type: {{ .type | quote }}
    https: {{ .https | trimSuffix "/" | quote }}
    ssh: {{ .ssh | trimSuffix "/" | trimSuffix ":" | quote }}
    preferGitSSH: {{ .preferGitSSH }}
  {{-   end }}
  {{- end }}
  {{- range .decryptEnterprise }}
  {{-   $gitSecret := printf "../secrets/data/enterprise-%s/git.yaml.age" . | joinPath $.chezmoi.sourceDir | include | decrypt | fromYaml }}
  {{-   range $gitSecret.servers }}
  - name: {{ .name | quote }}
    type: {{ .type | quote }}
    https: {{ .https | trimSuffix "/" | quote }}
    ssh: {{ .ssh | trimSuffix "/" | trimSuffix ":" | quote }}
    preferGitSSH: {{ .preferGitSSH }}
  {{-   end }}
  {{- end }}
