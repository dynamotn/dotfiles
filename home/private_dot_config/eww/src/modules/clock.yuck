;; Clock — the hour above the minute, since the bar is vertical.
(defpoll clock_hour :interval "10s" :initial "00" "date '+%H'")
(defpoll clock_minute :interval "10s" :initial "00" "date '+%M'")
(defpoll clock_date :interval "1h" :initial "" "date '+%A, %d %B %Y'")

(defwidget clock []
  (eventbox
    :tooltip clock_date
    :cursor "pointer"
    (button
      :class "module clock"
      :onclick "~/.config/eww/scripts/popup.sh toggle calendar"
      (box
        :orientation "v"
        :space-evenly false
        (label :class "hour" :text clock_hour)
        (label :class "minute" :text clock_minute)))))
