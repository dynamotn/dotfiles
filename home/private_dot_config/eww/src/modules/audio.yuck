;; Audio — the default sink. Click opens the panel, right click mutes, scroll
;; changes the volume. The script reprints on PulseAudio events, so nothing
;; polls.
(deflisten audio
  :initial '{"volume":0,"muted":false,"icon":"󰝟","description":"","source":{"volume":0,"muted":false,"icon":"󰍬","description":""},"sinks":[]}'
  "scripts/audio.sh")

(defwidget audio [monitor]
  (eventbox
    :cursor "pointer"
    :tooltip "${audio.description} — ${audio.volume}%"
    ;; eww substitutes `up` or `down` for {}, which is not what wpctl wants.
    :onscroll "s=+; [ '{}' = down ] && s=-; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%$s"
    (box
      :class "module audio ${audio.muted ? 'muted' : ''}"
      :orientation "v"
      :space-evenly false
      (button
        :class "icon"
        :onclick "~/.config/eww/scripts/panel.sh open audio ${monitor}"
        :onrightclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        {audio.icon})
      (label
        :class "value"
        :visible {!audio.muted}
        :text "${audio.volume}"))))
