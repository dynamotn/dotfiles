;; Media — the active MPRIS player. The title is rotated, because the bar is
;; only wide enough for an icon. Click opens the panel, right click plays or
;; pauses, scroll skips.
(deflisten mpris
  :initial '{"active":false,"status":"Stopped","icon":"󰝛","title":"","artist":"","album":"","player":"","art":"","shuffle":false,"loop":"None"}'
  "scripts/mpris.sh")

(defwidget mpris [monitor]
  (eventbox
    :visible {mpris.active}
    :cursor "pointer"
    :tooltip {mpris.artist != "" ? "${mpris.artist} — ${mpris.title}" : mpris.title}
    ;; eww substitutes `up` or `down` for {}, which is not a playerctl command.
    :onscroll "[ '{}' = up ] && playerctl next || playerctl previous"
    (box
      :class "module mpris ${mpris.status == 'Playing' ? 'playing' : 'paused'}"
      :orientation "v"
      :space-evenly false
      :spacing 4
      (button
        :class "icon"
        :onclick "~/.config/eww/scripts/panel.sh open media ${monitor}"
        :onrightclick "playerctl play-pause"
        {mpris.icon})
      (label
        :class "title"
        :angle 270
        :limit-width 18
        :text {mpris.title}))))
