;; Workspaces — one button per persistent workspace of this monitor.
;;
;; The payload is keyed by monitor name, so a bar window keeps reading its own
;; output even when shikane reorders the monitors or wayvnc adds a headless one.
(deflisten workspaces
  :initial "{}"
  "scripts/workspaces.py")

(defwidget workspaces [monitor]
  (box
    :class "module workspaces"
    :orientation "v"
    :space-evenly false
    (for workspace in {workspaces[monitor].all ?: []}
      (eventbox
        :cursor "pointer"
        :halign "center"
        :valign "center"
        :vexpand true
        :tooltip {workspace.name}
        (button
          :onclick "hyprctl dispatch workspace ${workspace.name}"
          :class "workspace ${workspace.id == workspaces[monitor].active ? 'active' : (workspace.windows > 0 ? 'occupied' : 'empty')}"
          (label
            :class "name"
            :text {workspace.icon}
            :justify "center"))))))
