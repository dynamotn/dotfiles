;; Network — the connection NetworkManager routes through. Click opens the
;; panel; the script reprints on every NetworkManager event.
(deflisten network
  :initial '{"type":"none","name":"Disconnected","icon":"󰤭","state":"unknown","signal":0,"device":"","address":"","wifi_enabled":false,"connections":[]}'
  "scripts/network.sh")

(defwidget network [monitor]
  (eventbox
    :cursor "pointer"
    :tooltip {network.type == "wifi"
      ? "${network.name} — ${network.signal}%"
      : network.name}
    (box
      :class "module network ${network.type == 'none' ? 'offline' : ''}"
      :orientation "v"
      :space-evenly false
      (button
        :class "icon"
        :onclick "~/.config/eww/scripts/panel.sh open network ${monitor}"
        {network.icon}))))
