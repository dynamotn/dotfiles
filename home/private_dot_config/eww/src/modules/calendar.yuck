;; Calendar — the Thunderbird calendar, read out of its own database.
;;
;; The month grids come ready made from the script: eww has no date arithmetic,
;; so the weeks, the days either side of the month and the event counts are all
;; worked out there. Paging months is an offset into that list, and selecting a
;; day is a key into the events map.
;;
;; eww only runs a variable's command while a window using it is open, so this
;; costs nothing until the calendar or the idle screen is on screen.
(deflisten calendar
  :initial '{"days":{},"months":[],"current":0,"today":"","weekdays":[]}'
  "scripts/agenda.py --watch")

;; How far the shown month is from the one holding today.
(defvar calendar_offset 0)
;; The day whose events are listed; empty means today.
(defvar calendar_selected "")

(defwidget calendar_month []
  (box
    :class "calendar_month"
    :orientation "v"
    :space-evenly false
    :spacing 6
    (box
      :class "head"
      :space-evenly false
      (button
        :class "page"
        :onclick "eww update calendar_offset=${calendar_offset - 1}"
        "󰅁")
      (label
        :class "label"
        :hexpand true
        :text {arraylength(calendar.months) > 0
          ? calendar.months[calendar.current + calendar_offset].label
          : ""})
      (button
        :class "page"
        :onclick "eww update calendar_offset=${calendar_offset + 1}"
        "󰅂"))
    (box
      :class "weekdays"
      (for name in {calendar.weekdays}
        (label :class "weekday" :text name)))
    (box
      :class "weeks"
      :orientation "v"
      :space-evenly false
      :spacing 2
      (for week in {arraylength(calendar.months) > 0
        ? calendar.months[calendar.current + calendar_offset].weeks
        : []}
        (box
          :spacing 2
          (for cell in week
            (eventbox
              :cursor "pointer"
              (button
                :class "day ${cell.today ? 'today' : ''} ${cell.in_month ? '' : 'outside'} ${cell.count > 0 ? 'busy' : ''}"
                :onclick "eww update calendar_selected='${cell.date}'"
                :tooltip {cell.count > 1 ? "${cell.count} events" : (cell.count == 1 ? "1 event" : cell.date)}
                (box
                  :orientation "v"
                  :space-evenly false
                  (label :class "number" :text {cell.day})
                  (label
                    :class "dot"
                    :visible {cell.count > 0}
                    :text "•"))))))))))

;; A single entry in the day's list, shared by the window and the idle screen.
(defwidget calendar_entry [event]
  (box
    :class "entry ${event.all_day ? 'all_day' : ''}"
    :space-evenly false
    :spacing 10
    (label
      :class "clock"
      :text {event.all_day ? "All day" : event.clock}
      :valign "start")
    (box
      :orientation "v"
      :space-evenly false
      :hexpand true
      (label
        :class "title"
        :text {event.title}
        :halign "start"
        :wrap true
        :limit-width 42)
      (label
        :class "where"
        :visible {event.location != ""}
        :text {event.location}
        :halign "start"
        :limit-width 42))))

(defwidget calendar_agenda [day]
  (box
    :class "calendar_agenda"
    :orientation "v"
    :space-evenly false
    :spacing 6
    (label
      :class "empty"
      :visible {arraylength(calendar.days[day] ?: []) == 0}
      :text "Nothing scheduled")
    (for event in {calendar.days[day] ?: []}
      (calendar_entry :event event))))
