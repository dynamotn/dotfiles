;; The calendar, opened by the clock on the bar.

(defwidget calendar_window [monitor]
  (box
    :class "calendar_window"
    :orientation "v"
    :space-evenly false
    :spacing 12
    (box
      :class "head"
      :space-evenly false
      (label :class "title" :text "Calendar" :halign "start")
      (button
        :class "toggle"
        :halign "end"
        :hexpand true
        :visible {calendar_offset != 0 || calendar_selected != ""}
        :tooltip "Back to today"
        :onclick "eww update calendar_offset=0 && eww update calendar_selected=''"
        "󰃭")
      (button
        :class "toggle close"
        :tooltip "Close"
        :onclick "~/.config/eww/scripts/popup.sh close calendar"
        "󰅖"))
    (calendar_month)
    (label
      :class "agenda_day"
      :halign "start"
      :text {calendar_selected != "" ? calendar_selected : calendar.today})
    (scroll
      :class "agenda"
      :height {metrics[monitor].panel_list ?: 240}
      :vscroll true
      (calendar_agenda
        :day {calendar_selected != "" ? calendar_selected : calendar.today}))))

(defwindow calendar [monitor]
  :monitor monitor
  :stacking "overlay"
  :exclusive false
  :focusable true
  :geometry (geometry :x "5%" :width "26%" :anchor "center left")
  (calendar_window :monitor monitor))
