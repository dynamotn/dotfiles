;; The vertical bar, one window per monitor.
;;
;; `monitor` is the Hyprland output *name*, not an index: scripts/monitors.sh
;; passes it on open and reopens the window when the output set changes.

(defwidget bar_start [monitor]
  (box
    :class "bar_start"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :valign "start"
    :spacing 15
    (launcher)
    (workspaces :monitor monitor)))

(defwidget bar_center [monitor]
  (box
    :class "bar_center"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :valign "center"
    :spacing 10
    (mpris :monitor monitor)
    (pomodoro)))

(defwidget bar_end [monitor]
  (box
    :class "bar_end"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :valign "end"
    :spacing 10
    (tray)
    (box
      :class "module status"
      :orientation "v"
      :space-evenly false
      :spacing 8
      (audio :monitor monitor)
      (network :monitor monitor)
      (battery :monitor monitor)
      (notifications))
    (clock)))

(defwidget bar [monitor]
  (box
    :class "bar"
    :orientation "v"
    (bar_start :monitor monitor)
    (bar_center :monitor monitor)
    (bar_end :monitor monitor)))

(defwindow bar [monitor]
  :monitor monitor
  :stacking "fg"
  :exclusive true
  ;; The contents decide the width, from `$bar-font` and the `em` sizes built on
  ;; it. A geometry percentage would be a share of the *logical* width, which
  ;; reads a monitor scaled down to 0.8 as a larger screen and widens the bar
  ;; for it. This is only a floor.
  :geometry (geometry :width "40px" :height "100%" :anchor "center left")
  (bar :monitor monitor))
