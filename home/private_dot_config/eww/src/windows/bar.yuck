;; The vertical bar, one window per monitor.
;;
;; `monitor` is the Hyprland output *name*, not an index: scripts/monitors.sh
;; passes it on open and reopens the window when the output set changes.

(defwidget bar_start [monitor]
  (box
    :class "bar_start"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :valign "start"
    :spacing 15
    (launcher)
    (workspaces :monitor monitor)))

(defwidget bar_center []
  (box
    :class "bar_center"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :valign "center"
    :spacing 10
    (mpris)
    (pomodoro)))

(defwidget bar_end []
  (box
    :class "bar_end"
    :orientation "v"
    :space-evenly false
    :halign "center"
    :valign "end"
    :spacing 10
    (tray)
    (box
      :class "module status"
      :orientation "v"
      :space-evenly false
      :spacing 8
      (audio)
      (network)
      (battery))
    (clock)))

(defwidget bar [monitor]
  (box
    :class "bar"
    :orientation "v"
    (bar_start :monitor monitor)
    (bar_center)
    (bar_end)))

(defwindow bar [monitor]
  :monitor monitor
  :stacking "fg"
  :exclusive true
  :geometry (geometry :width 50 :height "100%" :anchor "center left")
  (bar :monitor monitor))
