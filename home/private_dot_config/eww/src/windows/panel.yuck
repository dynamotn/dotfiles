;; The detail panel, opened beside the bar by scripts/panel.sh.
;;
;; One panel exists at a time; `panel_section` says which part it shows, and
;; the window carries the monitor name so the tabs can switch section in place.
;; Clicking a bar module only ever opens or switches — the close button in the
;; tab row is what dismisses the panel.

(defvar panel_section "audio")

;; Audio ----------------------------------------------------------------------

(defwidget panel_audio []
  (box
    :class "section audio"
    :orientation "v"
    :space-evenly false
    :spacing 12
    (box
      :class "headline"
      :space-evenly false
      :spacing 10
      (label :class "glyph" :text {audio.icon})
      (label :class "name" :text {audio.description} :limit-width 28 :halign "start")
      (button
        :class "toggle ${audio.muted ? 'off' : 'on'}"
        :halign "end"
        :hexpand true
        :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        {audio.muted ? "Unmute" : "Mute"}))
    (box
      :space-evenly false
      :spacing 10
      (label :class "value" :text "${audio.volume}%")
      (scale
        :class "slider"
        :hexpand true
        :value {audio.volume > 100 ? 100 : audio.volume}
        :min 0
        :max 101
        :onchange "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ {}%"))
    (box
      :class "headline"
      :space-evenly false
      :spacing 10
      (label :class "glyph" :text {audio.source.icon})
      (label :class "name" :text {audio.source.description} :limit-width 28 :halign "start")
      (button
        :class "toggle ${audio.source.muted ? 'off' : 'on'}"
        :halign "end"
        :hexpand true
        :onclick "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        {audio.source.muted ? "Unmute" : "Mute"}))
    (box
      :space-evenly false
      :spacing 10
      (label :class "value" :text "${audio.source.volume}%")
      (scale
        :class "slider"
        :hexpand true
        :value {audio.source.volume > 100 ? 100 : audio.source.volume}
        :min 0
        :max 101
        :onchange "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ {}%"))
    (label :class "caption" :text "Output" :halign "start")
    (box
      :class "list"
      :orientation "v"
      :space-evenly false
      (for sink in {audio.sinks}
        (button
          :class "row ${sink.default ? 'active' : ''}"
          :onclick "pactl set-default-sink '${sink.name}'"
          (box
            :space-evenly false
            :spacing 8
            (label :class "mark" :text {sink.default ? "󰄬" : "󰄰"})
            (label :class "label" :text {sink.description} :limit-width 32 :halign "start")))))
    (button
      :class "action"
      :onclick "kitty --class pulsemixer pulsemixer &"
      "Open mixer")))

;; Network --------------------------------------------------------------------

(defwidget panel_network [monitor]
  (box
    :class "section network"
    :orientation "v"
    :space-evenly false
    :spacing 12
    (box
      :class "headline"
      :space-evenly false
      :spacing 10
      (label :class "glyph" :text {network.icon})
      (label :class "name" :text {network.name} :limit-width 24 :halign "start")
      (button
        :class "toggle ${network.wifi_enabled ? 'on' : 'off'}"
        :halign "end"
        :hexpand true
        :onclick "nmcli radio wifi ${network.wifi_enabled ? 'off' : 'on'}"
        {network.wifi_enabled ? "Wi-Fi on" : "Wi-Fi off"}))
    (box
      :class "facts"
      :orientation "v"
      :space-evenly false
      (box :space-evenly false
        (label :class "key" :text "Interface" :halign "start")
        (label :class "fact" :text {network.device != "" ? network.device : "—"} :halign "end" :hexpand true))
      (box :space-evenly false
        (label :class "key" :text "Address" :halign "start")
        (label :class "fact" :text {network.address} :halign "end" :hexpand true))
      (box :space-evenly false
        :visible {network.type == "wifi"}
        (label :class "key" :text "Signal" :halign "start")
        (label :class "fact" :text "${network.signal}%" :halign "end" :hexpand true)))
    (label :class "caption" :text "Connections" :halign "start")
    (scroll
      :class "list"
      :height {metrics[monitor].panel_list ?: 180}
      :vscroll true
      (box
        :orientation "v"
        :space-evenly false
        (for connection in {network.connections}
          (button
            :class "row ${connection.active ? 'active' : ''}"
            ;; Acting on the UUID, because a name can carry a quote.
            :onclick {connection.active
              ? "nmcli connection down uuid ${connection.uuid}"
              : "nmcli connection up uuid ${connection.uuid}"}
            (box
              :space-evenly false
              :spacing 8
              (label :class "mark" :text {connection.active ? "󰄬" : "󰄰"})
              (label :class "label" :text {connection.name} :limit-width 28 :halign "start"))))))
    (button
      :class "action"
      :onclick "kitty --class nmtui nmtui &"
      "Open network manager")))

;; Battery --------------------------------------------------------------------

(defwidget panel_battery []
  (box
    :class "section battery"
    :orientation "v"
    :space-evenly false
    :spacing 12
    (box
      :class "headline"
      :space-evenly false
      :spacing 10
      (label :class "glyph ${battery.level}" :text {battery.icon})
      (label :class "name" :text "${battery.capacity}%")
      (label :class "state" :text {battery.status} :halign "end" :hexpand true))
    (box
      :class "facts"
      :orientation "v"
      :space-evenly false
      (box :space-evenly false
        :visible {battery.time != ""}
        (label :class "key" :text "Remaining" :halign "start")
        (label :class "fact" :text {battery.time} :halign "end" :hexpand true))
      (box :space-evenly false
        (label :class "key" :text "Draw" :halign "start")
        (label :class "fact" :text "${battery.power} W" :halign "end" :hexpand true))
      (box :space-evenly false
        (label :class "key" :text "Health" :halign "start")
        (label :class "fact" :text "${battery.health}%" :halign "end" :hexpand true))
      (box :space-evenly false
        (label :class "key" :text "Cycles" :halign "start")
        (label :class "fact" :text "${battery.cycles}" :halign "end" :hexpand true))
      (box :space-evenly false
        (label :class "key" :text "Model" :halign "start")
        (label :class "fact" :text {battery.model} :halign "end" :hexpand true)))
    (button
      :class "action"
      :onclick "kitty --class btop btop &"
      "Open monitor")))

;; Media ----------------------------------------------------------------------

(defwidget panel_media []
  (box
    :class "section media"
    :orientation "v"
    :space-evenly false
    :spacing 12
    (box
      :class "empty"
      :visible {!mpris.active}
      (label :text "Nothing is playing"))
    (box
      :orientation "v"
      :space-evenly false
      :spacing 12
      :visible {mpris.active}
      (box
        :class "cover"
        :visible {matches(mpris.art, "^file://")}
        (image
          :path {replace(mpris.art, "^file://", "")}
          :image-width 220
          :image-height 220))
      (box
        :class "track"
        :orientation "v"
        :space-evenly false
        (label :class "title" :text {mpris.title} :limit-width 34 :wrap false)
        (label :class "artist" :text {mpris.artist} :limit-width 34)
        (label :class "album" :text {mpris.album} :limit-width 34))
      (box
        :class "controls"
        :halign "center"
        :space-evenly false
        :spacing 18
        (button
          :class "control ${mpris.shuffle ? 'on' : ''}"
          :onclick "playerctl shuffle toggle"
          "󰒝")
        (button :class "control" :onclick "playerctl previous" "󰒮")
        (button :class "control play" :onclick "playerctl play-pause" {mpris.icon})
        (button :class "control" :onclick "playerctl next" "󰒭")
        (button
          :class "control ${mpris.loop != 'None' ? 'on' : ''}"
          :onclick "playerctl loop ${mpris.loop == 'None' ? 'Playlist' : (mpris.loop == 'Playlist' ? 'Track' : 'None')}"
          {mpris.loop == "Track" ? "󰑘" : "󰑖"}))
      (label :class "player" :text {mpris.player}))))

;; Shell ----------------------------------------------------------------------

(defwidget panel_tab [section glyph monitor]
  (button
    :class "tab ${panel_section == section ? 'active' : ''}"
    :onclick "~/.config/eww/scripts/panel.sh open ${section} ${monitor}"
    glyph))

(defwidget panel [monitor]
  (box
    :class "panel"
    :orientation "v"
    :space-evenly false
    :spacing 12
    (box
      :class "tabs"
      :space-evenly false
      :spacing 6
      (box
        :spacing 6
        :hexpand true
        (panel_tab :section "audio" :glyph "󰕾" :monitor monitor)
        (panel_tab :section "network" :glyph "󰤨" :monitor monitor)
        (panel_tab :section "battery" :glyph "󰁹" :monitor monitor)
        (panel_tab :section "media" :glyph "󰝚" :monitor monitor))
      (button
        :class "close"
        :tooltip "Close"
        :onclick "~/.config/eww/scripts/panel.sh close"
        "󰅖"))
    (stack
      :selected {panel_section == "audio" ? 0
        : (panel_section == "network" ? 1
        : (panel_section == "battery" ? 2 : 3))}
      :transition "crossfade"
      :same-size false
      (panel_audio)
      (panel_network :monitor monitor)
      (panel_battery)
      (panel_media))))

(defwindow panel [monitor]
  :monitor monitor
  :stacking "overlay"
  :exclusive false
  :focusable true
  :geometry (geometry :x "5%" :width "22%" :anchor "center left")
  (panel :monitor monitor))
