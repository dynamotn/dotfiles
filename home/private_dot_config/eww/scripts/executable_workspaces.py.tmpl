#!/usr/bin/env python
"""Stream the Hyprland workspace state for the eww bar.

The payload is an object keyed by monitor *name* rather than by index, so a
bar window keeps reading the right output even when shikane reorders the
monitors or wayvnc adds a headless one at runtime.

The workspace names, their order and their icons come from
`home/.chezmoitemplates/wm/rules.yaml.tmpl`, the same source Hyprland's own
`workspace.conf` is generated from.
"""

import json
import os
import subprocess
import sys

{{- $rules := includeTemplate "wm/rules.yaml.tmpl" . | fromYaml }}

ICONS = {
{{- range $rules.workspaces }}
    "{{ .name }}": "{{ .icon }}",
{{- end }}
}

ORDER = [
{{- range $rules.workspaces }}
    "{{ .name }}",
{{- end }}
]


def hyprctl(*args):
    """Return the parsed JSON output of a hyprctl query."""
    return json.loads(subprocess.check_output(["hyprctl", *args, "-j"]))


def event_socket():
    """Return the path of the Hyprland event socket for this instance."""
    signature = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
    uid = os.getuid()
    candidates = [
        os.environ.get("XDG_RUNTIME_DIR"),
        f"/run/user/{uid}",
        f"/tmp/user-{uid}",
        f"/tmp/user/{uid}",
    ]
    for runtime in candidates:
        if not runtime:
            continue
        socket = f"{runtime}/hypr/{signature}/.socket2.sock"
        if os.path.exists(socket):
            return socket
    raise RuntimeError("no Hyprland event socket found")


def rank(workspace):
    """Sort persistent workspaces in their declared order, the rest by id."""
    try:
        return (0, ORDER.index(workspace["name"]))
    except ValueError:
        return (1, workspace["id"])


def workspaces_of(monitor, workspaces):
    """Return the workspaces of one monitor, ordered, without the special ones."""
    return [
        {
            "id": workspace["id"],
            "name": workspace["name"],
            "windows": workspace["windows"],
            "icon": ICONS.get(workspace["name"], workspace["name"]),
        }
        for workspace in sorted(workspaces, key=rank)
        if workspace["monitorID"] == monitor["id"]
        and not workspace["name"].startswith("special:")
    ]


def show_result():
    """Print the current state of every monitor as a single JSON line."""
    workspaces = hyprctl("workspaces")
    result = {
        monitor["name"]: {
            "all": workspaces_of(monitor, workspaces),
            "active": monitor["activeWorkspace"]["id"],
            "focused": monitor["focused"],
        }
        for monitor in hyprctl("monitors")
    }
    sys.stdout.write(json.dumps(result) + "\n")
    sys.stdout.flush()


def main():
    show_result()
    with subprocess.Popen(
        ["nc", "-U", event_socket()], stdout=subprocess.PIPE, text=True
    ) as process:
        for _ in process.stdout:
            show_result()


if __name__ == "__main__":
    main()
