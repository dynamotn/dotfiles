#!/usr/bin/env bash
# @file workspaces.sh
# @brief Stream the Hyprland workspace state for the eww bar
# @description Print the workspaces of every monitor as one JSON line, keyed by
# monitor *name* rather than by index, so a bar window keeps reading its own
# output even when shikane reorders the monitors or wayvnc adds a headless one.
# Reprint on every Hyprland event rather than polling.
#
# The names, their order and their icons come from
# `home/.chezmoitemplates/wm/rules.yaml.tmpl`, the same source Hyprland's own
# `workspace.conf` is generated from.
set -euo pipefail

{{- $rules := includeTemplate "wm/rules.yaml.tmpl" . | fromYaml }}
{{- $icons := dict }}
{{- $rank := dict }}
{{- range $index, $workspace := $rules.workspaces }}
{{-   $icons = set $icons $workspace.name $workspace.icon }}
{{-   $rank = set $rank $workspace.name $index }}
{{- end }}

readonly CONFIG="${HOME}/.config/eww"
readonly SCRIPTS="${CONFIG}/scripts"
# Pretty printed so no line runs long; yq reads the newlines as whitespace.
readonly ICON_MAP='{{ $icons | toPrettyJson }}'
readonly RANK_MAP='{{ $rank | toPrettyJson }}'

# The query that turns the two hyprctl payloads into the bar's shape.
# dyshellint disable=SC2016 the $ names are yq variables, not shell expansions
readonly PROGRAM='env(ICONS) as $icons
  | env(RANK) as $rank
  | env(WORKSPACES) as $workspaces
  | env(MONITORS)
  | map(
      . as $monitor
      | {
          "key": $monitor.name,
          "value": {
            "all": (
              $workspaces
              | map(select(.monitorID == $monitor.id))
              | map(select(.name | test("^special:") | not))
              | sort_by($rank[.name] // 999, .id)
              | map({
                  "id": .id,
                  "name": .name,
                  "windows": .windows,
                  "icon": ($icons[.name] // .name)
                })
            ),
            "active": $monitor.activeWorkspace.id,
            "focused": $monitor.focused
          }
        }
    )
  | from_entries
'

# @description Print the state of every monitor as one JSON object.
# @noargs
# @stdout One JSON object.
function _emit {
  local workspaces monitors

  # A reconfiguration can make hyprctl fail mid-flight; an empty list keeps the
  # listener alive and the next event redraws the bar.
  workspaces="$(hyprctl workspaces -j 2> /dev/null || printf '%s\n' '[]')"
  monitors="$(hyprctl monitors -j 2> /dev/null || printf '%s\n' '[]')"

  ICONS="${ICON_MAP}" RANK="${RANK_MAP}" \
    WORKSPACES="${workspaces}" MONITORS="${monitors}" \
    yq -n -o json -I 0 "${PROGRAM}"
}

# @description Print the state once, then on every Hyprland event.
# @noargs
# @stdout One JSON object per line.
function _main {
  _emit
  while read -r _; do
    _emit
  done < <(nc -U "$("${SCRIPTS}/hypr_socket.sh")")
}

_main "$@"
