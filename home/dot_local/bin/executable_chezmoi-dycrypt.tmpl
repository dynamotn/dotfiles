#!{{ .bash }}
# @file chezmoi-dycrypt
# @brief Decrypt and encrypt secrets data in chezmoi dotfiles with single custom identity
# @description The CLI only parses options and resolves paths; the age calls and
# the chezmoi source path rules live in `scripts/lib/dycrypt.sh` and
# `scripts/lib/chezmoi_attrs.sh`, where they can be tested without rendering
# this template.
DYCRYPT_DOTFILES_DIR="{{ .chezmoi.sourceDir }}/.."
. "${DYCRYPT_DOTFILES_DIR}/scripts/lib/dybatpho/init.sh" --modules cli array
. "${DYCRYPT_DOTFILES_DIR}/scripts/lib/chezmoi_attrs.sh"
. "${DYCRYPT_DOTFILES_DIR}/scripts/lib/dycrypt.sh"
dybatpho::register_common_handlers

#######################################
# @description Options both commands share, declared once as persistent so the
# subcommands inherit them instead of restating them
#######################################
function _spec_common {
  dybatpho::opts::param "Log level" LOG_LEVEL --log-level -l init:="info" \
    validate:"dybatpho::validate_log_level \$OPTARG" persistent:true
  dybatpho::opts::flag "Dry run" DRY_RUN --dry-run -D on:true off:false init:="false" persistent:true
  dybatpho::opts::param "Identity type" IDENTITY_TYPE --identity-type -i init:="personal" \
    validate:"dycrypt::validate_identity \$OPTARG" persistent:true
  dybatpho::opts::param \
    "Folder of the plain file, default is \`data\` for the \`secrets/data\` store in dotfiles folder" \
    FOLDER --folder -f init:="data" persistent:true
  dybatpho::opts::param "List of attributes for chezmoi source file, separate by \`,\`" \
    ATTRIBUTES --attributes -a init:="" \
    validate:"chezmoi_attrs::validate \$OPTARG" persistent:true
  dybatpho::opts::flag "Run even when the output file is already up to date" FORCE --force -F \
    on:true off:false init:="false" persistent:true
}

#######################################
# @description Spec of chezmoi-dycrypt
#######################################
function _spec_main {
  _spec_common
  dybatpho::opts::setup "Utilities to work with my secrets data" MAIN_ARGS
  dybatpho::opts::cmd decrypt _spec_decrypt
  dybatpho::opts::cmd encrypt _spec_encrypt
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_main"
}

#######################################
# @description Spec of decrypt command
#######################################
function _spec_decrypt {
  dybatpho::opts::setup "Decrypt secrets data" DECRYPT_ARGS action:"_decrypt \"\${DECRYPT_ARGS[@]}\""
  dybatpho::opts::arg "Name of the file to decrypt" FILENAME
  dybatpho::opts::disp "Show help" --help action:"dybatpho::generate_help _spec_decrypt"
}

#######################################
# @description Spec of encrypt command
#######################################
function _spec_encrypt {
  dybatpho::opts::setup "Encrypt secrets data and target file in your home/root folder" ENCRYPT_ARGS action:"_encrypt \"\${ENCRYPT_ARGS[@]}\""
  dybatpho::opts::arg "Name of the file to encrypt" FILENAME
  dybatpho::opts::flag "Remove source file after encryption" REMOVE --remove -r \
    on:true off:false init:="false"
  dybatpho::opts::disp "Show help" --help action:"dybatpho::generate_help _spec_encrypt"
}

#######################################
# @description Encrypt file with single custom identity
# @arg $1 string Name of file to encrypt
#######################################
function _encrypt {
  local filename
  dybatpho::expect_args filename -- "$@"
  local plain cipher
  dycrypt::resolve_paths plain cipher "${IDENTITY_TYPE}" "${filename}" "${FOLDER}" "${ATTRIBUTES}"
  dycrypt::encrypt "${IDENTITY_TYPE}" "${plain}" "${cipher}" "${FORCE}" "${REMOVE}"
}

#######################################
# @description Decrypt file with single custom identity
# @arg $1 string Name of file to decrypt
#######################################
function _decrypt {
  local filename
  dybatpho::expect_args filename -- "$@"
  local plain cipher
  dycrypt::resolve_paths plain cipher "${IDENTITY_TYPE}" "${filename}" "${FOLDER}" "${ATTRIBUTES}"
  dycrypt::decrypt "${IDENTITY_TYPE}" "${cipher}" "${plain}" "${FORCE}"
}

dybatpho::generate_from_spec _spec_main "$@"
