#!{{ .bash }}
# @file dyai-lsp-exec
# @brief Trust-gated launcher for every agent-facing language-server command
# @description Runs dyai-lsp-exec from the dotfiles' dyai submodule, with the
# dotfiles' dybatpho. It execs into the real server, so stdio passes through.
export DYBATPHO_DIR="{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho"
exec {{ .bash }} "{{ .chezmoi.sourceDir }}/../scripts/lib/dyai/bin/dyai-lsp-exec" "$@"
