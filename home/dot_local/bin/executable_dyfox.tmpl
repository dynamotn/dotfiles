#!{{ .bash }}
# @file dyfox
# @brief Update/Refresh your live data of firefox/zen browser to/from your dotfiles
# @description Only the list of files this browser keeps lives here; walking the
# profiles, reading `prefs.js` and handing files to chezmoi is shared with
# `dybird` in `scripts/lib/mozilla_profile.sh`.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh --modules cli array
. {{ .chezmoi.sourceDir }}/../scripts/lib/mozilla_profile.sh
dybatpho::register_common_handlers

{{- if .browser }}
{{-   $appName := "" }}
{{-   $settings := includeTemplate "firefox/settings.yaml.tmpl" . | fromYaml }}
{{-   $process := printf "%s/%s" $settings.installFolder $settings.processFile }}
{{-   if eq .browser "F" }}
{{-     $appName = "firefox" }}
{{-   else if eq .browser "Z" }}
{{-     $appName = "zen" }}
{{-   end }}
{{-   $profiles := list "public" }}
{{-   if .decryptPersonal }}
{{-     $profiles = append $profiles "personal" }}
{{-   end }}
{{-   range .browserEnterpriseProfiles }}
{{-     $profiles = append $profiles (printf "enterprise-%s" .) }}
{{-   end }}

# The library reads the profile layout from these, so shellcheck sees no use of
# them in this file.
# shellcheck disable=SC2034
declare MOZILLA_APP_NAME="{{ $appName }}" \
  MOZILLA_APP_KIND="web browser" \
  MOZILLA_PROCESS="{{ $process }}" \
  MOZILLA_PROFILE_ROOT="${HOME}/.config/firefox/profiles" \
  MOZILLA_TEMPLATE_ROOT="{{ .chezmoi.sourceDir }}/.chezmoitemplates/firefox/prefs"
# shellcheck disable=SC2034
declare -a MOZILLA_PROFILES=({{ range $profiles }}{{ . | quote }} {{ end }})

#######################################
# @description Update current live data of one profile to dotfiles
# @arg $1 string Profile
#######################################
function _update_profile {
  local profile
  dybatpho::expect_args profile -- "$@"
  local profile_dir prefs_file prefs_dir storage_dir
  profile_dir="$(mozilla::profile_dir "${profile}")"
  prefs_file="$(dybatpho::path_join "$profile_dir" "prefs.js")"
  prefs_dir="$(mozilla::prefs_template_dir "${profile}")"
  storage_dir="$(dybatpho::path_join "$profile_dir" "storage" "default")"

  if dybatpho::is file "$prefs_file"; then
    dybatpho::progress "Update toolbar setting for profile ${profile}"
    mozilla::extract_prefs "$prefs_dir/01-toolbar.js" "$prefs_file" \
      "browser.uiCustomization.state"

    dybatpho::progress "Update addon setting for profile ${profile}"
    mozilla::extract_prefs "$prefs_dir/02-extensions.js" "$prefs_file" \
      "extensions.webextensions.uuids" \
      "extensions.webextensions.ExtensionStorageIDB.migrated" \
      "privacy.userContext.extension"
  fi

  dybatpho::progress "Update containers for profile ${profile}"
  mozilla::add "$profile_dir" "containers.json"

  dybatpho::progress "Update extensions data for profile ${profile}"
  mozilla::add "$profile_dir" \
    "addons.json" "addonStartup.json.lz4" "extensions.json" "extension-preferences.json"

  dybatpho::progress "Update search engines for profile ${profile}"
  mozilla::add "$profile_dir" "search.json.mozlz4"

  dybatpho::progress "Update bookmarks, history and workspaces for profile ${profile}"
  mozilla::store "${profile}" "$profile_dir" "favicons.sqlite" "places.sqlite"

  dybatpho::progress "Update storage data for profile ${profile}"
  mozilla::store "${profile}" "$profile_dir" "storage.sqlite"
  if [ "${profile}" = "public" ]; then
    mozilla::add "$storage_dir" "moz-extension+++*"
  else
    mozilla::store_tree "${profile}" "$storage_dir" -path "*/moz-extension+++*"
  fi

  if dybatpho::is true "${COOKIES}"; then
    dybatpho::progress "Update cookies for profile ${profile}"
    mozilla::store "${profile}" "$profile_dir" "cookies.sqlite"
  fi

  {{ if eq .browser "Z" -}}
  dybatpho::progress "Update Zen customization for profile ${profile}"
  mozilla::add "$profile_dir" "zen-themes.json" "zen-keyboard-shortcuts.json"
  {{- end }}
}

#######################################
# @description Spec of dyfox cli
#######################################
function _spec_main {
  dybatpho::opts::setup "Update/Refresh your live data of {{ $appName }} browser to/from your dotfiles" MAIN_ARGS action:"mozilla::run _update_profile"
  dybatpho::opts::param "Log level" LOG_LEVEL --log-level -l init:="info" validate:"dybatpho::validate_log_level \$OPTARG"
  dybatpho::opts::flag "Dry run" DRY_RUN --dry-run -D on:true off:false init:="false"
  dybatpho::opts::param "Profile code" PROFILE --profile -p validate:"mozilla::validate_profile \$OPTARG"
  dybatpho::opts::flag "Refresh from scratch live data" REFRESH --refresh -r on:true off:false init:="false"
  dybatpho::opts::flag "Include cookies" COOKIES --cookies --no-cookies -c on:true off:false init:="true"
  dybatpho::opts::disp "Show help" --help action:"dybatpho::generate_help _spec_main"
}

dybatpho::generate_from_spec _spec_main "$@"
{{- end }}
