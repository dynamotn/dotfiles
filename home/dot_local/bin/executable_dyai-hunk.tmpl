#!{{ .bash }}
# @file dyai-hunk
# @brief Stop hook shared by every AI agent: show its changes side by side in hunk
# @description Runs dyai-hunk from the dotfiles' dyai submodule, with the
# dotfiles' dybatpho.
export DYBATPHO_DIR="{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho"
exec {{ .bash }} "{{ .chezmoi.sourceDir }}/../scripts/lib/dyai/bin/dyai-hunk" "$@"
