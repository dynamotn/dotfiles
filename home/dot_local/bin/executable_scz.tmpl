#!{{ .bash }}
# @file scz
# @brief Run chezmoi as root over the system files of the dotfiles
# @description Run chezmoi with `/` as its destination and `root/` as its
# source, elevated, while keeping the caller's `PATH` and `HOME` so the user
# configuration is the one read. Every argument is handed on to chezmoi.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh --modules privilege
dybatpho::register_common_handlers

dotfiles_root="$(dybatpho::path_join "{{ .chezmoi.sourceDir }}" "..")"
dotfiles="$(dybatpho::path_normalize "${dotfiles_root}")"
chezmoi_config="$(dybatpho::path_join "${HOME}" ".config" "chezmoi" "chezmoi.yaml")"
{{- if eq .chezmoi.os "darwin" }}
if dybatpho::string_contains "$*" "/Applications"; then
  dybatpho::file_replace "${chezmoi_config}" '^# \(umask:\)' '\1'
fi
{{- end }}
env_args=(env
  "PATH=${PATH}"
  "HOME=${HOME}"
)
# Templates that read secrets call rbw, which reaches the caller's unlocked
# agent through its socket under XDG_RUNTIME_DIR. Without it, root starts a
# locked agent of its own and prompts for the master password over the diff.
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  env_args+=("XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}")
fi
chezmoi_args=(chezmoi --destination /
  --source "${dotfiles}/root"
  --mode file
  --working-tree "${dotfiles}"
  --config "${chezmoi_config}"
)
dybatpho::privilege_run -- "${env_args[@]}" "${chezmoi_args[@]}" "$@"
{{- if eq .chezmoi.os "linux" }}

# chezmoi writes every target through a temporary file, so on SELinux a file
# it creates keeps the label of the temporary directory (user_tmp_t) rather
# than the one its path should have. Relabel the managed targets after a
# write; restorecon leaves correct labels alone and skips missing paths.
writes=false
for arg in "$@"; do
  case "${arg}" in
    apply | update) writes=true ;;
    *) ;;
  esac
done
if dybatpho::is true "${writes}" && dybatpho::is command selinuxenabled \
  && selinuxenabled; then
  managed="$(dybatpho::privilege_run -- "${env_args[@]}" \
    "${chezmoi_args[@]}" managed --path-style absolute \
    --include files,dirs,symlinks)"
  targets=()
  [[ -n "${managed}" ]] && readarray -t targets <<< "${managed}"
  if ((${#targets[@]} > 0)); then
    dybatpho::privilege_run -- restorecon -i "${targets[@]}"
  fi
fi
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
if dybatpho::string_contains "$*" "/Applications"; then
  dybatpho::file_replace "${chezmoi_config}" '^\(umask:\)' '# \1'
fi
{{- end }}
