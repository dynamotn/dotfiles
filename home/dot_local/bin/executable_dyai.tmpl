#!{{ .bash }}
# @file dyai
# @brief Run dyai from the dotfiles' submodule with the dotfiles' dybatpho
# @description dyai lives in scripts/lib/dyai (gitlab.com/dynamo-tools/dyai);
# this wrapper only shares the dybatpho the dotfiles already vendor with it.
export DYBATPHO_DIR="{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho"
exec {{ .bash }} "{{ .chezmoi.sourceDir }}/../scripts/lib/dyai/bin/dyai" "$@"
