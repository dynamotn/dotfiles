#!{{ .bash }}
# @file dyai
# @brief Manage AI-agent extensions (skills, MCP, subagents, plugins) like mise does tools
# @description `dyai install` brings every supported AI agent in line with the
# global config `~/.config/dyai/config.yaml`; `dyai use <name>` (later) opts a
# project into a registry preset. The global install logic lives in
# `scripts/lib/dyai.sh`, shared with the setup hook. `dyai run`, `review`,
# `fix`, `merge` and friends drive headless agent CLIs in their own worktrees
# (`scripts/lib/dyai_crew.sh`).
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh" --modules cli
dybatpho::register_common_handlers
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dyai.sh"

#######################################
# @description Spec of dyai
# @noargs
#######################################
function _spec_main {
  dybatpho::opts::setup "Manage AI-agent extensions across every agent" MAIN_ARGS
  dybatpho::opts::cmd install _spec_install
  dybatpho::opts::cmd use _spec_use
  dybatpho::opts::cmd ls _spec_ls
  dybatpho::opts::cmd rm _spec_rm
  dybatpho::opts::cmd mcp _spec_mcp
  dybatpho::opts::cmd status _spec_status
  dybatpho::opts::cmd enforcement _spec_enforcement
  dybatpho::opts::cmd run _spec_run
  dybatpho::opts::cmd tasks _spec_tasks
  dybatpho::opts::cmd review _spec_review
  dybatpho::opts::cmd fix _spec_fix
  dybatpho::opts::cmd merge _spec_merge
  dybatpho::opts::cmd drop _spec_drop
  dybatpho::opts::cmd logs _spec_logs
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_main"
}

#######################################
# @description Spec of install command
# @noargs
#######################################
function _spec_install {
  dybatpho::opts::setup "Apply the global config to every installed agent" INSTALL_ARGS action:"_install"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_install"
}

#######################################
# @description Spec of use command
# @noargs
#######################################
function _spec_use {
  dybatpho::opts::setup "Opt this project into a registry preset" USE_ARGS action:"_use"
  dybatpho::opts::arg "Preset name (language, infra, or preset)" PRESET required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_use"
}

#######################################
# @description Spec of ls command
# @noargs
#######################################
function _spec_ls {
  dybatpho::opts::setup "List the global baseline and this project's presets" LS_ARGS action:"_ls"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_ls"
}

#######################################
# @description Spec of rm command
# @noargs
#######################################
function _spec_rm {
  dybatpho::opts::setup "Remove a preset from this project" RM_ARGS action:"_rm"
  dybatpho::opts::arg "Preset name" PRESET required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_rm"
}

#######################################
# @description Spec of mcp command
# @noargs
#######################################
function _spec_mcp {
  dybatpho::opts::setup "Serve ls, use and rm to agents as an MCP server on stdio" MCP_ARGS action:"_mcp"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_mcp"
}

#######################################
# @description Spec of status command
# @noargs
#######################################
function _spec_status {
  dybatpho::opts::setup "Report drift between the config and what each agent has" STATUS_ARGS action:"_status"
  dybatpho::opts::flag "Print nothing when every agent matches" QUIET --quiet -q on:true off:false init:="false"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_status"
}

#######################################
# @description Report drift between the config and the installed agents
# @noargs
#######################################
# dyshellint disable=SC2154 QUIET is assigned by dybatpho::opts from _spec_status
function _status {
  dyai_status::main "${QUIET}"
}

#######################################
# @description Spec of enforcement command
# @noargs
#######################################
function _spec_enforcement {
  dybatpho::opts::setup "Show what each agent actually enforces of the shared config" ENF_ARGS action:"dyai::enforcement"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_enforcement"
}

#######################################
# @description Spec of run command
# @noargs
#######################################
function _spec_run {
  dybatpho::opts::setup "Run a task on a headless agent in its own worktree" RUN_ARGS action:"_run"
  dybatpho::opts::param "Agent: claude, codex, gemini, opencode, copilot, or auto" AGENT --agent -a init:="auto"
  dybatpho::opts::param "Plan file the agent must follow" PLAN --plan -p init:=""
  dybatpho::opts::flag "Return at once; follow it with dyai tasks" DETACH --detach -d on:true off:false init:="false"
  dybatpho::opts::arg "The task, or - to read it from stdin" PROMPT required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_run"
}

#######################################
# @description Spec of tasks command
# @noargs
#######################################
function _spec_tasks {
  dybatpho::opts::setup "List the crew tasks of this repository" TASKS_ARGS action:"dyai_crew::list"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_tasks"
}

#######################################
# @description Spec of review command
# @noargs
#######################################
function _spec_review {
  dybatpho::opts::setup "Review a task's change with another provider, read-only" REVIEW_ARGS action:"_review"
  dybatpho::opts::param "Reviewer agent (default: global.crew.reviewer)" BY --by -b init:=""
  dybatpho::opts::flag "Return at once; the verdict lands in dyai tasks" DETACH --detach -d \
    on:true off:false init:="false"
  dybatpho::opts::arg "Task id" ID required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_review"
}

#######################################
# @description Spec of fix command
# @noargs
#######################################
function _spec_fix {
  dybatpho::opts::setup "Run the writer again on a failed review" FIX_ARGS action:"_fix"
  dybatpho::opts::flag "Return at once" DETACH --detach -d on:true off:false init:="false"
  dybatpho::opts::arg "Task id" ID required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_fix"
}

#######################################
# @description Spec of merge command
# @noargs
#######################################
function _spec_merge {
  dybatpho::opts::setup "Merge a reviewed task into the current branch" MERGE_ARGS action:"_merge"
  dybatpho::opts::arg "Task id" ID required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_merge"
}

#######################################
# @description Spec of drop command
# @noargs
#######################################
function _spec_drop {
  dybatpho::opts::setup "Remove tasks' worktrees and merged branches" DROP_ARGS action:"_drop"
  dybatpho::opts::flag "Every finished task that was not merged" FINISHED --finished on:true off:false init:="false"
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_drop"
}

#######################################
# @description Spec of logs command
# @noargs
#######################################
function _spec_logs {
  dybatpho::opts::setup "Print a task's agent output" LOGS_ARGS action:"_logs"
  dybatpho::opts::flag "Keep following it" FOLLOW --follow -f on:true off:false init:="false"
  dybatpho::opts::flag "Print stderr instead of stdout" ERR --err on:true off:false init:="false"
  dybatpho::opts::arg "Task id" ID required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_logs"
}

#######################################
# @description Run the global install
# @noargs
#######################################
function _install {
  dybatpho::header "Setup AI"
  dyai::install
  dybatpho::success "Setup AI"
}

#######################################
# @description Per-project preset selection (coming in a later phase)
# @noargs
#######################################
function _use {
  dyai::use "${PRESET}"
}

#######################################
# @description List the global baseline and this project's presets
# @noargs
#######################################
function _ls {
  dyai::ls
}

#######################################
# @description Remove a preset from this project
# @noargs
#######################################
function _rm {
  dyai::rm "${PRESET}"
}

#######################################
# @description Serve the preset commands over MCP until stdin closes
# @noargs
#######################################
function _mcp {
  dyai_mcp::serve
}

#######################################
# @description Run a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 AGENT, PLAN, DETACH and PROMPT are assigned by dybatpho::opts from _spec_run
function _run {
  local prompt="${PROMPT-}"
  [[ "${prompt}" != - ]] || prompt="$(cat)"
  [[ -n "${prompt}" ]] || dybatpho::die "dyai run needs a task: dyai run \"<task>\""
  local mode=""
  [[ "${DETACH}" != true ]] || mode=detach
  dyai_crew::run "${AGENT}" "${prompt}" "${PLAN}" "${mode}"
}

#######################################
# @description Review a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 ID, BY and DETACH are assigned by dybatpho::opts from _spec_review
function _review {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai review needs a task id; see dyai tasks"
  local mode=""
  [[ "${DETACH}" != true ]] || mode=detach
  dyai_crew::review "${ID}" "${BY}" "${mode}"
}

#######################################
# @description Fix a crew task after a failed review
# @noargs
#######################################
# dyshellint disable=SC2154 ID and DETACH are assigned by dybatpho::opts from _spec_fix
function _fix {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai fix needs a task id; see dyai tasks"
  local mode=""
  [[ "${DETACH}" != true ]] || mode=detach
  dyai_crew::fix "${ID}" "${mode}"
}

#######################################
# @description Merge a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 ID is assigned by dybatpho::opts from _spec_merge
function _merge {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai merge needs a task id; see dyai tasks"
  dyai_crew::merge "${ID}"
}

#######################################
# @description Drop crew tasks
# @noargs
#######################################
# dyshellint disable=SC2154 FINISHED and DROP_ARGS are assigned by dybatpho::opts from _spec_drop
function _drop {
  if [[ "${FINISHED}" == true ]]; then
    dyai_crew::drop finished
  else
    ((${#DROP_ARGS[@]} > 0)) || dybatpho::die "dyai drop needs task ids, or --finished"
    dyai_crew::drop "${DROP_ARGS[@]}"
  fi
}

#######################################
# @description Print a crew task's agent output
# @noargs
#######################################
# dyshellint disable=SC2154 ID, FOLLOW and ERR are assigned by dybatpho::opts from _spec_logs
function _logs {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai logs needs a task id; see dyai tasks"
  local dir file
  dir="$(dyai_crew::state_dir)"
  file="${dir}/${ID}.out"
  [[ "${ERR}" != true ]] || file="${dir}/${ID}.err"
  dybatpho::is file "${file}" || dybatpho::die "no log for ${ID}: ${file}"
  if [[ "${FOLLOW}" == true ]]; then
    tail -n +1 -f -- "${file}"
  else
    tail -n +1 -- "${file}"
  fi
}

dybatpho::generate_from_spec _spec_main "$@"
