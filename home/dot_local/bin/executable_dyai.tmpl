  dybatpho::opts::param "Agent: claude, codex, gemini, opencode, copilot, or auto" AGENT --agent -a init:="auto"
  dybatpho::opts::param "Plan file the agent must follow" PLAN --plan -p init:=""
  dybatpho::opts::flag "Return at once; follow it with dyai tasks" DETACH --detach -d on:true off:false init:="false"
  dybatpho::opts::arg "The task, or - to read it from stdin" PROMPT required:false
  dybatpho::opts::disp "Show help" --help -h action:"dybatpho::generate_help _spec_run"
}

