# @noargs
#######################################
function _mcp {
  dyai_mcp::serve
}

#######################################
# @description Run a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 AGENT, PLAN, DETACH and PROMPT are assigned by dybatpho::opts from _spec_run
function _run {
  local prompt="${PROMPT-}"
  [[ "${prompt}" != - ]] || prompt="$(cat)"
  [[ -n "${prompt}" ]] || dybatpho::die "dyai run needs a task: dyai run \"<task>\""
  local mode=""
  [[ "${DETACH}" != true ]] || mode=detach
  dyai_crew::run "${AGENT}" "${prompt}" "${PLAN}" "${mode}"
}

#######################################
# @description Review a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 ID, BY and DETACH are assigned by dybatpho::opts from _spec_review
function _review {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai review needs a task id; see dyai tasks"
  local mode=""
  [[ "${DETACH}" != true ]] || mode=detach
  dyai_crew::review "${ID}" "${BY}" "${mode}"
}

#######################################
# @description Fix a crew task after a failed review
# @noargs
#######################################
# dyshellint disable=SC2154 ID and DETACH are assigned by dybatpho::opts from _spec_fix
function _fix {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai fix needs a task id; see dyai tasks"
  local mode=""
  [[ "${DETACH}" != true ]] || mode=detach
  dyai_crew::fix "${ID}" "${mode}"
}

#######################################
# @description Judge a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 ID is assigned by dybatpho::opts from _spec_judge
function _judge {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai judge needs a task id; see dyai tasks"
  dyai_crew::judge "${ID}"
}

#######################################
# @description Merge a crew task
# @noargs
#######################################
# dyshellint disable=SC2154 ID is assigned by dybatpho::opts from _spec_merge
function _merge {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai merge needs a task id; see dyai tasks"
  dyai_crew::merge "${ID}"
}

#######################################
# @description Drop crew tasks
# @noargs
#######################################
# dyshellint disable=SC2154 FINISHED and DROP_ARGS are assigned by dybatpho::opts from _spec_drop
function _drop {
  if [[ "${FINISHED}" == true ]]; then
    dyai_crew::drop finished
  else
    ((${#DROP_ARGS[@]} > 0)) || dybatpho::die "dyai drop needs task ids, or --finished"
    dyai_crew::drop "${DROP_ARGS[@]}"
  fi
}

#######################################
# @description Print a crew task's agent output
# @noargs
#######################################
# dyshellint disable=SC2154 ID, FOLLOW and ERR are assigned by dybatpho::opts from _spec_logs
function _logs {
  [[ -n "${ID-}" ]] || dybatpho::die "dyai logs needs a task id; see dyai tasks"
  local dir file
  dir="$(dyai_crew::state_dir)"
  file="${dir}/${ID}.out"
  [[ "${ERR}" != true ]] || file="${dir}/${ID}.err"
  dybatpho::is file "${file}" || dybatpho::die "no log for ${ID}: ${file}"
  local state status pid start
  state="$(dyai_crew::get "${ID}")" || state='{}'
  status="$(jq -r '.status // ""' <<< "${state}")"
  pid="$(jq -r '.pid // ""' <<< "${state}")"
  start="$(jq -r '.pid_start // ""' <<< "${state}")"
  # Follow only a live agent, and stop with it: a log pane must not outlive its task.
  # shellcheck disable=SC2310 # a plain yes/no
  if [[ "${FOLLOW}" == true && "${status}" == running ]] && dyai_crew::alive "${pid}" "${start}"; then
    tail -n +1 -f --pid="${pid}" -- "${file}"
  else
    tail -n +1 -- "${file}"
  fi
}

#######################################
# @description Prove the shared policy on the named agents, or on every installed one
# @noargs
#######################################
# dyshellint disable=SC2154 SELFTEST_ARGS is assigned by dybatpho::opts from _spec_selftest
function _selftest {
  local -a agents=("${SELFTEST_ARGS[@]}")
  local name rc=0
  if ((${#agents[@]} == 0)); then
    for name in claude codex gemini opencode copilot; do
      ! dybatpho::is command "${name}" || agents+=("${name}")
    done
  fi
  for name in "${agents[@]}"; do
    dyai_crew::selftest "${name}" || rc=1
  done
  return "${rc}"
}

#######################################
# @description Run the eval cases
# @noargs
#######################################
# dyshellint disable=SC2154 AGENT and EVAL_ARGS are assigned by dybatpho::opts from _spec_eval
function _eval {
  dyai_crew::eval "${AGENT}" "${EVAL_ARGS[@]}"
}

#######################################
# @description Update the global skills
# @noargs
#######################################
# dyshellint disable=SC2154 CHECK is assigned by dybatpho::opts from _spec_update
function _update {
  dyai::paths
  local mode=apply
  [[ "${CHECK}" != true ]] || mode=check
  dyai::skills_update "${mode}"
}

dybatpho::generate_from_spec _spec_main "$@"
