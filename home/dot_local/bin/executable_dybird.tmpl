#!{{ .bash }}
# @file dybird
# @brief Update/Refresh your live data of thundebird/betterbird mail client to/from your dotfiles
# @description Only the list of files this mail client keeps lives here; walking
# the profiles, reading `prefs.js` and handing files to chezmoi is shared with
# `dyfox` in `scripts/lib/mozilla_profile.sh`.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh --modules cli array
. {{ .chezmoi.sourceDir }}/../scripts/lib/mozilla_profile.sh
dybatpho::register_common_handlers

{{- if .mailClient }}
{{-   $appName := "" }}
{{-   $settings := includeTemplate "thunderbird/settings.yaml.tmpl" . | fromYaml }}
{{-   $process := printf "%s/%s" $settings.installFolder $settings.processFile }}
{{-   if eq .mailClient "T" }}
{{-     $appName = "thunderbird" }}
{{-   else if eq .mailClient "B" }}
{{-     $appName = "betterbird" }}
{{-   end }}
{{-   $profiles := list "public" }}
{{-   if .decryptPersonal }}
{{-     $profiles = append $profiles "personal" }}
{{-   end }}
{{-   range .mailEnterpriseProfiles }}
{{-     $profiles = append $profiles (printf "enterprise-%s" .) }}
{{-   end }}

# The library reads the profile layout from these, so shellcheck sees no use of
# them in this file.
# shellcheck disable=SC2034
declare MOZILLA_APP_NAME="{{ $appName }}" \
  MOZILLA_APP_KIND="email client" \
  MOZILLA_PROCESS="{{ $process }}" \
  MOZILLA_PROFILE_ROOT="${HOME}/.config/thunderbird/profiles" \
  MOZILLA_TEMPLATE_ROOT="{{ .chezmoi.sourceDir }}/.chezmoitemplates/thunderbird/prefs"
# shellcheck disable=SC2034
declare -a MOZILLA_PROFILES=({{ range $profiles }}{{ . | quote }} {{ end }})

#######################################
# @description Update current live data of one profile to dotfiles
# @arg $1 string Profile
#######################################
function _update_profile {
  local profile
  dybatpho::expect_args profile -- "$@"
  local profile_dir prefs_file prefs_dir storage_dir
  profile_dir="$(mozilla::profile_dir "${profile}")"
  prefs_file="$(dybatpho::path_join "$profile_dir" "prefs.js")"
  prefs_dir="$(mozilla::prefs_template_dir "${profile}")"
  storage_dir="$(dybatpho::path_join "$profile_dir" "storage" "default")"

  if dybatpho::is file "$prefs_file"; then
    dybatpho::progress "Update addon setting for profile ${profile}"
    mozilla::extract_prefs "$prefs_dir/02-extensions.js" "$prefs_file" \
      "extensions.webextensions.uuids" \
      "extensions.webextensions.ExtensionStorageIDB.migrated" \
      "privacy.userContext.extension"

    dybatpho::progress "Update email setting for profile ${profile}"
    mozilla::extract_prefs "$prefs_dir/03-email.js.tmpl" "$prefs_file" \
      "mail.account" "mail.server.server" "mail.identity.id" \
      "mail.smtpserver.smtp" "mail.smtpservers"

    dybatpho::progress "Update address book setting for profile ${profile}"
    mozilla::extract_prefs "$prefs_dir/04-address-book.js.tmpl" "$prefs_file" \
      "ldap_2.servers"

    dybatpho::progress "Update calendar setting for profile ${profile}"
    mozilla::extract_prefs "$prefs_dir/05-calendar.js.tmpl" "$prefs_file" \
      "calendar.list.sortOrder" "calendar.registry"
  fi

  dybatpho::progress "Update extensions data for profile ${profile}"
  mozilla::add "$profile_dir" \
    "addons.json" "addonStartup.json.lz4" "extensions.json" "extension-preferences.json"
  if [[ "${profile}" =~ enterprise-.* ]]; then
    mozilla::add "$(dybatpho::path_join "$profile_dir" "TbSync")" "account*.json" "folder*.json"
  fi

  dybatpho::progress "Update search engines for profile ${profile}"
  mozilla::add "$profile_dir" "search.json.mozlz4"

  dybatpho::progress "Update storage data for profile ${profile}"
  mozilla::store "${profile}" "$profile_dir" "storage.sqlite"
  if [ "${profile}" = "public" ]; then
    mozilla::add "$storage_dir" "moz-extension+++*"
    mozilla::add "$profile_dir" "global-messages-db.sqlite"
  else
    mozilla::store_tree "${profile}" "$storage_dir" -path "*/moz-extension+++*"
  fi

  if dybatpho::is true "${COOKIES}"; then
    dybatpho::progress "Update cookies, passwords for profile ${profile}"
    mozilla::store "${profile}" "$profile_dir" \
      "cookies.sqlite" "logins.json" "key4.db" "folderTree.json" "folderCache.json"
  fi

  if dybatpho::is true "${MAIL}"; then
    dybatpho::progress "Update mail data for profile ${profile}"
    if [ "${profile}" = "public" ]; then
      mozilla::add "$profile_dir" "ImapMail"
    else
      mozilla::store_tree "${profile}" "$(dybatpho::path_join "$profile_dir" "ImapMail")"
    fi
  fi

  if dybatpho::is true "${FEEDS}"; then
    dybatpho::progress "Update feeds data for profile ${profile}"
    mozilla::add "$(dybatpho::path_join "$profile_dir" "Mail")" "Feeds"
  fi

  if dybatpho::is true "${ADDRESSES}"; then
    dybatpho::progress "Update address book data for profile ${profile}"
    mozilla::store "${profile}" "$profile_dir" "history.sqlite"
    if [ "${profile}" = "public" ]; then
      mozilla::add "$profile_dir" "abook*.sqlite"
    else
      mozilla::store_tree "${profile}" "$profile_dir" -maxdepth 1 -name "abook*.sqlite"
    fi
  fi

  if dybatpho::is true "${CALENDAR}"; then
    dybatpho::progress "Update calendar data for profile ${profile}"
    if [ "${profile}" = "public" ]; then
      mozilla::add "$profile_dir" "calendar-data"
    else
      mozilla::store_tree "${profile}" "$(dybatpho::path_join "$profile_dir" "calendar-data")" \
        -name "*.sqlite"
    fi
  fi
}

#######################################
# @description Spec of dybird cli
#######################################
function _spec_main {
  dybatpho::opts::setup "Update/Refresh your live data of {{ $appName }} client to/from your dotfiles" MAIN_ARGS action:"mozilla::run _update_profile"
  dybatpho::opts::param "Log level" LOG_LEVEL --log-level -l init:="info" validate:"dybatpho::validate_log_level \$OPTARG"
  dybatpho::opts::flag "Dry run" DRY_RUN --dry-run -D on:true off:false init:="false"
  dybatpho::opts::param "Profile name" PROFILE --profile -p validate:"mozilla::validate_profile \$OPTARG"
  dybatpho::opts::flag "Refresh from scratch live data" REFRESH --refresh -r on:true off:false init:="false"
  dybatpho::opts::flag "Include cookies" COOKIES --cookies --no-cookies -c on:true off:false init:="true"
  dybatpho::opts::flag "Include mail data" MAIL --mail --no-mail -m on:true off:false init:="false"
  dybatpho::opts::flag "Include feeds data" FEEDS --feeds --no-feeds -f on:true off:false init:="true"
  dybatpho::opts::flag "Include address book data" ADDRESSES --addresses --no-addresses -a on:true off:false init:="false"
  dybatpho::opts::flag "Include calendar data" CALENDAR --calendar --no-calendar -C on:true off:false init:="false"
  dybatpho::opts::disp "Show help" --help action:"dybatpho::generate_help _spec_main"
}

dybatpho::generate_from_spec _spec_main "$@"
{{- end }}
