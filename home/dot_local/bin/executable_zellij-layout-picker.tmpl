#!{{ .bash }}
# @file zellij-layout-picker
# @brief Pick a zellij layout with fzf and launch/attach zellij using it.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh
dybatpho::register_common_handlers

layouts_dir="${ZELLIJ_LAYOUT_DIR:-$(dybatpho::path_join "$(dybatpho::xdg_config_dir zellij)" "layouts")}"

layout=""
if dybatpho::is dir "$layouts_dir"; then
  layout=$(
    find -L "$layouts_dir" -maxdepth 1 -type f -name '*.kdl' \
      -exec basename {} \; \
      | sed -E 's/\.kdl$//' \
      | sort -u \
      | awk '{ if ($0 == "default") print "0" $0; else print "1" $0 }' \
      | sort \
      | sed -E 's/^[01]//' \
      | fzf --prompt="Zellij layout> " --height=40% --reverse --exit-0
  )
fi

# dybatpho exports its functions to subshells; stop them outliving this script
# through exec. /bin/sh on macOS is bash 3.2, which can't import them and
# prints an error from every shell zellij starts (e.g. git's pager).
for fn in $(declare -F | awk '$2 == "-fx" && $3 ~ /^dybatpho::/ { print $3 }'); do
  export -nf "${fn?}"
done

if [[ -n "$layout" ]]; then
  exec zellij --layout "$layout"
else
  exec zellij
fi
