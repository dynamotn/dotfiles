#!{{ .bash }}
# @file obsidian-app
# @brief Launch the Obsidian desktop app.
# @description Launch the Obsidian GUI with the flags listed in
# `$XDG_CONFIG_HOME/obsidian/user-flags.conf`, under a name that does not
# shadow the `obsidian` CLI shipped by the distribution package.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

obsidian_config_dir="$(dybatpho::xdg_config_dir obsidian)"
user_flags_file="$(dybatpho::path_join "${obsidian_config_dir}" "user-flags.conf")"
flags=()

# Allow users to override command-line options
if dybatpho::is file "${user_flags_file}"; then
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="$(dybatpho::trim "${line%%#*}")"
    if ! dybatpho::string_is_blank "${line}"; then
      flags+=("${line}")
    fi
  done < "${user_flags_file}"
fi

# dybatpho exports its functions to subshells; stop them outliving this script
# through exec, so Electron's own child shells don't choke on importing them.
readarray -t dybatpho_functions < <(dybatpho::function_list || true)
for fn in "${dybatpho_functions[@]}"; do
  export -nf "${fn?}"
done

# Launch
{{- if eq .osid "linux-gentoo" }}
exec /opt/Obsidian/obsidian "${flags[@]}" "$@"
{{- else if eq .osid "linux-arch" }}
# The package pins a versioned Electron (electron43, ...); follow its launcher
electron_bin="$(sed -n 's/^exec \(electron[0-9]*\) .*/\1/p' /usr/bin/obsidian)"
exec "${electron_bin:-electron}" /usr/lib/obsidian/app.asar "${flags[@]}" "$@"
{{- end }}
