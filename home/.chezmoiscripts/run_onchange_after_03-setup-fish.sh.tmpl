#!{{ .bash }}
# @file 03-setup-fish.sh
# @brief Set up the fish shell
# @description Set up the fish shell after its configuration changes: make it the
# login shell, then bring the fisher plugins in line with the list. Skipped with
# a warning where fish is not installed.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh" --modules privilege
dybatpho::register_common_handlers

{{- $fishSource := joinPath .chezmoi.sourceDir "private_dot_config/fish" }}
# plugins hash: {{ joinPath $fishSource "plugins.list.tmpl" | include | sha256sum }}
# setup hash: {{ joinPath $fishSource "setup.fish" | include | sha256sum }}

if ! dybatpho::is command fish; then
  dybatpho::warn "fish is not installed, skip setting up fish shell"
  exit 0
fi

dybatpho::header "Setup fish shell"
{{- if ne .kind "container" }}
fish_bin="$(dybatpho::command_path fish)"
if [[ "${SHELL:-}" != "${fish_bin}" ]]; then
  dybatpho::info "Change default shell to fish"
  {{- if eq .chezmoi.os "linux" }}
  # We need chsh without sudo cause sometimes we don't have sudo permissions on collaborative environment
  chsh -s "${fish_bin}" || :
  {{- else if eq .chezmoi.os "darwin" }}
  echo "${fish_bin}" | dybatpho::privilege_run -- tee -a /etc/shells
  chsh -s "${fish_bin}" || :
  {{- else }}
  chsh -s fish || :
  {{- end }}
fi
{{- end }}

fish_config_dir="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".config" "fish")"
# Only the legacy universal variables go. `conf.d`, `functions` and
# `completions` also hold the links to the files the dotfiles manage, and
# `fisher update` already prunes the plugins it no longer lists.
rm -f "${fish_config_dir}"/fishd*
fish_setup_script="$(dybatpho::path_join "${fish_config_dir}" "setup.fish")"
# `--update` reinstalls fisher; `plugins.list` then overwrites `fish_plugins`,
# so `fisher update` also removes the plugins dropped from the list.
fish "${fish_setup_script}" --update

dybatpho::success "Setup fish shell"
