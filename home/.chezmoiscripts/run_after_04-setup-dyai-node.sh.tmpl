#!{{ .bash }}
# @file 04-setup-dyai-node.sh
# @brief Give this machine its dyai crew store keys, and finish their setup once glab can
# @description On a machine with an identity for its keys (dyai/node-identity.tmpl:
# personal, else its company's) and whose dyai config keeps the crew state in a
# git store. Every apply, but it stops at
# once when a stamp under ~/.local/state/dyai says the setup is done for these
# keys and this store. Otherwise it makes a signing key and a deploy key when
# missing, keeps both in secrets/data/<identity>/dyai.yaml.age (committed there,
# not pushed), and, once `glab auth login` was run, through your own account:
# keeps the store's main protected from deploy keys, registers the deploy key
# with write access, and trusts the signing key on main. Until glab is logged
# in, or when gitlab.com cannot be reached, it warns and the next apply tries
# again; it never fails the apply for it. Later applies render the same keys
# from the secrets (dyai/node-key.tmpl).
{{- $identity := includeTemplate "dyai/node-identity.tmpl" . | trim }}
{{- if and $identity (ne .kind "container") }}
DOTFILES_DIR="{{ .chezmoi.sourceDir }}/.."
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh
. "${DOTFILES_DIR}/scripts/lib/dybatpho/init.sh" || exit 1
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dycrypt.sh
. "${DOTFILES_DIR}/scripts/lib/dycrypt.sh" || exit 1
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dyai_node.sh
. "${DOTFILES_DIR}/scripts/lib/dyai_node.sh" || exit 1
dybatpho::register_common_handlers

code={{ .code | quote }}
config="{{ .chezmoi.homeDir }}/.config/dyai/config.yaml"
backend="$(yq '.global.crew.store.backend // "local"' "${config}" 2> /dev/null)" || backend=local
url="$(yq '.global.crew.store.url // ""' "${config}" 2> /dev/null)" || url=""
if [[ "${backend}" == git && -n "${url}" ]]; then
  # glab speaks to gitlab.com: the store is git@gitlab.com:<group>/<name>.git.
  [[ "${url}" == git@gitlab.com:* ]] || dybatpho::die "the dyai store ${url} is not on gitlab.com; add its keys by hand"
  project="${url#git@gitlab.com:}"
  project="${project%.git}"
  node_dir="{{ .chezmoi.homeDir }}/.config/dyai/node"
  stamp_file="${XDG_STATE_HOME:-{{ .chezmoi.homeDir }}/.local/state}/dyai/node-setup"
  # Done before, for these keys and this store: nothing to do, and no network.
  if [[ -f "${node_dir}/signing.pub" && -f "${node_dir}/deploy.pub" && -f "${stamp_file}" ]]; then
    want="$(dyai_node::stamp "${url}" "${node_dir}/signing.pub" "${node_dir}/deploy.pub")" || want=""
    [[ -z "${want}" || "$(< "${stamp_file}")" != "${want}" ]] || exit 0
  fi
  dybatpho::header "dyai crew store keys of ${code}"
  identity_type={{ $identity | quote }}
  cipher="${DOTFILES_DIR}/secrets/data/${identity_type}/dyai.yaml.age"
  identity=""
  dycrypt::identity_key identity "${identity_type}"
  dyai_node::keygen "${node_dir}/signing" "${code}"
  dyai_node::keygen "${node_dir}/deploy" "${code}"
  saved="$(dyai_node::save_secret "${code}" "${node_dir}/signing" "${node_dir}/deploy" "${cipher}" "${identity}")"
  if [[ "${saved}" == added ]]; then
    # One repository for secrets/data or one per identity: git finds it from the folder.
    git -C "${DOTFILES_DIR}/secrets/data/${identity_type}" add dyai.yaml.age
    git -C "${DOTFILES_DIR}/secrets/data/${identity_type}" commit -q -m "feat(dyai): keep the store keys of ${code}" \
      || dybatpho::die "the keys of ${code} are in ${cipher} but not committed; commit them in secrets/data"
    dybatpho::warn "secrets/data has a new commit with the keys of ${code}: push it"
  fi
  # shellcheck disable=SC2310 # a plain yes/no
  if ! dyai_node::glab_ready; then
    dybatpho::warn "glab cannot reach gitlab.com (glab auth login, or GITLAB_TOKEN): the next chezmoi apply registers \
the keys of ${code} on ${project}"
    exit 0
  fi
  # In a subshell: a GitLab that is away costs a warning, not the apply. set -e
  # is off inside an if, so each step stops it by hand.
  # shellcheck disable=SC2310 # every step checks its own status
  if (
    # main first: no deploy key may change which keys the store trusts.
    dyai_node::protect_main "${project}" > /dev/null || exit 1
    registered="$(dyai_node::register_deploy_key "${project}" "${code}" "${node_dir}/deploy.pub")" || exit 1
    [[ -z "${registered}" ]] || dybatpho::info "deploy key of ${code} ${registered} on ${project}"
    # Pushed with your own SSH key, not the deploy key: only a person changes the trust.
    trusted="$(dyai_node::trust "${code}" "${node_dir}/signing.pub" "${url}")" || exit 1
    [[ "${trusted}" != added ]] || dybatpho::info "${project} now trusts ${code}"
  ); then
    dybatpho::ensure_dir "${stamp_file%/*}" > /dev/null
    dyai_node::stamp "${url}" "${node_dir}/signing.pub" "${node_dir}/deploy.pub" > "${stamp_file}"
    dybatpho::success "dyai crew store keys of ${code}"
  else
    dybatpho::warn "could not finish the store keys of ${code} on ${project}; the next chezmoi apply tries again"
  fi
fi
{{- end }}
