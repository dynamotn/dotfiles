#!{{ .bash }}
# @file 04-start_rclone.sh
# @brief Start the rclone mounts
# @description Start the rclone mounts after their configuration changes, and
# stop those of the remotes that left it. The configuration only exists on
# machines set up with an enterprise's secrets; without one, every mount an
# earlier setup enabled is stopped. A container has no service manager to
# keep the mounts, so it skips the hook.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers
. "{{ .chezmoi.sourceDir }}/../scripts/lib/init_system.sh"

{{- if ne .kind "container" }}
{{- $rcloneConf := joinPath .chezmoi.homeDir ".config/rclone/rclone.conf" }}
{{- /*
  The inputs of rclone.conf, not the file: this renders before the apply
  writes it, so its hash was always one apply late. The ciphertext changes
  with the secrets, and hashing it decrypts nothing.
*/}}
# template hash: {{ joinPath .chezmoi.sourceDir "private_dot_config/rclone/rclone.conf.tmpl" | include | sha256sum }}
{{- range .decryptEnterprise }}
# secrets hash: {{ printf "../secrets/data/enterprise-%s/common.yaml.age" . | joinPath $.chezmoi.sourceDir | include | sha256sum }}
{{- end }}

dybatpho::header "Start rclone"
rclone_conf="{{ $rcloneConf }}"
# No config is a config without a remote: chezmoi removes the file once the
# last remote left, and its mount must still be stopped below. A config
# without any remote section makes grep fail, which is the same empty case.
remotes=()
if dybatpho::is file "${rclone_conf}"; then
  readarray -t remotes < <(grep '^\[' "${rclone_conf}" | tr -d '[]' || true)
fi
# Not the end of the hook: the mounts of the remotes that left still go.
if ((${#remotes[@]} == 0)); then
  dybatpho::warn "No rclone remotes configured"
fi

{{- if eq .initSystem "systemd" }}
if ! dybatpho::is dir /run/systemd/system; then
  dybatpho::warn "systemd is not running, skipping the rclone services"
  exit 0
fi
systemctl --user daemon-reload
for remote in ${remotes[@]+"${remotes[@]}"}; do
  dybatpho::progress "Enable rclone for remote: ${remote}"
  dybatpho::ensure_dir "{{ .chezmoi.homeDir }}/Sync/${remote}" > /dev/null
  systemctl --user enable --now "rclone@${remote}.service" || true
done
stale="$(init_system::stale_instances "{{ .chezmoi.homeDir }}/.config/systemd/user/default.target.wants" \
  "rclone@" ${remotes[@]+"${remotes[@]}"})"
while IFS= read -r remote; do
  [[ -n "${remote}" ]] || continue
  dybatpho::progress "Disable rclone for a remote no longer configured: ${remote}"
  systemctl --user disable --now "rclone@${remote}.service" || true
done <<< "${stale}"
{{- else if eq .initSystem "openrc" }}
openrc_initd="{{ .chezmoi.homeDir }}/.config/openrc/init.d"
openrc_default="{{ .chezmoi.homeDir }}/.config/openrc/runlevels/default"
dybatpho::ensure_dir "${openrc_default}" > /dev/null
for remote in ${remotes[@]+"${remotes[@]}"}; do
  dybatpho::progress "Enable rclone for remote: ${remote}"
  dybatpho::ensure_dir "{{ .chezmoi.homeDir }}/Sync/${remote}" > /dev/null
  # Create per-remote symlink if not exists
  if [[ ! -L "${openrc_initd}/rclone.${remote}" ]]; then
    ln -sf "${openrc_initd}/rclone" "${openrc_initd}/rclone.${remote}"
  fi
  # Enable in default runlevel
  if [[ ! -L "${openrc_default}/rclone.${remote}" ]]; then
    ln -sf "${openrc_initd}/rclone.${remote}" "${openrc_default}/rclone.${remote}"
  fi
  rc-service --user "rclone.${remote}" start 2> /dev/null \
    || rc-service "rclone.${remote}" start || true
done
stale="$(init_system::stale_instances "${openrc_default}" "rclone." ${remotes[@]+"${remotes[@]}"})"
while IFS= read -r remote; do
  [[ -n "${remote}" ]] || continue
  dybatpho::progress "Disable rclone for a remote no longer configured: ${remote}"
  rc-service --user "rclone.${remote}" stop 2> /dev/null \
    || rc-service "rclone.${remote}" stop || true
  rm -f "${openrc_default}/rclone.${remote}" "${openrc_initd}/rclone.${remote}"
done <<< "${stale}"
{{- end }}

dybatpho::success "Start rclone"
{{- end }}
