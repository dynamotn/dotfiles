#!{{ .bash }}
# @file 04-start_rclone.sh
# @brief Start the rclone mounts
# @description Start the rclone mounts after their configuration changes. The
# configuration only exists on machines set up with an enterprise's secrets, and
# a container has no service manager to keep the mounts, so both skip it.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

{{- if and (not (empty .decryptEnterprise)) (ne .kind "container") }}
{{- $rcloneConf := joinPath .chezmoi.homeDir ".config/rclone/rclone.conf" }}
{{- /* Rendered before the files are written, so a first apply has no config yet */}}
{{- if stat $rcloneConf }}
# config hash: {{ include $rcloneConf | sha256sum }}
{{- end }}

dybatpho::header "Start rclone"
rclone_conf="{{ $rcloneConf }}"
if ! dybatpho::is file "${rclone_conf}"; then
  dybatpho::warn "No rclone config at ${rclone_conf}, skipping"
  exit 0
fi
# A config without any remote section makes grep fail, which is the empty case
# handled below rather than an error.
readarray -t remotes < <(grep '^\[' "${rclone_conf}" | tr -d '[]' || true)
if ((${#remotes[@]} == 0)); then
  dybatpho::warn "No rclone remotes configured, skipping"
  exit 0
fi

{{- if eq .initSystem "systemd" }}
if ! dybatpho::is dir /run/systemd/system; then
  dybatpho::warn "systemd is not running, skipping the rclone services"
  exit 0
fi
systemctl --user daemon-reload
for remote in "${remotes[@]}"; do
  dybatpho::progress "Enable rclone for remote: ${remote}"
  dybatpho::ensure_dir "{{ .chezmoi.homeDir }}/Sync/${remote}" > /dev/null
  systemctl --user enable --now "rclone@${remote}.service" || true
done
{{- else if eq .initSystem "openrc" }}
openrc_initd="{{ .chezmoi.homeDir }}/.config/openrc/init.d"
openrc_default="{{ .chezmoi.homeDir }}/.config/openrc/runlevels/default"
dybatpho::ensure_dir "${openrc_default}" > /dev/null
for remote in "${remotes[@]}"; do
  dybatpho::progress "Enable rclone for remote: ${remote}"
  dybatpho::ensure_dir "{{ .chezmoi.homeDir }}/Sync/${remote}" > /dev/null
  # Create per-remote symlink if not exists
  if [[ ! -L "${openrc_initd}/rclone.${remote}" ]]; then
    ln -sf "${openrc_initd}/rclone" "${openrc_initd}/rclone.${remote}"
  fi
  # Enable in default runlevel
  if [[ ! -L "${openrc_default}/rclone.${remote}" ]]; then
    ln -sf "${openrc_initd}/rclone.${remote}" "${openrc_default}/rclone.${remote}"
  fi
  rc-service --user "rclone.${remote}" start 2> /dev/null \
    || rc-service "rclone.${remote}" start || true
done
{{- end }}

dybatpho::success "Start rclone"
{{- end }}
