#!{{ .bash }}
# @file 03-setup-nvim.sh
# @brief Sync the neovim plugins
# @description Bring the neovim plugins to the versions of the plugin lock,
# headless, whenever a lock of the configuration changes. `restore`, not
# `sync`: an update would rewrite the lock, which is linked into the source,
# and so run this hook again on every apply.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers
{{- /* A submodule, so absent until the submodules are updated. Both locks:
       which one a machine follows is the configuration's own choice. */}}
{{- range list "lazy-lock.json" "lazy-lock.stable.json" }}
{{-   $lock := joinPath $.chezmoi.sourceDir "private_dot_config/nvim" . }}
{{-   if stat $lock }}
# {{ . }} hash: {{ include $lock | sha256sum }}
{{-   end }}
{{- end }}

if ! dybatpho::is command nvim; then
  dybatpho::warn "nvim is not installed, skip syncing its plugins"
  exit 0
fi

dybatpho::header "Setup neovim"
nvim --headless "+Lazy! restore" +qa
dybatpho::success "Setup neovim"
