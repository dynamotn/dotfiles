#!{{ .bash }}
# @file 04-setup-macos.sh
# @brief Apply the macOS defaults and the keyboard mapping
# @description Apply every defaults file under `dot_macos` and set the modifier key
# mapping. Only runs on macOS.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh --modules privilege
dybatpho::register_common_handlers

{{- if eq .chezmoi.os "darwin" }}
{{- range (joinPath .chezmoi.sourceDir "dot_macos/*" | glob) }}
# {{ . }} hash: {{ . | include | sha256sum }}
{{- end }}
dybatpho::header "Setup MacOS"
dybatpho::privilege_run -- scutil --set HostName {{ .code }}
macos_defaults_dir="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".macos")"
macos-defaults apply "${macos_defaults_dir}"

# Disable the sound effects on boot
dybatpho::privilege_run -- nvram SystemAudioVolume=" "
# Remove duplicates in the “Open With” menu (also see `lscleanup` alias)
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks"
lsregister+="/LaunchServices.framework/Support/lsregister"
"${lsregister}" -r -domain local -domain system -domain user

dybatpho::progress "Mapping keys for Apply Internal Keyboard"
# Code table
# |Key|Left|Right|
# |No action|30064771072||
# |Esc|30064771113||
# |Caps Lock|30064771129||
# |⌃ Control|30064771296|30064771300|
# |⌥ Options|30064771298|30064771302|
# |⌘ Command|30064771299|30064771303|
# |🌐 Fn |1095216660483|280379760050179|
# Each entry is "<source key> <destination key>", with codes from the table above
key_mappings=(
  "30064771296 1095216660483"
  "30064771302 30064771302"
  "1095216660483 30064771300"
  "30064771303 30064771303"
  "30064771300 1095216660483"
  "30064771298 30064771298"
  "280379760050179 30064771296"
  "30064771129 30064771300"
  "30064771299 30064771299"
)
mapping="<array>"
for key_mapping in "${key_mappings[@]}"; do
  read -r source_key destination_key <<< "${key_mapping}"
  mapping+="<dict><key>HIDKeyboardModifierMappingDst</key><integer>${destination_key}</integer>"
  mapping+="<key>HIDKeyboardModifierMappingSrc</key><integer>${source_key}</integer></dict>"
done
mapping+="</array>"
defaults -currentHost write -g com.apple.keyboard.modifiermapping.0-0-0 "${mapping}"
killall "cfprefsd" &> /dev/null

dybatpho::success "Setup MacOS"
{{- end }}
