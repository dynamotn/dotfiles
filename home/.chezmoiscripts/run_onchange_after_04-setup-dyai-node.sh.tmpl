#!{{ .bash }}
# @file 04-setup-dyai-node.sh
# @brief Give this machine its dyai crew store keys, once
# @description On a machine that decrypts the personal secrets and whose dyai
# config keeps the crew state in a git store: when the secrets hold no keys
# for this machine's code yet, make a signing key and a deploy key, keep both
# in secrets/data/personal/dyai.yaml.age (committed there, not pushed), and
# then, through glab and your own account: keep the store's main protected
# from deploy keys, register the deploy key with write access, and trust the
# signing key on main (nodes/allowed_signers). Every later apply renders the
# same keys from the secrets (dyai/node-key.tmpl). Needs `glab auth login`.
{{- if and .decryptPersonal (ne .kind "container") }}
DOTFILES_DIR="{{ .chezmoi.sourceDir }}/.."
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh
. "${DOTFILES_DIR}/scripts/lib/dybatpho/init.sh" || exit 1
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dycrypt.sh
. "${DOTFILES_DIR}/scripts/lib/dycrypt.sh" || exit 1
# shellcheck source={{ .chezmoi.sourceDir }}/../scripts/lib/dyai_node.sh
. "${DOTFILES_DIR}/scripts/lib/dyai_node.sh" || exit 1
dybatpho::register_common_handlers

code={{ .code | quote }}
config="{{ .chezmoi.homeDir }}/.config/dyai/config.yaml"
backend="$(yq '.global.crew.store.backend // "local"' "${config}" 2> /dev/null)" || backend=local
url="$(yq '.global.crew.store.url // ""' "${config}" 2> /dev/null)" || url=""
if [[ "${backend}" == git && -n "${url}" ]]; then
  # glab speaks to gitlab.com: the store is git@gitlab.com:<group>/<name>.git.
  [[ "${url}" == git@gitlab.com:* ]] || dybatpho::die "the dyai store ${url} is not on gitlab.com; add its keys by hand"
  project="${url#git@gitlab.com:}"
  project="${project%.git}"
  dybatpho::header "dyai crew store keys of ${code}"
  node_dir="{{ .chezmoi.homeDir }}/.config/dyai/node"
  cipher="${DOTFILES_DIR}/secrets/data/personal/dyai.yaml.age"
  identity=""
  dycrypt::identity_key identity personal
  dyai_node::keygen "${node_dir}/signing" "${code}"
  dyai_node::keygen "${node_dir}/deploy" "${code}"
  saved="$(dyai_node::save_secret "${code}" "${node_dir}/signing" "${node_dir}/deploy" "${cipher}" "${identity}")"
  if [[ "${saved}" == added ]]; then
    git -C "${DOTFILES_DIR}/secrets/data" add personal/dyai.yaml.age
    git -C "${DOTFILES_DIR}/secrets/data" commit -q -m "feat(dyai): keep the store keys of ${code}" \
      || dybatpho::die "the keys of ${code} are in ${cipher} but not committed; commit them in secrets/data"
    dybatpho::warn "secrets/data has a new commit with the keys of ${code}: push it"
  fi
  # main first: no deploy key may change which keys the store trusts.
  dyai_node::protect_main "${project}" > /dev/null
  registered="$(dyai_node::register_deploy_key "${project}" "${code}" "${node_dir}/deploy.pub")"
  [[ -z "${registered}" ]] || dybatpho::info "deploy key of ${code} ${registered} on ${project}"
  # Pushed with your own SSH key, not the deploy key: only a person changes the trust.
  trusted="$(dyai_node::trust "${code}" "${node_dir}/signing.pub" "${url}")"
  [[ "${trusted}" != added ]] || dybatpho::info "${project} now trusts ${code}"
  dybatpho::success "dyai crew store keys of ${code}"
fi
{{- end }}
