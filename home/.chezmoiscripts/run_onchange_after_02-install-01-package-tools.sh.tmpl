#!{{ .bash }}
# @file 02-install-01-package-tools.sh
# @brief Install the package manager tools declared for dytoy
# @description Install the package manager tools declared for dytoy. Re-runs whenever a
# dytoy template changes.
. {{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh
dybatpho::register_common_handlers

local_bin_dir="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".local" "bin")"
export PATH="${local_bin_dir}:${PATH}"
{{- range (joinPath .chezmoi.sourceDir ".chezmoitemplates/dytoy/*" | glob) }}
# {{ . }} hash: {{ . | include | sha256sum }}
{{- end }}
"${local_bin_dir}/dytoy" os -e -i -s
