{{- if eq .chezmoi.os "darwin" -}}
#!{{ .bash }}
# @file 05-reload-sketchybar.sh
# @brief Reload sketchybar when its config changed
# @description Reload sketchybar, if it is running, after `chezmoi apply`
# changed anything under private_dot_config/sketchybar. The hook carries one hash
# over that whole directory, so it re-runs on any change there.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

{{ template "chezmoiscripts/reload_app.sh.tmpl" (dict "ctx" . "label" "sketchybar" "process" "sketchybar" "dirs" (list "private_dot_config/sketchybar") "command" "sketchybar --reload") }}
{{- end }}
