#!{{ .bash }}
# @file 03-setup-claude.sh
# @brief Install the Claude Code marketplaces, plugins, skills and MCP servers
# @description Bring the Claude Code extensions on this machine in line with the
# dotfiles: every marketplace and plugin named in `~/.claude/settings.json`, and
# every community skill from skills.sh listed below, and the MCP servers below
# in every Claude configuration. Re-runs whenever the settings or these lists
# change. Nothing here is tied to a single project: a
# plugin that needs a project tool chain (terraform, a database CLI, ...) does
# not belong in the settings and is left to that project.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers
if ! dybatpho::is command jq; then
  dybatpho::warn "jq is not installed, skip setting up Claude Code"
  exit 0
fi

# settings hash: {{ joinPath .chezmoi.sourceDir "private_dot_claude/settings.json" | include | sha256sum }}
SETTINGS_FILE="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".claude" "settings.json")"
PLUGINS_DIR="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".claude" "plugins")"
SKILLS_DIR="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".agents" "skills")"

# Community skills from https://skills.sh, installed for every agent with
# `npx skills add -g`. Keep each entry generic to a role, never to one project.
# The installer is pinned, so an apply never runs a release nobody looked at.
SKILLS_CLI="skills@1.7.2"
SKILLS=(
  # discovery
  vercel-labs/skills@find-skills
  # devops
  affaan-m/ecc@docker-patterns
  jeffallan/claude-skills@kubernetes-specialist
  wshobson/agents@helm-chart-scaffolding
  wshobson/agents@github-actions-templates
  wshobson/agents@gitlab-ci-patterns
  wshobson/agents@gitops-workflow
  aws/agent-toolkit-for-aws@aws-iam
  aws/agent-toolkit-for-aws@aws-observability
  # frontend
  vercel-labs/agent-skills@vercel-react-best-practices
  leonxlnx/taste-skill@design-taste-frontend
  addyosmani/web-quality-skills@accessibility
  currents-dev/playwright-best-practices-skill@playwright-best-practices
  wshobson/agents@e2e-testing-patterns
  # backend
  wshobson/agents@api-design-principles
  addyosmani/agent-skills@api-and-interface-design
  supabase/agent-skills@supabase-postgres-best-practices
  samber/cc-skills-golang@golang-code-style
  samber/cc-skills-golang@golang-testing
  samber/cc-skills-golang@golang-error-handling
  samber/cc-skills-golang@golang-grpc
  mindrally/skills@fastapi-python
  mcollina/skills@fastify-best-practices
  apollographql/skills@rust-best-practices
  wshobson/agents@sql-optimization-patterns
  # security
  samber/cc-skills-golang@golang-security
  wshobson/agents@stride-analysis-patterns
  openai/skills@security-threat-model
  # architecture
  spillwavesolutions/design-doc-mermaid@design-doc-mermaid
  softaworks/agent-toolkit@c4-architecture
  addyosmani/agent-skills@documentation-and-adrs
  wshobson/agents@architecture-patterns
  wondelai/skills@domain-driven-design
  # ai engineering
  anthropics/skills@mcp-builder
  wshobson/agents@prompt-engineering-patterns
)

# MCP servers are registered at user scope in the default configuration and in
# every enterprise one, the directories mise points `CLAUDE_CONFIG_DIR` at.
DEFAULT_CONFIG_DIR="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".claude")"
ENTERPRISE_DIR="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" "Working" "enterprise")"
LAYA_MCP_SERVER="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".local" "bin" "laya-mcp-server")"
# dytoy installs the ROCm build of torch for laya on an AMD GPU.
HAS_AMD_GPU='{{ eq .guiDriver "A" }}'

#######################################
# @description Check a filter against a JSON file, false when the file is missing
# @arg $1 string Path of the JSON file
# @arg $2 string jq filter that yields true or false
# @exitcode 0 The file exists and the filter yields true
#######################################
function _in_json_file {
  local file filter
  dybatpho::expect_args file filter -- "$@"
  dybatpho::is file "${file}" || return 1
  jq -e "${filter}" "${file}" > /dev/null
}

#######################################
# @description Register every marketplace named in the settings that Claude does not know yet
# @noargs
#######################################
function _setup_marketplaces {
  local known_file query name source
  known_file="$(dybatpho::path_join "${PLUGINS_DIR}" "known_marketplaces.json")"
  # One field per source: a tab is IFS whitespace, so `read` would collapse an
  # empty repo or url field and shift the ones after it.
  query='.extraKnownMarketplaces // {} | to_entries[]'
  query+=' | [.key, .value.source.repo // .value.source.url // ""] | @tsv'
  # shellcheck disable=SC2312 # jq reads the settings chezmoi just wrote
  while IFS=$'\t' read -r name source; do
    [[ -n "${name}" ]] || continue
    # shellcheck disable=SC2310 # a missing or non-matching file is a plain no
    if _in_json_file "${known_file}" "has(\"${name}\")"; then
      dybatpho::debug "Marketplace ${name} already known"
      continue
    fi
    dybatpho::info "Add marketplace ${name}"
    claude plugin marketplace add "${source}" || dybatpho::warn "Could not add marketplace ${name}"
  done < <(jq -r "${query}" "${SETTINGS_FILE}")
}

#######################################
# @description Install every plugin enabled in the settings that is not installed yet
# @noargs
#######################################
function _setup_plugins {
  local installed_file plugin
  installed_file="$(dybatpho::path_join "${PLUGINS_DIR}" "installed_plugins.json")"
  # shellcheck disable=SC2312 # jq reads the settings chezmoi just wrote
  while IFS= read -r plugin; do
    [[ -n "${plugin}" ]] || continue
    # shellcheck disable=SC2310 # a missing or non-matching file is a plain no
    if _in_json_file "${installed_file}" ".plugins | has(\"${plugin}\")"; then
      dybatpho::debug "Plugin ${plugin} already installed"
      continue
    fi
    dybatpho::info "Install plugin ${plugin}"
    claude plugin install "${plugin}" || dybatpho::warn "Could not install plugin ${plugin}"
  done < <(jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "${SETTINGS_FILE}")
}

#######################################
# @description Install every skill of the list that is missing from the global skills directory
# @noargs
#######################################
function _setup_skills {
  local skill name
  for skill in "${SKILLS[@]}"; do
    name="${skill##*@}"
    local target
    target="$(dybatpho::path_join "${SKILLS_DIR}" "${name}")"
    if dybatpho::is dir "${target}"; then
      dybatpho::debug "Skill ${name} already installed"
      continue
    fi
    dybatpho::info "Install skill ${skill}"
    npx -y "${SKILLS_CLI}" add "${skill}" -g -y || dybatpho::warn "Could not install skill ${skill}"
  done
}

#######################################
# @description Print every Claude configuration directory of this machine
# @noargs
# @stdout One directory per line, the default one first
#######################################
function _claude_config_dirs {
  local dir
  printf '%s\n' "${DEFAULT_CONFIG_DIR}"
  for dir in "${ENTERPRISE_DIR}"/*/.claude "${ENTERPRISE_DIR}"/*/*/.claude; do
    if dybatpho::is dir "${dir}"; then
      printf '%s\n' "${dir}"
    fi
  done
}

#######################################
# @description Run claude against one configuration directory
# @arg $1 string Configuration directory
# @arg $@ string Arguments of claude, after the directory
#######################################
function _claude_in {
  local dir
  dybatpho::expect_args dir -- "$@"
  shift
  # The default configuration is the one claude reads when CLAUDE_CONFIG_DIR is unset.
  if [[ "${dir}" == "${DEFAULT_CONFIG_DIR}" ]]; then
    env -u CLAUDE_CONFIG_DIR claude "$@"
  else
    CLAUDE_CONFIG_DIR="${dir}" claude "$@"
  fi
}

#######################################
# @description Register an MCP server in every configuration where it is missing or differs
# @arg $1 string Name of the server
# @arg $2 string Server definition as JSON, as `claude mcp add-json` takes it
#######################################
function _setup_mcp_server {
  local name definition
  dybatpho::expect_args name definition -- "$@"
  local dir state_file current wanted
  wanted="$(jq -cS . <<< "${definition}")"
  # shellcheck disable=SC2312 # the directories are globbed, the loop cannot fail on them
  while IFS= read -r dir; do
    # The default configuration keeps its state next to the directory, not in it.
    if [[ "${dir}" == "${DEFAULT_CONFIG_DIR}" ]]; then
      state_file="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" ".claude.json")"
    else
      state_file="$(dybatpho::path_join "${dir}" ".claude.json")"
    fi
    current=""
    if dybatpho::is file "${state_file}"; then
      current="$(jq -cS --arg name "${name}" '.mcpServers[$name] // empty' "${state_file}")"
    fi
    if [[ "${current}" == "${wanted}" ]]; then
      dybatpho::debug "MCP server ${name} already registered in ${dir}"
      continue
    fi
    dybatpho::info "Register MCP server ${name} in ${dir}"
    if [[ -n "${current}" ]]; then
      # dyshellint disable=SC2310 a failure only warns, the other configurations still run
      _claude_in "${dir}" mcp remove --scope user "${name}" > /dev/null \
        || dybatpho::warn "Could not remove the outdated MCP server ${name} from ${dir}"
    fi
    # dyshellint disable=SC2310 a failure only warns, the other configurations still run
    _claude_in "${dir}" mcp add-json --scope user "${name}" "${definition}" > /dev/null \
      || dybatpho::warn "Could not register MCP server ${name} in ${dir}"
  done < <(_claude_config_dirs)
}

#######################################
# @description Register the Laya decision model, installed by dytoy, as an MCP server
# @noargs
#######################################
function _setup_laya {
  if ! dybatpho::is executable "${LAYA_MCP_SERVER}"; then
    dybatpho::warn "laya is not installed, skip its MCP server"
    return 0
  fi
  local env='{"HF_HUB_DISABLE_TELEMETRY": "1"}'
  # The ROCm build of torch ships no kernels for the RDNA2 chips other than
  # gfx1030 (Radeon 680M, RX 6600, ...); they run the gfx1030 ones instead.
  if dybatpho::is true "${HAS_AMD_GPU}"; then
    local agents
    agents="$(PATH="${PATH}:/opt/rocm/bin" rocminfo 2> /dev/null || true)"
    if [[ "${agents}" =~ gfx103[1-6] ]]; then
      env="$(jq -c '. + {HSA_OVERRIDE_GFX_VERSION: "10.3.0"}' <<< "${env}")"
    fi
  fi
  local definition
  definition="$(jq -cn --arg command "${LAYA_MCP_SERVER}" --argjson env "${env}" \
    '{type: "stdio", command: $command, args: [], env: $env}')"
  _setup_mcp_server laya "${definition}"
}

#######################################
# @description Entrypoint
# @noargs
#######################################
function _main {
  dybatpho::header "Setup Claude Code"
  if dybatpho::is command claude; then
    _setup_marketplaces
    _setup_plugins
    _setup_laya
  else
    dybatpho::warn "claude is not installed, skip marketplaces and plugins"
  fi
  if dybatpho::is command npx; then
    _setup_skills
  else
    dybatpho::warn "npx is not installed, skip skills"
  fi
  dybatpho::success "Setup Claude Code"
}

_main "$@"
