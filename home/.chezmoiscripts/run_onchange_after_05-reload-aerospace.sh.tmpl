{{- if eq .chezmoi.os "darwin" -}}
#!{{ .bash }}
# @file 05-reload-aerospace.sh
# @brief Reload AeroSpace when its config changed
# @description Reload AeroSpace, if it is running, after `chezmoi apply`
# changed anything under private_dot_config/aerospace. The hook carries one hash
# over that whole directory, so it re-runs on any change there.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

{{ template "chezmoiscripts/reload_app.sh.tmpl" (dict "ctx" . "label" "AeroSpace" "process" "AeroSpace" "dirs" (list "private_dot_config/aerospace") "command" "aerospace reload-config") }}
{{- end }}
