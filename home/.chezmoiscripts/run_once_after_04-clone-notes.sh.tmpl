#!{{ .bash }}
# @file 04-clone-notes.sh
# @brief Clone the notes repository on Android
# @description Clone the notes repository into the shared Documents folder, only on
# Android, and only when it is not there yet.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

{{- if eq .chezmoi.os "android" }}
notes_dir="$(dybatpho::path_join "{{ .chezmoi.homeDir }}" "storage" "shared" "Documents" "Notes")"
if ! dybatpho::is dir "${notes_dir}"; then
  dybatpho::header "Clone notes"
  dybatpho::ensure_dir "${notes_dir}" > /dev/null
  git -C "${notes_dir}" init
  git -C "${notes_dir}" remote add ssh git@gitlab.com:dynamo-brain/digital-garden.git
  git -C "${notes_dir}" remote add origin https://gitlab.com/dynamo-brain/digital-garden.git
  dybatpho::progress "Pull from remote"
  if ! git -C "${notes_dir}" pull ssh main; then
    # A half-built clone would stop every later run at the check above.
    rm -rf "${notes_dir}"
    dybatpho::die "Can't pull the notes, run the hook again once the remote is reachable"
  fi
  dybatpho::success "Clone notes"
fi
{{- end }}
