{{- /*
  Claude Code settings. The plugin, marketplace and policy data is rendered
  from the shared dyai partial so this file and ~/.config/dyai/config.yaml
  never drift; the hooks and UI scalars below are Claude-specific literals.

  The Bash sandbox is what makes the Read deny rules hold for shell commands
  too (they merge into its denyRead), so `cat ~/.ssh/x` is blocked like the
  Read tool is. Excluded commands run outside it: git (a worktree's git dir
  sits outside the worktree, and push needs the ssh agent), and the tools
  that write all over $HOME or the system. The rtk spelling of git is listed
  because rtk rewrites git before the sandbox sees it; rtk as a whole is not,
  since `cat` becomes `rtk read` and must stay sandboxed.
*/ -}}
{{- $d := fromYaml (includeTemplate "ai/dyai-data.yaml.tmpl" .) -}}
{{- $enabled := dict -}}
{{- range $d.plugins }}{{ $_ := set $enabled . true }}{{ end -}}
{{- /* Installed but off; a dyai preset turns one on per project. */ -}}
{{- range $d.optional_plugins }}{{ $_ := set $enabled . false }}{{ end -}}
{{- $static := `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 20,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git *",
      "rtk git *",
      "docker *",
      "podman *",
      "chezmoi *",
      "dyai *",
      "mise *",
      "sudo *",
      "emerge *",
      "systemctl *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.local/share/rtk",
        "~/.local/state",
        "~/.bun",
        "~/.npm",
        "~/.cargo/registry",
        "~/go/pkg"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "gitlab.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "crates.io",
        "*.crates.io"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/AGENTS.md\"; if [ -f \"$f\" ] && ! [ -f \"${f%AGENTS.md}CLAUDE.md\" ]; then echo '=== AGENTS.md (project rules) ==='; cat \"$f\"; else true; fi",
            "statusMessage": "Loading AGENTS.md..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Task finished!' --icon=dialog-information; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/complete.oga ] && paplay /usr/share/sounds/freedesktop/stereo/complete.oga; } 2>/dev/null; true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Prompt waiting for your input!' --icon=dialog-information; true",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Permission requested' --icon=dialog-question; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/window-question.oga ] && paplay /usr/share/sounds/freedesktop/stereo/window-question.oga; } 2>/dev/null; true",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lint-shell.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
` | fromJson -}}
{{- $derived := dict
      "permissions" $d.policy.permissions
      "theme" $d.policy.theme
      "effortLevel" $d.policy.effortLevel
      "enabledPlugins" $enabled
      "extraKnownMarketplaces" $d.marketplaces -}}
{{ mergeOverwrite $static $derived | toPrettyJson }}
