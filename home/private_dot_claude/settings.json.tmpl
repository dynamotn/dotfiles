{{- /*
  Claude Code settings. The plugin, marketplace and policy data is rendered
  from the shared dyai partial so this file and ~/.config/dyai/config.yaml
  never drift; the hooks and UI scalars below are Claude-specific literals.

  The Bash sandbox is what makes the Read deny rules hold for shell commands
  too (they merge into its denyRead), so `cat ~/.ssh/x` is blocked like the
  Read tool is. Excluded commands run outside it: git (a worktree's git dir
  sits outside the worktree, and push needs the ssh agent), and the tools
  that write all over $HOME or the system. The rtk spelling of git is listed
  because rtk rewrites git before the sandbox sees it; rtk as a whole is not,
  since `cat` becomes `rtk read` and must stay sandboxed. rtk's own config
  (private_dot_config/rtk/config.toml.tmpl) keeps it off the other commands
  here, except `sudo`, which rtk strips first.

  Sandboxed commands run without a prompt, so what they may write must never
  hold something that later runs outside it: only package caches are
  writable, never a directory on PATH, a tool's trust state, or plugin code.
  The network allowlist holds download hosts only; anything that can take a
  write (the GitHub API, gitlab.com) still prompts.
*/ -}}
{{- $d := fromYaml (includeTemplate "ai/dyai-data.yaml.tmpl" .) -}}
{{- $enabled := dict -}}
{{- range $d.plugins }}{{ $_ := set $enabled . true }}{{ end -}}
{{- /* Installed but off; a dyai preset turns one on per project. */ -}}
{{- range $d.optional_plugins }}{{ $_ := set $enabled . false }}{{ end -}}
{{- range $d.disabled_plugins }}{{ $_ := set $enabled . false }}{{ end -}}
{{- $static := `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "cleanupPeriodDays": 20,
  "env": {
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fsmonitor",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git *",
      "rtk git *",
      "docker *",
      "podman *",
      "chezmoi *",
      "dyai *",
      "mise *",
      "sudo *",
      "emerge *",
      "systemctl *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/.bun/install/cache",
        "~/.cache/go-build",
        "~/.cache/pip",
        "~/.cache/uv",
        "~/.cargo/registry",
        "~/.cache/rtk"
      ],
      "denyWrite": [
        "~/.local/bin",
        "~/.cache/.bun/bin",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.local/share/nvim/mason",
        "~/.claude/plugins",
        "~/.krew/bin",
        "~/.hunk/bin"
      ]
    },
    "network": {
      "allowedDomains": [
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "index.crates.io",
        "static.crates.io"
      ]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/vault-recall.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/AGENTS.md\"; if [ -f \"$f\" ] && ! [ -f \"${f%AGENTS.md}CLAUDE.md\" ]; then echo '=== AGENTS.md (project rules) ==='; cat \"$f\"; else true; fi",
            "statusMessage": "Loading AGENTS.md..."
          },
          {
            "type": "command",
            "command": "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v dyai >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || exit 0; out=\"$(dyai status --quiet 2>&1)\"; [ -z \"$out\" ] || jq -n --arg m \"$out\" '{systemMessage: (\"dyai drift:\\n\" + $m), hookSpecificOutput: {hookEventName: \"SessionStart\", additionalContext: (\"dyai drift between the config and the installed agents:\\n\" + $m)}}'; true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Task finished!' --icon=dialog-information; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/complete.oga ] && paplay /usr/share/sounds/freedesktop/stereo/complete.oga; } 2>/dev/null; true",
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/verify-on-stop.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v dyai-hunk >/dev/null 2>&1 && dyai-hunk; true",
            "async": true
          },
          {
            "type": "command",
            "command": "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v dyai-session-report >/dev/null 2>&1 && dyai-session-report; true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Prompt waiting for your input!' --icon=dialog-information; true",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${DYAI_CREW:-}\" ] || exit 0; command -v notify-send >/dev/null 2>&1 && notify-send 'Claude' 'Permission requested' --icon=dialog-question; { command -v paplay >/dev/null 2>&1 && [ -f /usr/share/sounds/freedesktop/stereo/window-question.oga ] && paplay /usr/share/sounds/freedesktop/stereo/window-question.oga; } 2>/dev/null; true",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-skill.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/route-agent.sh gate",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/log-agent.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lint-shell.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__laya__laya_route|mcp__laya__laya_route_batch|mcp__laya__laya_decide",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/route-agent.sh record",
            "async": true
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
` | fromJson -}}
{{- /*
  The sandbox turns every recursive (double-star) Read deny into one path
  per matching file under the cwd. The .age rule alone matched ~1.7k files
  here (browser profiles, worktrees): a 1.7MB bwrap command line that fails
  with E2BIG and adds ~13s to startup. Claude gets the gitignore form
  `*.age` instead, which the Read tool matches at any depth without
  expansion, and the sandbox denies the directories that hold .age files.
  shortcut: a .age file outside these directories is readable from Bash;
  add its directory here when one appears.
*/ -}}
{{- $deny := list -}}
{{- range $d.policy.permissions.deny }}{{ $deny = append $deny (eq . "Read(**/*.age)" | ternary "Read(*.age)" .) }}{{ end -}}
{{- $perms := deepCopy $d.policy.permissions -}}
{{- $_ := set $perms "deny" $deny -}}
{{- $wt := .chezmoi.workingTree -}}
{{- $denyRead := list
      (joinPath $wt "secrets")
      (joinPath $wt ".worktrees/*/secrets")
      (joinPath $wt "home/private_dot_ssh/keys")
      (joinPath $wt "home/private_dot_config/firefox/profiles")
      (joinPath $wt "home/private_dot_config/thunderbird/profiles")
      (joinPath $wt "home/private_dot_config/tstruct/encrypted_auth.json.age")
      (joinPath $wt "home/private_dot_config/nvim/lua/per_machine/encrypted_F1.lua.age") -}}
{{- $derived := dict
      "permissions" $perms
      "sandbox" (dict "filesystem" (dict "denyRead" $denyRead))
      "theme" $d.policy.theme
      "effortLevel" $d.policy.effortLevel
      "enabledPlugins" $enabled
      "extraKnownMarketplaces" $d.marketplaces -}}
{{ mergeOverwrite $static $derived | toPrettyJson }}
