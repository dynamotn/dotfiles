#!{{ .bash }}
# @file route-agent.sh
# @brief Require a routing decision before Claude spawns a subagent
# @description Two modes, one per hook:
#
# - `record` (PostToolUse on the laya routing tools) notes that this session
#   asked laya which model a job needs, in
#   `${XDG_STATE_HOME:-~/.local/state}/claude/agent-routes.jsonl`.
# - `gate` (PreToolUse on Agent and Task) lets a spawn through when it is
#   routed: it names a `model`, it is a `fork` (which keeps the parent's
#   model), its definition in `.claude/agents/` pins a `model`, or the
#   session recorded a routing call in the last 15 minutes.
#   Otherwise it denies the spawn, with the reason telling the agent how to
#   route it. `DYAI_AGENT_ROUTING=warn` allows and only adds that text;
#   `off`, or a crew worker (`DYAI_CREW` set), turns the gate off.
#
# Input that does not parse is let through: the gate must never wedge a
# session on garbage. `record` prints nothing and always exits 0.
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh" --modules json date \
  || {
    # Fail open, but say so: the gate is off until dybatpho loads again.
    printf 'route-agent: dybatpho failed to load, skipping the gate\n' >&2
    exit 0
  }
dybatpho::register_common_handlers
# A DRY_RUN exported for another tool must not turn this hook's writes into no-ops.
unset DRY_RUN DYBATPHO_DRY_RUN

mode="${1:-gate}"
dir="$(dybatpho::xdg_state_dir claude 2> /dev/null)" || exit 0
ledger="${dir}/agent-routes.jsonl"
input="$(cat)"
session="$(dybatpho::json_get "${input}" '.session_id // "" | strings' 2> /dev/null)" || exit 0
now="$(dybatpho::date_now)"

if [[ "${mode}" == record ]]; then
  [[ -n "${session}" ]] || exit 0
  (dybatpho::ensure_dir "${dir}") &> /dev/null || exit 0
  dybatpho::json_object ts:json "${now}" session "${session}" >> "${ledger}" 2> /dev/null || true
  exit 0
fi

routing="${DYAI_AGENT_ROUTING:-block}"
[[ "${routing}" != off && -z "${DYAI_CREW:-}" ]] || exit 0
routed="$(dybatpho::json_get "${input}" '(.tool_input.model // "" | strings | length > 0)
  or ((.tool_input.subagent_type // "") == "fork")' 2> /dev/null)" || exit 0
[[ "${routed}" != true ]] || exit 0
# A subagent whose definition pins a model (not `inherit`) is routed already.
agent="$(dybatpho::json_get "${input}" '.tool_input.subagent_type // "" | strings' 2> /dev/null)" || agent=""
if [[ "${agent}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  for def in "${CLAUDE_PROJECT_DIR:-${PWD}}/.claude/agents/${agent}.md" \
    "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/agents/${agent}.md"; do
    dybatpho::is file "${def}" || continue
    model="$(awk 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit }
      NR > 1 && sub(/^model:[ \t]*/, "") { gsub(/["\047 \t]/, ""); print; exit }' "${def}" 2> /dev/null)" || model=""
    [[ -z "${model}" || "${model}" == inherit ]] || exit 0
    break
  done
fi
if [[ -n "${session}" ]] && dybatpho::is file "${ledger}" \
  && jq -e --arg s "${session}" --argjson since "$((now - 900))" \
    'select(.session == $s and .ts >= $since)' "${ledger}" &> /dev/null; then
  exit 0
fi

reason="Pick the model for this subagent before spawning it: set model (haiku for search, lookups and"
reason+=" summaries, sonnet for routine coding, opus for review, security and design judgments), or call"
reason+=" laya_route first. A fork keeps your model and needs neither."
if [[ "${routing}" == warn ]]; then
  output="$(dybatpho::json_object hookEventName PreToolUse additionalContext "${reason}")"
else
  output="$(dybatpho::json_object hookEventName PreToolUse permissionDecision deny \
    permissionDecisionReason "${reason}")"
fi
dybatpho::json_object hookSpecificOutput:json "${output}"
exit 0
