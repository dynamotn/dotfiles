{{- $rules := includeTemplate "wm/rules.yaml.tmpl" . | fromYaml }}
{{- /* Bind the rules' bindings whose action is a key of $.actions, a Lua
       function expression. Keys follow the niri spelling of the rules */}}
{{- define "hammerspoonBindings" }}
{{-   $modifiers := dict "Mod" "cmd" "Ctrl" "ctrl" "Alt" "alt" "Shift" "shift" }}
{{-   range $.rules.bindings }}
{{-     if and (hasKey $.actions .action) (ne (get . "os") "linux") }}
{{-       $parts := splitList "+" .key }}
{{-       $chord := list }}
{{-       range $modifier := list "Mod" "Ctrl" "Alt" "Shift" }}
{{-         if has $modifier (initial $parts) }}
{{-           $chord = append $chord (printf "'%s'" (get $modifiers $modifier)) }}
{{-         end }}
{{-       end }}
hs.hotkey.bind({ {{ join ", " $chord }} }, '{{ last $parts | lower }}', {{ get $.actions .action }})
{{-     end }}
{{-   end }}
{{- end -}}
-- The `hs` command line client talks to this instance through hs.ipc; the
-- sketchybar click scripts and the chezmoi reload hook rely on it
require('hs.ipc')

local inputSource = require('input_source')
require('laptop')
require('monitor')
require('url_router')

-- Vicinae has no global hotkey of its own on macOS, so every launcher key
-- lives here and goes through its deeplinks
local vicinae = '/opt/homebrew/bin/vicinae'
local rbwPick = '{{ .chezmoi.homeDir }}/.local/bin/rbw-pick'

local function deeplink(link)
  return function()
    hs.task.new(vicinae, nil, { link }):start()
  end
end

-- rbw-pick shows the vault in Vicinae and prints the picked secret; typing it
-- from here keeps it off every command line. It is typed on the US layout, as
-- Telex would turn `dd` or `aa` in a password into `đ` or `â`
local function typeSecret(subcommand)
  return function()
    hs.task.new(rbwPick, function(exitCode, stdout, stderr)
      if exitCode ~= 0 then
        hs.alert.show('rbw-pick: ' .. (stderr ~= '' and stderr or 'failed'), 3)
        return
      end
      local secret = (stdout:gsub('\n$', ''))
      if secret ~= '' then
        inputSource.withEnglish(function()
          hs.eventtap.keyStrokes(secret)
        end)
      end
    end, { subcommand }):start()
  end
end

local function switchToEnglish()
  local success = hs.keycodes.currentSourceID(inputSource.english)

  if success then
    hs.alert.show('Keyboard: English', 1)
  else
    hs.alert.show('Error: Could not switch', 1)
  end
end

-- Generated from the bindings in home/.chezmoitemplates/wm/rules.yaml.tmpl
{{- template "hammerspoonBindings" (dict "rules" $rules "actions" (dict
  "launcher" "deeplink('vicinae://toggle')"
  "clipboard" "deeplink('vicinae://launch/clipboard/history')"
  "password" "typeSecret('password')"
  "totp" "typeSecret('totp')"
  "input-english" "switchToEnglish")) }}

{{- if eq .guiWinManager "O" }}
{{-   $browser := "" }}
{{-   if eq .browser "F" }}
{{-     $browser = "Firefox" }}
{{-   else if eq .browser "Z" }}
{{-     $browser = "Zen" }}
{{-   end }}
{{-   $mailClient := "" }}
{{-   if eq .mailClient "T" }}
{{-     $mailClient = "Thunderbird" }}
{{-   else if eq .mailClient "B" }}
{{-     $mailClient = "Betterbird" }}
{{-   end }}
{{-   $profile := $rules.profiles.main }}

-- OmniWM runs no command of its own, so the application keys and the
-- applications started at login, which aerospace.toml owns, live here
local function open(...)
  local args = { ... }
  return function()
    hs.task.new('/usr/bin/open', nil, args):start()
  end
end
{{    $apps := dict "terminal" "open('-na', 'kitty', '--args', 'zellij')" }}
{{-   with $rules.profiles.main }}
{{-     $_ := set $apps "browser" (printf "open('-na', '%s', '--args', '-P', '%s')" $browser .) }}
{{-     $_ := set $apps "mail" (printf "open('-na', '%s', '--args', '-P', '%s')" $mailClient .) }}
{{-   end }}
{{-   with $rules.profiles.other }}
{{-     $_ := set $apps "browser-other" (printf "open('-na', '%s', '--args', '-P', '%s')" $browser .) }}
{{-     $_ := set $apps "mail-other" (printf "open('-na', '%s', '--args', '-P', '%s')" $mailClient .) }}
{{-   end }}
{{-   template "hammerspoonBindings" (dict "rules" $rules "actions" $apps) }}

-- At login, Hammerspoon starts OmniWM and the usual applications. Every
-- config reload runs this file again, so only what is not running starts
hs.autoLaunch(true)
local startup = {
  { app = 'OmniWM', args = { '-a', 'OmniWM' } },
  { app = 'kitty', args = { '-na', 'kitty', '--args', 'zellij' } },
{{-   if $profile }}
  { app = '{{ $browser }}', args = { '-na', '{{ $browser }}', '--args', '-P', '{{ $profile }}' } },
  { app = '{{ $mailClient }}', args = { '-na', '{{ $mailClient }}', '--args', '-P', '{{ $profile }}' } },
{{-   end }}
  { app = 'Obsidian', args = { '-a', 'Obsidian' } },
}
for _, entry in ipairs(startup) do
  if not hs.application.get(entry.app) then
    open(table.unpack(entry.args))()
  end
end
{{- end }}
