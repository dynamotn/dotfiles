-- The `hs` command line client talks to this instance through hs.ipc; the
-- sketchybar click scripts and the chezmoi reload hook rely on it
require('hs.ipc')

local inputSource = require('input_source')
require('laptop')
require('monitor')
require('url_router')

-- Vicinae has no global hotkey of its own on macOS, so every launcher key
-- lives here and goes through its deeplinks
local vicinae = '/opt/homebrew/bin/vicinae'
local rbwPick = '{{ .chezmoi.homeDir }}/.local/bin/rbw-pick'

local function deeplink(link)
  return function()
    hs.task.new(vicinae, nil, { link }):start()
  end
end

-- rbw-pick shows the vault in Vicinae and prints the picked secret; typing it
-- from here keeps it off every command line. It is typed on the US layout, as
-- Telex would turn `dd` or `aa` in a password into `đ` or `â`
local function typeSecret(subcommand)
  return function()
    hs.task.new(rbwPick, function(exitCode, stdout, stderr)
      if exitCode ~= 0 then
        hs.alert.show('rbw-pick: ' .. (stderr ~= '' and stderr or 'failed'), 3)
        return
      end
      local secret = (stdout:gsub('\n$', ''))
      if secret ~= '' then
        inputSource.withEnglish(function()
          hs.eventtap.keyStrokes(secret)
        end)
      end
    end, { subcommand }):start()
  end
end

hs.hotkey.bind({ 'cmd' }, 'f2', deeplink('vicinae://toggle'))
hs.hotkey.bind({ 'cmd' }, 'j', deeplink('vicinae://launch/clipboard/history'))
hs.hotkey.bind({ 'cmd' }, 'p', typeSecret('password'))
hs.hotkey.bind({ 'cmd' }, 'o', typeSecret('totp'))

{{- if eq .guiWinManager "O" }}
