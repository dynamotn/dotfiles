{{- /* doc
name: stern
description: Multi pod and container log tailing for Kubernetes
category: DevOps tools
subcategory: Kubernetes and GitOps
order: 30
*/ -}}
name: stern
method: binary
github:
  repo: stern/stern
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch := .chezmoi.arch }}
  release_asset: stern_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: stern
