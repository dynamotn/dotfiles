{{- /* doc
name: smug
description: Tmux session manager
category: Everyday terminal applications
subcategory: Utilities
order: 80
*/ -}}
{{- if eq .terminalMultiplexer "T" }}
name: smug
method: binary
is_essential: true
github:
  repo: ivaaaan/smug
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- else if eq .chezmoi.os "linux" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: smug_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: smug
{{- end }}
