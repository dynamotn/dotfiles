{{- /* doc
name: xleak
description: TUI for view Excel files
category: Miscellaneous applications
subcategory: Office and data
order: 40
*/ -}}
name: xleak
method: binary
github:
  repo: bgreenwell/xleak
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64")) }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: xleak-{{ $arch }}-{{ $os }}.tar.xz
  sha256: sha256.sum
archive:
  - path: xleak-{{ $arch }}-{{ $os }}/xleak
    strip: 1
