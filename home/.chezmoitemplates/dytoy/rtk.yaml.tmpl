{{- /* doc
name: rtk
description: Proxy that reduces LLM token consumption
category: AI tools
subcategory: Models and agents
order: 110
*/ -}}
name: rtk
method: binary
github:
  repo: rtk-ai/rtk
  {{- $os := "" }}
  {{- if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: rtk-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: rtk
