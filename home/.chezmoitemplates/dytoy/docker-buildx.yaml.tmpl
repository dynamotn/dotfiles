{{- /* doc
name: docker-buildx
description: Extended build capabilities for Docker
category: DevOps tools
subcategory: Containers
order: 40
*/ -}}
{{- if ne .chezmoi.os "android" }}
# Can't use docker and container on non-rooted Android
name: docker-buildx
method: binary
github:
  repo: docker/buildx
  release_asset: buildx-%v.{{ .chezmoi.os }}-{{ .chezmoi.arch }}
  sha256: checksums.txt
location: {{ .chezmoi.homeDir }}/.docker/cli-plugins
{{- end }}
