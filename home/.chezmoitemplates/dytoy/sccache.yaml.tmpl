{{- /* doc
name: sccache
url: "https://github.com/mozilla/sccache"
description: Compiler cache shared by every Rust build and worktree
category: Development tools
subcategory: Utilities
order: 45
*/ -}}
name: sccache
{{- if eq .osid "linux-gentoo" }}
{{- /* Portage builds every Rust package through it (RUSTC_WRAPPER in
       make.conf), so it is installed with the essentials. */}}
method: os
is_essential: true
gentoo:
  packages:
    - name: dev-util/sccache
  hook:
    after: |-
      sccache_dir="/var/cache/sccache"
      sudo mkdir -p "$sccache_dir"
      sudo chown root:portage "$sccache_dir"
      sudo chmod 2775 "$sccache_dir"
{{- else }}
method: mise
dependencies:
  - rust
{{- end }}
