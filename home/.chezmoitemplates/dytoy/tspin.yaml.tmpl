{{- /* doc
name: tspin
description: "Alternative to `tail` with highlighter"
category: Everyday terminal applications
subcategory: Git and pagers
order: 70
*/ -}}
name: tspin
method: binary
is_essential: true
github:
  repo: bensadeh/tailspin
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: tailspin-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: tspin
