{{- /* doc
name: ntp
url: none
description: NTP client to sync system clock
category: System core tools
subcategory: Base
order: 30
*/ -}}
{{- if ne .kind "container" }}
name: ntp
method: os
# https://repology.org/project/ntp/versions
# https://repology.org/project/chrony/versions
is_essential: true
gentoo:
  {{- if eq .initSystem "openrc" }}
  # chronyd steps a large offset at start by itself (makestep): the one-shot
  # ntp-client only makes boot wait for the network. netmount waits for it
  # too, and nothing here is mounted over the network. net-misc/ntp is
  # masked for removal, so ntpd goes as well.
  packages:
    - name: net-misc/chrony
      service: chronyd
  {{- else if eq .initSystem "systemd" }}
  packages:
    - name:  sys-apps/systemd
      service: systemd-timesyncd
  {{- end }}
  hook:
    {{- if eq .initSystem "openrc" }}
    before: |-
      sudo rc-update del ntp-client default || true
      sudo rc-update del ntpd default || true
      sudo rc-update del netmount default || true
    {{- end }}
    after: |-
      {{- if eq .initSystem "systemd" }}
      sudo timedatectl set-ntp true
      sudo timedatectl set-local-rtc 1
      {{- end }}
      sudo hwclock --systohc
arch:
  packages:
    - name: systemd
      service: systemd-timesyncd
  hook:
    after: |-
      sudo timedatectl set-ntp true
      sudo timedatectl set-local-rtc 1
      sudo hwclock --systohc
ubuntu:
  packages:
    - name: systemd
      service: systemd-timesyncd
  hook:
    after: |-
      sudo timedatectl set-ntp true
      sudo timedatectl set-local-rtc 1
alpine:
  packages:
    - name: chrony
      service: chronyd
  hook:
    after: |-
      hwclock --systohc
termux: # Use system builtin time sync feature
macos: # Use system builtin time sync feature
{{- end }}
