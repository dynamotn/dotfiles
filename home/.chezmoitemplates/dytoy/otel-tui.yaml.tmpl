name: otel-tui
method: binary
github:
  repo: ymtdzzz/otel-tui
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.arch "amd64" }}
  {{-   $arch = "x86_64" }}
  {{- else if eq .chezmoi.arch "arm64" }}
  {{-   $arch = "arm64" }}
  {{- end }}
  release_asset: otel-tui_{{ $os }}_{{ $arch }}.tar.gz
  sha256: otel-tui_%1v_checksums.txt
archive:
  - path: otel-tui
