{{- /* doc
name: otel-tui
description: "TUI viewer for OpenTelemetry traces, metrics and logs"
category: DevOps tools
subcategory: Operations
order: 60
*/ -}}
name: otel-tui
method: binary
github:
  repo: ymtdzzz/otel-tui
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: otel-tui_{{ $os }}_{{ $arch }}.tar.gz
  sha256: otel-tui_%1v_checksums.txt
archive:
  - path: otel-tui
