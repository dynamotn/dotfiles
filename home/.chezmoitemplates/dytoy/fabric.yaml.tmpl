{{- /* doc
name: fabric
description: Framework for augmenting humans using AI
category: AI tools
subcategory: Models and agents
order: 20
*/ -}}
name: fabric
method: binary
{{- if eq .kind "pc" "laptop" }}
is_essential: true
{{- end }}
github:
  repo: danielmiessler/fabric
  {{- $os := "" }}
  {{- if eq .chezmoi.os "android" "linux" }}
  {{-   $os = "Linux" }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: fabric_{{ $os }}_{{ $arch }}.tar.gz
  sha256: fabric_%1v_checksums.txt
archive:
  - path: fabric
