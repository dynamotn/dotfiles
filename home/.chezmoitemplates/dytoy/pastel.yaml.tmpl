{{- /* doc
name: pastel
description: "Generate, manipulate, convert colors CLI tool"
category: Miscellaneous applications
subcategory: Utilities
order: 50
*/ -}}
name: pastel
{{- if eq .chezmoi.os "android" }}
method: os
# https://repology.org/project/pastel-sharkdp/versions
termux:
  packages:
    - name: pastel
{{- else }}
method: binary
github:
  repo: sharkdp/pastel
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  {{- $os := "" }}
  {{- if eq .chezmoi.os "linux" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64")) }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  release_asset: pastel-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: pastel-%v-{{ $arch }}-{{ $os }}/pastel
    strip: 1
  - path: pastel-%v-{{ $arch }}-{{ $os }}/autocomplete/pastel.fish
    location: {{ .chezmoi.homeDir }}/.config/fish/completions
    strip: 2
{{- end }}
