{{- /* doc
name: duf
description: "Alternative to `df` with colours..."
category: Everyday terminal applications
subcategory: Utilities
order: 150
*/ -}}
name: duf
method: binary
github:
  repo: muesli/duf
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset:  duf_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: duf
