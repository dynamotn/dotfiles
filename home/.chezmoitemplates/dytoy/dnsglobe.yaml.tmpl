{{- /* doc
name: dnsglobe
description: TUI to check global DNS propagation
category: Network tools
subcategory: Diagnostics
order: 80
*/ -}}
name: dnsglobe
method: binary
github:
  repo: 514-labs/dnsglobe
  {{- $os := "" }}
  {{- if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-gnu" }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: dnsglobe-{{ $arch }}-{{ $os }}.tar.xz
archive:
  - path: dnsglobe-{{ $arch }}-{{ $os }}/dnsglobe
    strip: 1
