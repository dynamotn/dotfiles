{{- /* doc
name: rmpc
description: "TUI client for Music Player Daemon, with Youtube support"
category: Miscellaneous applications
subcategory: Cheatsheets and media
order: 50
*/ -}}
{{- if .hasSound }}
name: rmpc
method: binary
github:
  repo: mierak/rmpc
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.arch "amd64" }}
  {{-   $arch = "x86_64" }}
  {{- else if eq .chezmoi.arch "arm64" }}
  {{-   $arch = "aarch64" }}
  {{- end }}
  release_asset: rmpc-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: rmpc
  - path: man/rmpc.1
    strip: 1
    location: {{ .chezmoi.homeDir }}/.local/man/man1
  - path: completions/rmpc.fish
    strip: 1
    location: {{ .chezmoi.homeDir }}/.config/fish/completions
{{- end }}
