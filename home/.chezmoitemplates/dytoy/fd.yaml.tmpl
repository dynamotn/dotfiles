{{- /* doc
name: fd
description: "Alternative to `find`, simpler and faster"
category: Everyday terminal applications
subcategory: Modern replacements
order: 10
*/ -}}
name: fd
is_essential: true
{{- if or (eq .chezmoi.os "android" "darwin") (eq .kind "container") }}
# Use package manager for Android, macOS and container environments
# cuz it's essential tool
method: os
# https://repology.org/project/fd-find/versions
arch:
  packages:
    - name: fd
ubuntu:
  packages:
    - name: rust-fd-find
alpine:
  packages:
    - name: fd
termux:
  packages:
    - name: fd
macos:
  packages:
    - name: fd
{{- else }}
method: binary
github:
  repo: sharkdp/fd
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  release_asset: fd-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: fd-%v-{{ $arch }}-{{ $os }}/fd
    strip: 1
  - path: fd-%v-{{ $arch }}-{{ $os }}/fd.1
    strip: 1
    location: {{ .chezmoi.homeDir }}/.local/man/man1
{{- end }}
