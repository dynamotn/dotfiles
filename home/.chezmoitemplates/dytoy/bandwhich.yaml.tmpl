{{- /* doc
name: bandwhich
description: CLI bandwidth utilization tool
category: Network tools
subcategory: Diagnostics
order: 60
*/ -}}
name: bandwhich
method: binary
github:
  repo: imsnif/bandwhich
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- else if eq .chezmoi.os "android" }}
  {{-   $os = "linux-android" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: bandwhich-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: bandwhich
{{- if eq .chezmoi.os "linux" }}
hook:
  after: |
    sudo setcap cap_sys_ptrace,cap_dac_read_search,cap_net_raw,cap_net_admin+ep "$(dybatpho::path_join "$HOME" ".local" "bin" "bandwhich")"
{{- end }}
