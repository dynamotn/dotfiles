{{- /* doc
name: vivid
description: A themeable LS_COLORS generator with database
category: Everyday terminal applications
subcategory: Utilities
order: 30
*/ -}}
name: vivid
is_essential: true
{{- if or (eq .chezmoi.os "android" "darwin") (eq .kind "container") }}
# Use package manager for Android, macOS and container environments
# cuz it's essential tool
method: os
# https://repology.org/project/vivid/versions
arch:
  packages:
    - name: vivid
termux:
  packages:
    - name: vivid
alpine:
  packages:
    - name: vivid
macos:
  packages:
    - name: vivid
{{- else }}
method: binary
github:
  repo: sharkdp/vivid
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64")) }}
  release_asset: vivid-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: vivid-%v-{{ $arch }}-{{ $os }}/vivid
    strip: 1
{{- end }}
