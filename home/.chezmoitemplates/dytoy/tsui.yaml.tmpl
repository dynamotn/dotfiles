{{- /* doc
name: tsui
description: TUI for Tailscale
category: Security tools
subcategory: Scanners
order: 60
*/ -}}
{{- if eq .chezmoi.os "linux" "darwin" }}
name: tsui
method: binary
is_essential: true
github:
  repo: neuralinkcorp/tsui
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "macos" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: tsui-{{ $os }}-{{ $arch }}
{{- end }}
