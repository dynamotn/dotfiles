{{- /* doc
name: trippy
description: CLI tool for network diagnostic
category: Network tools
subcategory: Diagnostics
order: 30
*/ -}}
name: trippy
method: binary
github:
  repo: fujiapple852/trippy
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- end }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: trippy-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: trippy-%v-{{ $arch }}-{{ $os }}/trip
    strip: 1
{{- if eq .chezmoi.os "linux" }}
hook:
  after: |-
    sudo setcap CAP_NET_RAW+p "$(dybatpho::path_join "$HOME" ".local" "bin" "trippy")"
{{- end }}
