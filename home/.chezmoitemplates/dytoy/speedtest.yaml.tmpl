{{- /* doc
name: speedtest
description: CLI to test Internet speed
category: Network tools
subcategory: Diagnostics
order: 90
*/ -}}
name: speedtest
method: binary
github:
  repo: showwin/speedtest-go
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: speedtest-go_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: speedtest-go
