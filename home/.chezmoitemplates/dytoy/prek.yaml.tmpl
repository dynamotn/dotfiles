{{- /* doc
name: prek
description: "Framework for manage pre-commit hooks, re-engineered in Rust"
category: Development tools
subcategory: Package managers
order: 30
*/ -}}
name: prek
method: binary
is_essential: true
github:
  repo: j178/prek
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- else }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: prek-{{ $arch }}-{{ $os }}.tar.gz
  sha256: prek-{{ $arch }}-{{ $os }}.tar.gz.sha256
archive:
  - path: prek-{{ $arch }}-{{ $os }}/prek
    strip: 1
