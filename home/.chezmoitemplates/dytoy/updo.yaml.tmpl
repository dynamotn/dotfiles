{{- /* doc
name: updo
description: Uptime monitoring CLI tool
category: DevOps tools
subcategory: Operations
order: 110
*/ -}}
name: updo
method: binary
github:
  repo: Owloops/updo
  {{- $os := "" }}
  {{- if eq .chezmoi.os "android" "linux" }}
  {{-   $os = "Linux" }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: updo_{{ $os }}_{{ $arch }}
  sha256: checksums.txt
