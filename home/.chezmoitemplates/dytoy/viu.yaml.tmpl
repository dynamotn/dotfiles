{{- /* doc
name: viu
description: View image on CLI
category: Miscellaneous applications
subcategory: Cheatsheets and media
order: 30
*/ -}}
name: viu
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
# Using Homebrew on Apple Silicon macos due to missing binary releases
method: os
macos:
  packages:
    - name: viu
{{- else }}
method: binary
github:
  repo: atanunq/viu
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: viu-{{ $arch }}-{{ $os }}
{{- end }}
