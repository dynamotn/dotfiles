{{- /* doc
name: viddy
description: "Alternative to `watch` with colours, diff, time machine..."
category: Everyday terminal applications
subcategory: Utilities
order: 130
*/ -}}
name: viddy
method: binary
github:
  repo: sachaos/viddy
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "macos" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: viddy-%v-{{ $os }}-{{ $arch }}.tar.gz
  sha256: viddy-%v-{{ $os }}-{{ $arch }}.sha256
archive:
  - path: viddy
