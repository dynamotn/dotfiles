{{- /* doc
name: pinentry
url: "https://www.gnupg.org/related_software/pinentry/"
description: "Prompt for the dybw master password, as pinentry-mac, pinentry-gnome3 or pinentry-curses to match the machine"
category: Everyday terminal applications
subcategory: Core
order: 30
*/ -}}
{{- /* The program is chosen once for this and dybw's config */ -}}
{{- $program := includeTemplate "pinentry/program.tmpl" . }}
name: pinentry
is_essential: true
method: os
# https://repology.org/project/pinentry/versions
macos:
  packages:
    - name: pinentry-mac
# pinentry-gnome3; on Gentoo it comes with the gtk USE flag, see package.use
gentoo:
  packages:
    - name: app-crypt/pinentry
arch:
  packages:
    - name: pinentry
ubuntu:
  packages:
    - name: {{ $program }}
alpine:
  packages:
    {{- if eq $program "pinentry-gnome3" }}
    - name: pinentry-gnome
    {{- else }}
    - name: pinentry
    {{- end }}
termux:
  packages:
    - name: pinentry
