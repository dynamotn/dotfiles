{{- /* doc
name: llmfit
description: TUI for models finding
category: AI tools
subcategory: Models and agents
order: 80
*/ -}}
name: llmfit
method: binary
github:
  repo: AlexsJones/llmfit
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: llmfit-%v-{{ $arch }}-{{ $os }}.tar.gz
  sha256: llmfit-%v-{{ $arch }}-{{ $os }}.tar.gz.sha256
archive:
  - path: llmfit-%v-{{ $arch }}-{{ $os }}/llmfit
    strip: 1
