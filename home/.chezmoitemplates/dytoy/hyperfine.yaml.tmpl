{{- /* doc
name: hyperfine
description: Benchmarking tool for CLI apps
category: Miscellaneous applications
subcategory: Utilities
order: 10
*/ -}}
name: hyperfine
{{- if eq .chezmoi.os "android" "darwin" }}
# Use package manager for Android, macOS
method: os
# https://repology.org/project/hyperfine/versions
termux:
  packages:
    - name: hyperfine
macos:
  packages:
    - name: hyperfine
{{- else }}
method: binary
github:
  repo: sharkdp/hyperfine
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  release_asset: hyperfine-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: hyperfine-%v-{{ $arch }}-{{ $os }}/hyperfine
    strip: 1
  - path: hyperfine-%v-{{ $arch }}-{{ $os }}/hyperfine.1
    strip: 1
    location: {{ .chezmoi.homeDir }}/.local/man/man1
  - path: hyperfine-%v-{{ $arch }}-{{ $os }}/autocomplete/hyperfine.fish
    location: {{ .chezmoi.homeDir }}/.config/fish/completions
    strip: 2
{{- end }}
