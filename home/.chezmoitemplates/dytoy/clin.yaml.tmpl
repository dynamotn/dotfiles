{{- /* doc
name: clin
description: TUI for Obsidian notes
category: Everyday terminal applications
subcategory: Utilities
order: 230
*/ -}}
name: clin
method: binary
is_essential: true
github:
  repo: reekta92/clin-rs
  {{- $os := "" }}
  {{- if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-gnu" }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: clin-rs-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: clin
