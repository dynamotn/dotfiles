{{- /* doc
name: matcha
description: Daily digest generator for RSS feeds and Google News with LLM
category: Miscellaneous applications
subcategory: Utilities
order: 40
*/ -}}
name: matcha
{{- if or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64")) }}
# Only have release binary on macOS or Linux AMD64
method: binary
github:
  repo: piqoni/matcha
  release_asset: matcha-{{ .chezmoi.os }}-{{ .chezmoi.arch }}
{{- else }}
method: mise
backend: go:github.com/piqoni/matcha
dependencies:
  - go
{{- end }}
