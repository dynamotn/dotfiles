{{- /* doc
name: docker-compose
description: Run multi-container applications
category: DevOps tools
subcategory: Containers
order: 30
*/ -}}
{{- if ne .chezmoi.os "android" }}
# Can't use docker and container on non-rooted Android
name: docker-compose
method: binary
github:
  repo: docker/compose
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: docker-compose-{{ .chezmoi.os }}-{{ $arch }}
  sha256: checksums.txt
{{- end }}
hook:
  after: |-
    completion_path="$(dybatpho::path_join "$HOME" ".config" "fish" "completions" "docker-compose.fish")"
    mkdir -p "$(dybatpho::path_dirname "$completion_path")"
    dybatpho::curl_download https://raw.githubusercontent.com/brgmnn/fish-docker-compose/refs/heads/master/completions/docker-compose.fish "$completion_path"
