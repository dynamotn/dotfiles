{{- if ne .chezmoi.os "android" }}
# Can't use docker and container on non-rooted Android
name: diffoci
method: binary
github:
  repo: reproducible-containers/diffoci
  release_asset: diffoci-%v.{{ .chezmoi.os }}-{{ .chezmoi.arch }}
  sha256: SHA256SUMS
{{- end }}
