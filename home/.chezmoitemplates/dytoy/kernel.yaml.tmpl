{{- /* doc
name: kernel
url: "https://github.com/torvalds/linux"
description: Linux kernel for OS
category: System core tools
subcategory: Base
order: 10
*/ -}}
{{- if ne .kind "container" }}
name: kernel
method: os
is_essential: true
gentoo:
  packages:
    - name: sys-kernel/installkernel
    {{- if has .code .gentooSourcesMachines }}
    # Configured and built by scripts/kernel.sh, see docs/kernel.md
    - name: sys-kernel/gentoo-sources
    {{- else }}
    - name: sys-kernel/gentoo-kernel
    {{- end }}
    - name: sys-kernel/linux-firmware
    - name: sys-kernel/modprobed-db
arch:
  packages:
    - name: linux-hardened
    - name: linux-hardened-headers
    - name: linux-firmware
# TODO: need to specify kernel packages for Ubuntu, Alpine
termux: # Use system kernel
macos: # Use system kernel
{{- end }}
