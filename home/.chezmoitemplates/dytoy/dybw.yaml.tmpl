{{- /* doc
name: dybw
url: "https://github.com/dynamotn/dybw"
description: "Bitwarden CLI and agent; `rbw` is a link to its rbw shim"
category: Everyday terminal applications
subcategory: Core
order: 20
*/ -}}
{{- /* Not on Termux nor in containers: dybw needs macOS or Linux with a
       pinentry, and those machines keep no vault at all. */ -}}
{{- if and (ne .chezmoi.os "android") (ne .kind "container") }}
{{- /* The release builds there are: Linux (musl, static) on amd64 and
       arm64, macOS on Apple silicon only. */}}
{{- $target := "" }}
{{- if eq .chezmoi.os "linux" }}
{{-   with includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
{{-     $target = printf "%s-linux-musl" . }}
{{-   end }}
{{- else if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
{{-   $target = "aarch64-apple-darwin" }}
{{- end }}
name: dybw
is_essential: true
{{- if $target }}
method: binary
dependencies:
  - pinentry
# Both binaries into one directory, see dybw/root.tmpl: /opt/homebrew/bin on
# macOS, ~/.local/bin on Linux.
location: {{ includeTemplate "dybw/root.tmpl" . }}/bin
github:
  repo: dynamotn/dybw
  # Pinned to a tag, so dytoy never asks for the latest release (which would
  # skip this prerelease). To bump: set the new tag here and apply; the
  # changed definition makes dytoy download dybw again
  # (`dytoy binary --no-check-installed -t dybw` by hand). Then restart the
  # agent service so it runs the new binary.
  version: v1.0.0-rc.1
  release_asset: dybw-%1v-{{ $target }}.tar.gz
  # Each asset has its own `<asset>.sha256` next to it
  sha256: dybw-%1v-{{ $target }}.tar.gz.sha256
archive:
  - path: dybw
  - path: dybw-agent
{{- else }}
# No dybw release for {{ .chezmoi.os }}/{{ .chezmoi.arch }}: fail the install
# rather than leave the vault behind without a word.
method: shell
content: |-
  dybatpho::die "dybw publishes no build for {{ .chezmoi.os }}/{{ .chezmoi.arch }}, only Linux amd64/arm64 and macOS arm64"
{{- end }}
{{- end }}
