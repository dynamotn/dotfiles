{{- /* doc
name: websocat
description: "Netcat, curl and socat for websocket"
category: Network tools
subcategory: Diagnostics
order: 100
*/ -}}
name: websocat
method: binary
github:
  repo: vi/websocat
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- end }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: websocat.{{ $arch }}-{{ $os }}
