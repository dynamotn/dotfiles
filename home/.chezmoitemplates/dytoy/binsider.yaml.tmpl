{{- /* doc
name: binsider
description: Reverse engineering tool to analyze ELF binaries
category: Security tools
subcategory: Code and binaries
order: 20
*/ -}}
name: binsider
method: binary
github:
  repo: orhun/binsider
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: binsider-%1v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: binsider-%1v/binsider
    strip: 1
