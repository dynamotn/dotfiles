{{- /* doc
name: helm-docs
description: Generate documents for Helm chart
category: DevOps tools
subcategory: Kubernetes and GitOps
order: 60
*/ -}}
name: helm-docs
method: binary
github:
  repo: norwoodj/helm-docs
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: helm-docs_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: helm-docs
