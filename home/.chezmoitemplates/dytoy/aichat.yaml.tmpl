{{- /* doc
name: aichat
description: All-in-one LLM CLI tool
category: AI tools
subcategory: Models and agents
order: 30
*/ -}}
name: aichat
method: binary
github:
  repo: sigoden/aichat
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: aichat-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: aichat
