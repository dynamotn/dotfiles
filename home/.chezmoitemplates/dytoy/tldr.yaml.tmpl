{{- /* doc
name: tldr
description: Cheatsheet CLI tool
category: Miscellaneous applications
subcategory: Cheatsheets and media
order: 10
*/ -}}
name: tldr
is_essential: true
{{- if and (eq .kind "container") (eq .chezmoi.os "linux-arch") }}
# Use package only on Archlinux container
method: os
# https://repology.org/project/tealdeer/versions
arch:
  packages:
    - name: tealdeer
{{- else }}
method: binary
github:
  repo: dbrgn/tealdeer
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  {{- $variant := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $variant = printf "macos-%s" $arch }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $variant = printf "linux-%s-musl" $arch }}
  {{- end }}
  release_asset: tealdeer-{{ $variant }}
  sha256: tealdeer-{{ $variant }}.sha256
{{- end }}
