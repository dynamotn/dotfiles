# https://repology.org/project/obsidian/versions
is_essential: true
gentoo:
  packages:
    - name: app-office/obsidian
      repo: dynamo
      url: https://gitlab.com/dynamo-config/distro/gentoo-overlay.git
arch:
  packages:
    - name: obsidian
termux: # TODO: need to get from FDroid
macos:
  packages:
    - name: obsidian
      type: cask
{{- end }}
