{{- /* doc
name: dust
description: "Alternative to `du` with more intuitive"
category: Everyday terminal applications
subcategory: Utilities
order: 140
*/ -}}
name: dust
{{- if eq .chezmoi.os "darwin" }}
# Binary file is not available for macOS, use Homebrew instead.
method: os
# https://repology.org/project/dust/versions
macos:
  packages:
    - name: dust
{{- else if eq .chezmoi.os "linux" "android" }}
method: binary
github:
  repo: bootandy/dust
  {{- $os := "" }}
  {{- if eq .chezmoi.os "linux" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- else if eq .chezmoi.os "android" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: dust-%v-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: dust-%v-{{ $arch }}-{{ $os }}/dust
    strip: 1
{{- end }}
