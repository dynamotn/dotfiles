{{- /* doc
name: ouch
description: CLI tool to compress and decompress files with various formats
category: Everyday terminal applications
subcategory: Utilities
order: 240
*/ -}}
name: ouch
method: binary
is_essential: true
github:
  repo: ouch-org/ouch
  {{- $os := "" }}
  {{- if eq .chezmoi.os "linux" "android" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- else if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: ouch-{{ $arch }}-{{ $os }}.tar.gz
archive:
  - path: ouch-{{ $arch }}-{{ $os }}/ouch
    strip: 1
  - path: ouch-{{ $arch }}-{{ $os }}/man/ouch*.1
    strip: 2
    location: {{ .chezmoi.homeDir }}/.local/man/man1
  - path: ouch-{{ $arch }}-{{ $os }}/completions/ouch.fish
    strip: 2
    location: {{ .chezmoi.homeDir }}/.config/fish/completions
