{{- /* doc
name: scc
description: Display statistics about code
category: Development tools
subcategory: Utilities
order: 30
*/ -}}
name: scc
method: binary
github:
  repo: boyter/scc
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "Darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: scc_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: scc
