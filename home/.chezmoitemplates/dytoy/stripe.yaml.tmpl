{{- /* doc
name: stripe
description: "CLI to build, test Stripe integration"
category: Development tools
subcategory: CLI tools
order: 50
*/ -}}
name: stripe
method: binary
github:
  repo: stripe/stripe-cli
  {{- $os := "" }}
  {{- $os_checksum_type := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "mac-os" }}
  {{-   $os_checksum_type = "mac" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "linux" }}
  {{-   $os_checksum_type = "linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: stripe_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: stripe-{{ $os_checksum_type }}-checksums.txt
archive:
  - path: stripe
