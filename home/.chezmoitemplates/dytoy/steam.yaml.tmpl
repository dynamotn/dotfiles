{{- if eq .osid "linux-gentoo" "linux-arch" "darwin" }}
# I play games only on Gentoo, Arch, or macOS
name: steam
method: os
gentoo:
  packages:
    - name: games-util/game-device-udev-rules
arch:
  packages:
    - name: game-devices-udev
macos:
  packages:
    - name: steam
  {{- if eq .chezmoi.arch "arm64" }}
  need_rosetta: true
  {{- end }}
flatpak:
  packages:
    - name: com.valvesoftware.Steam
      repo: flathub
    - name: com.valvesoftware.Steam.CompatibilityTool.Proton-GE
      repo: flathub
  hook:
    after: |
      flatpak permission-set background background com.valvesoftware.Steam yes
      # Let Proton-GE draw games through Wine's Wayland driver instead of XWayland
      flatpak override --user --env=PROTON_ENABLE_WAYLAND=1 com.valvesoftware.Steam
{{- end }}
