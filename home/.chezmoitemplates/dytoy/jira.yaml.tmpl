{{- /* doc
name: jira
description: Interactive CLI tool with JIRA
category: Everyday terminal applications
subcategory: Utilities
order: 200
*/ -}}
name: jira
method: binary
github:
  repo: ankitpokhrel/jira-cli
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "macOS" }}
  {{- else if eq .chezmoi.os "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: jira_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: checksums.txt
archive:
  - path: jira_%1v_{{ $os }}_{{ $arch }}/bin/jira
    strip: 2
