{{- /* doc
name: taws
description: Interactive TUI AWS services
category: DevOps tools
subcategory: Cloud CLIs
order: 50
*/ -}}
name: taws
method: binary
github:
  repo: huseyinbabal/taws
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" }}
  {{-   $os = "unknown-linux-musl" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: taws-{{ $arch }}-{{ $os }}.tar.gz
  sha256: checksums.txt
archive:
  - path: taws
