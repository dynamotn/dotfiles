{{- /* doc
name: fly
description: CLI tool for cloud application on fly.io with container
category: DevOps tools
subcategory: Cloud and IaC
order: 10
*/ -}}
name: fly
method: binary
github:
  repo: superfly/flyctl
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "macOS" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = "Linux" }}
  {{- end }}
  {{- if eq .chezmoi.arch "amd64" }}
  {{-   $arch = "x86_64" }}
  {{- else if eq .chezmoi.arch "arm64" }}
  {{-   $arch = "arm64" }}
  {{- end }}
  release_asset: flyctl_%1v_{{ $os }}_{{ $arch }}.tar.gz
  sha256: flyctl_%1v_checksums.txt
archive:
  - path: flyctl
