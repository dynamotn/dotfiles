{{- /* doc
name: infracost
description: Estimate cost of cloud infra via Terraform
category: DevOps tools
subcategory: Operations
order: 80
*/ -}}
name: infracost
method: binary
github:
  repo: infracost/infracost
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  release_asset: infracost-{{ $os }}-{{ .chezmoi.arch }}.tar.gz
  sha256: infracost-{{ $os }}-{{ .chezmoi.arch }}.tar.gz.sha256
archive:
  - path: infracost-{{ $os }}-{{ .chezmoi.arch }}
