{{- /* doc
name: watchexec
description: Detects modifications and run command
category: Development tools
subcategory: CLI tools
order: 10
*/ -}}
name: watchexec
is_essential: true
{{- if or (eq .chezmoi.os "android" "darwin") (eq .kind "container") }}
# Use package manager for Android, macOS and container environments
# cuz it's essential tool
method: os
# https://repology.org/project/watchexec/versions
arch:
  packages:
    - name: watchexec
termux:
  packages:
    - name: watchexec
alpine:
  packages:
    - name: watchexec
macos:
  packages:
    - name: watchexec
{{- else }}
method: binary
github:
  repo: watchexec/watchexec
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  release_asset: watchexec-%1v-{{ $arch }}-{{ $os }}.tar.xz
  sha256: SHA256SUMS
archive:
  - path: watchexec-%1v-{{ $arch }}-{{ $os }}/watchexec
    strip: 1
  - path: watchexec-%1v-{{ $arch }}-{{ $os }}/watchexec.1
    strip: 1
    location: {{ .chezmoi.homeDir }}/.local/man/man1
{{- end }}
