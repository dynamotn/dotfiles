name: hunk
method: binary
github:
  repo: modem-dev/hunk
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.arch "amd64" }}
  {{-   $arch = "x64" }}
  {{- else if eq .chezmoi.arch "arm64" }}
  {{-   $arch = "arm64" }}
  {{- end }}
  release_asset: hunkdiff-{{ $os }}-{{ $arch }}.tar.gz
archive:
  - path: hunkdiff-linux-x64/hunk
    strip: 1
  - path: hunkdiff-linux-x64/metadata.json
    location: {{ .chezmoi.homeDir }}/.hunk
    strip: 1
  - path: hunkdiff-linux-x64/skills
    location: {{ .chezmoi.homeDir }}/.hunk
    strip: 1
