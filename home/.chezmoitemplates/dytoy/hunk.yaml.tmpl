{{- /* doc
name: hunk
description: Review-first diff viewer for git
category: Everyday terminal applications
subcategory: Git and pagers
order: 40
*/ -}}
name: hunk
method: binary
github:
  repo: modem-dev/hunk
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.arch "amd64" }}
  {{-   $arch = "x64" }}
  {{- else if eq .chezmoi.arch "arm64" }}
  {{-   $arch = "arm64" }}
  {{- end }}
  release_asset: hunkdiff-{{ $os }}-{{ $arch }}.tar.gz
archive:
  - path: hunkdiff-{{ $os }}-{{ $arch }}/hunk
    strip: 1
  - path: hunkdiff-{{ $os }}-{{ $arch }}/metadata.json
    location: {{ .chezmoi.homeDir }}/.hunk
    strip: 1
  - path: hunkdiff-{{ $os }}-{{ $arch }}/skills
    location: {{ .chezmoi.homeDir }}/.hunk
    strip: 1
