{{- if eq .guiWinManager "H" }}
name: hyprland
method: os
# https://repology.org/project/hyprland/versions
is_essential: true
gentoo:
  packages:
    - name: gui-wm/hyprland
      repo: hyproverlay
      url: https://codeberg.org/hyproverlay/hyproverlay.git
    - name: x11-libs/xcb-util
    - name: gui-libs/xdg-desktop-portal-wlr
arch:
  packages:
    {{- if eq .guiDriver "N" }}
    - name: hyprland-nvidia
      version: HEAD
    {{- else }}
    - name: hyprland
    {{- end }}
    - name: xdg-desktop-portal-wlr
    - name: xdg-desktop-portal-hyprland
    - name: cpio
    - name: cmake
    - name: meson
ubuntu: # Not have package on LTS version
{{- else if eq .guiWinManager "N" }}
name: niri
method: os
# https://repology.org/project/niri/versions
is_essential: true
gentoo:
  packages:
    - name: gui-wm/niri
      repo: guru
      url: https://github.com/gentoo-mirror/guru.git
    - name: sys-apps/xdg-desktop-portal-gnome
arch:
  packages:
    - name: niri
    - name: xdg-desktop-portal-gnome
    - name: xdg-desktop-portal-gtk
ubuntu: # Not have package on LTS version
{{- else if eq .guiWinManager "A" }}
name: aerospace
is_essential: true
method: os
macos:
  packages:
    - name: aerospace
      type: cask
      repo: nikitabobko/tap
      service: Aerospace
      is_user_service: true
    - name: autoraise
      version: HEAD
      repo: dimentium/autoraise
      service: autoraise
{{- else if eq .guiWinManager "O" }}
# Started at login by Hammerspoon; ~/.config/omniwm/settings.toml is its config
name: omniwm
is_essential: true
method: os
macos:
  packages:
    - name: omniwm
      type: cask
{{- end }}
