{{- /* doc
name: procs
description: "Alternative to `ps` with colours, tree view..."
category: Everyday terminal applications
subcategory: Utilities
order: 110
*/ -}}
name: procs
{{- if eq .chezmoi.os "android" }}
method: os
# https://repology.org/project/procs/versions
termux:
  packages:
    - name: procs
{{- else }}
method: binary
github:
  repo: dalance/procs
  {{- $os := "" }}
  {{- $arch := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "mac" }}
  {{- else if eq .chezmoi.os "linux" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: procs-%v-{{ $arch }}-{{ $os }}.zip
archive:
  - path: procs
{{- end }}
