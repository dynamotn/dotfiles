{{- if not (empty .languages) }}
name: fcitx5
method: os
# https://repology.org/project/fcitx5-configtool/versions
# https://repology.org/project/fcitx5-lotus/versions
# https://repology.org/project/fcitx5-bamboo/versions
# https://repology.org/project/fcitx5-chinese-addons/versions
# https://repology.org/project/fcitx5-m17n/versions
# https://repology.org/project/mozc/versions
is_essential: true
gentoo:
  packages:
    - name: app-i18n/fcitx-configtool
    {{- if has "vi" .languages }}
    - name: app-i18n/fcitx-lotus
      repo: dynamo
      url: https://gitlab.com/dynamo-config/distro/gentoo-overlay.git
    {{- end }}
    {{- if has "ja" .languages }}
    - name: app-i18n/mozc
    {{- end }}
    {{- if has "zh" .languages }}
    - name: app-i18n/fcitx-chinese-addon
    - name: app-i18n/fcitx-m17n
    {{- end }}
  {{- if has "vi" .languages }}
  hook:
    after: |-
      {{- if eq .initSystem "openrc" }}
      # The bare service refuses to start, only a per-user link runs the server.
      if [[ -e /etc/runlevels/default/fcitx5-lotus ]]; then
        sudo rc-update del fcitx5-lotus default
      fi
      sudo ln -sfn /etc/init.d/fcitx5-lotus "/etc/init.d/fcitx5-lotus.${USER}"
      if [[ ! -e "/etc/runlevels/default/fcitx5-lotus.${USER}" ]]; then
        sudo rc-update add "fcitx5-lotus.${USER}" default
      fi
      sudo rc-service "fcitx5-lotus.${USER}" restart
      {{- else if eq .initSystem "systemd" }}
      sudo systemctl enable --now "fcitx5-lotus-server@${USER}.service"
      {{- end }}
  {{- end }}
arch:
  packages:
    - name: fcitx5-configtool
    {{- if has "vi" .languages }}
    - name: fcitx5-lotus
    {{- end }}
    {{- if has "ja" .languages }}
    - name: fcitx5-mozc
    {{- end }}
    {{- if has "zh" .languages }}
    - name: fcitx5-chinese-addons
    - name: fcitx5-m17n
    {{- end }}
  {{- if has "vi" .languages }}
  hook:
    after: |-
      sudo systemctl enable --now "fcitx5-lotus-server@${USER}.service"
  {{- end }}
ubuntu:
  packages:
    - name: fcitx5-configtool
    {{- if has "vi" .languages }}
    - name: fcitx5-lotus
      repo: https://fcitx5-lotus.pages.dev/apt/%v
      components: main
      key: https://fcitx5-lotus.pages.dev/pubkey.gpg
    {{- end }}
    {{- if has "ja" .languages }}
    - name: fcitx5-mozc
    {{- end }}
    {{- if has "zh" .languages }}
    - name: fcitx5-chinese-addons
    - name: fcitx5-m17n
    {{- end }}
  {{- if has "vi" .languages }}
  hook:
    after: |-
      sudo systemctl enable --now "fcitx5-lotus-server@${USER}.service"
  {{- end }}
alpine:
  packages:
    - name: fcitx5-configtool
    {{- if has "vi" .languages }}
    - name: fcitx5-bamboo
    {{- end }}
    {{- if has "ja" .languages }}
    - name: fcitx5-mozc
    {{- end }}
    {{- if has "zh" .languages }}
    - name: fcitx5-chinese-addons
    - name: fcitx5-m17n
    {{- end }}
termux: # Use Fdroid
macos: # use buitin input
fdroid:
  packages:
    - name: org.fcitx.fcitx5.android
    {{- if has "vi" .languages }}
    - name: org.fcitx.fcitx5.android.plugin.unikey
    {{- end }}
    {{- if has "ja" .languages }}
    - name: org.fcitx.fcitx5.android.plugin.anthy
    {{- end }}
{{- end }}
