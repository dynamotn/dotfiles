{{- /* doc
name: neovim
url: "https://github.com/neovim/neovim"
description: "My love editor, and IDE in my eyes"
category: Everyday terminal applications
subcategory: Core
order: 10
*/ -}}
name: neovim
is_essential: true
{{- if ne .osid "linux-ubuntu" }}
# I need version 0.11 and Ubuntu not have
method: os
# https://repology.org/project/neovim/versions
gentoo:
  packages:
    - name: app-editors/neovim
arch:
  packages:
    - name: neovim
      version: HEAD
alpine:
  packages:
    - name: neovim
termux:
  packages:
    - name: neovim
    - name: tree-sitter
macos:
  packages:
    - name: neovim
      version: HEAD
{{- else }}
method: mise
{{- end }}
