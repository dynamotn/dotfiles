{{- /* doc
name: hl
description: Log viewer and processor that translates JSON or logfmt logs into a pretty human-readable format
category: DevOps tools
subcategory: Operations
order: 40
*/ -}}
name: hl
method: binary
github:
  repo: pamburus/hl
  {{- $variant := "" }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $variant = printf "macos-%s" $arch }}
  {{- else if eq .chezmoi.os "linux" }}
  {{-   $variant = printf "linux-%s-gnu" $arch }}
  {{- else if eq .chezmoi.os "android" }}
  {{-   $variant = printf "linux-%s-musl" $arch }}
  {{- end }}
  release_asset: hl-{{ $variant }}.tar.gz
archive:
  - path: hl
