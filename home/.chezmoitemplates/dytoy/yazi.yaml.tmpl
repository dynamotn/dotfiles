{{- /* doc
name: yazi
description: TUI file manager
category: Everyday terminal applications
subcategory: Utilities
order: 190
*/ -}}
name: yazi
method: binary
github:
  repo: sxyazi/yazi
  {{- $os := includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: yazi-{{ $arch }}-{{ $os }}.zip
archive:
  - path: yazi-{{ $arch }}-{{ $os }}/yazi
    strip: 1
  - path: yazi-{{ $arch }}-{{ $os }}/ya
    strip: 1
  - path: yazi-{{ $arch }}-{{ $os }}/completions/yazi.fish
    strip: 2
    location: {{ .chezmoi.homeDir }}/.config/fish/completions
  - path: yazi-{{ $arch }}-{{ $os }}/completions/ya.fish
    strip: 2
    location: {{ .chezmoi.homeDir }}/.config/fish/completions
hook:
  after: |-
    ya pkg add yazi-rs/plugins:piper yazi-rs/plugins:git ndtoan96/ouch || :
