{{- if ne .osid "android" }}
{{- /* Harness² optimises the "harness" around a language model. Despite the
       README documenting an editable clone for development, it is a plain
       PEP 517 package (setuptools) whose console scripts (harness2-demo and
       the rest) and its 'render' extra install straight from the git source,
       so mise installs it from git through uv instead of cloning. The
       repository is untagged, so this tracks the default branch, and it
       requires Python <3.14, hence the pinned 3.12. The model-backed
       benchmarks additionally need Node 20+, gcloud and Vertex AI
       credentials, set up separately; the local demo runs without them. */ -}}
name: harness2
method: mise
backend: pipx:git+https://github.com/google-research/harness2.git
version: main
params:
  - --tool-option=extras=render
  - --tool-option=uvx_args=--python 3.12
dependencies:
  - uv
{{- end }}
