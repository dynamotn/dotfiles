{{- /* doc
name: grub
url: "https://www.gnu.org/software/grub/"
description: Bootloader for system
category: System core tools
subcategory: Base
order: 50
*/ -}}
{{- if and (eq .chezmoi.os "linux") (ne .kind "container") }}
name: grub
method: os
# https://repology.org/project/grub/versions
is_essential: true
gentoo:
  packages:
    - name: sys-boot/grub
arch:
  packages:
    - name: grub
    {{- if and (eq .kind "laptop") (eq .place "office") }}
    - name: sbsigntools
    {{- end }}
ubuntu:
  packages:
    - name: grub2
alpine:
  packages:
    - name: grub
{{- end }}
