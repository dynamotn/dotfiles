{{- /* doc
name: doggo
description: "Alternative to `dig`"
category: Network tools
subcategory: Diagnostics
order: 70
*/ -}}
name: doggo
is_essential: true
method: binary
github:
  repo: mr-karan/doggo
  {{- $os := .chezmoi.os }}
  {{- if eq .chezmoi.os "android" }}
  {{-   $os = "linux" }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "arm64") }}
  release_asset: doggo-{{ $os }}-{{ $arch }}.tar.gz
  sha256: doggo_%1v_checksums.txt
archive:
  - path: doggo
