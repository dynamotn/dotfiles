{{- /* doc
name: gws
description: "CLI for Google Workspace, use Google API Discovery Service"
category: Miscellaneous applications
subcategory: Office and data
order: 60
*/ -}}
name: gws
method: binary
github:
  repo: googleworkspace/cli
  {{- $os := "" }}
  {{- if eq .chezmoi.os "darwin" }}
  {{-   $os = "apple-darwin" }}
  {{- else if eq .chezmoi.os "linux" "android" }}
  {{-   $os = includeTemplate "dytoy_lib/linux_target.tmpl" (dict "ctx" . "musl" (list "amd64" "arm64")) }}
  {{- end }}
  {{- $arch := "" }}
  {{- $arch = includeTemplate "dytoy_lib/arch.tmpl" (dict "ctx" . "arm" "aarch64") }}
  release_asset: google-workspace-cli-{{ $arch }}-{{ $os }}.tar.gz
  sha256: google-workspace-cli-{{ $arch }}-{{ $os }}.tar.gz.sha256
archive:
  - path: gws
