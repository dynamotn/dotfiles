workspaces:
  - name: term
    icon: ""
    persistent: true
    default: true
  - name: web
    icon: ""
    persistent: true
  - name: mail
    icon: ""
    persistent: true
  - name: doc
    icon: ""
    persistent: true
  - name: chat
    icon: ""
    persistent: true
  - name: media
    icon: ""
    persistent: true
  - name: game
    icon: ""
    persistent: true
  - name: sys
    icon: ""
    persistent: true
  - name: misc
    icon: ""
    persistent: true
  - name: sec
    icon: ""
    persistent: true
tags:
  - name: term
    classes:
      - ^(kitty)$
    workspace: term
  - name: browser
    classes:
      - ^([Ff]irefox(|-esr)|org.mozilla.firefox|[Ff]irefox)$
      - ^([Zz]en)$
      - ^([Gg]oogle-chrome(-beta|-dev|-unstable)?)$
      - ^(chrome-.+-Default)$ # Chrome PWAs
      - ^(Vivaldi.+)$
    workspace: web
  - name: email
    classes:
      - ^([Tt]hunderbird(|-esr)|org.mozilla.[Tt]hunderbird|org.gnome.Evolution)$
      - ^eu.betterbird.[Bb]etterbird$
    workspace: mail
  - name: note
    classes:
      - ^(obsidian|md(.obsidian).Obsidian)$
    workspace: doc
  - name: viewer
    classes:
      - ^(evince)$ # document viewer
      - ^(eog|org.gnome.Loupe)$ # image viewer
    workspace: doc
    float: true
  - name: office
    classes:
      - ^(et|wps|wpp)$ # WPS
      - ^(libreoffice.*)$ # LibreOffice
    workspace: doc
  - name: im
    classes:
      - ^([Dd]iscord|[Ww]ebCord|[Vv]esktop)$
      - ^([Ff]erdium)$
      - ^([Ww]hatsapp-for-linux)$
      - ^(org.telegram.desktop|io.github.tdesktop_x64.TDesktop)$
      - ^(teams-for-linux)$
    workspace: chat
  - name: video
    classes:
      - ^(mpv)$
    workspace: media
  - name: game
    classes:
      - ^(gamescope)$
      - ^(steam_app_\d+)$
    workspace: game
    fullscreen: true
  - name: gamestore
    classes:
      - ^([Ss]team)$
      - ^(net.lutris.Lutris)$
      - ^(com.heroicgameslauncher.hgl)$
    workspace: game
  - name: remote
    classes:
      - ^([Vv]mware-view)$
      - ^([Rr]ustdesk)$
      - ^(org.remmina.Remmina)$
    workspace: sys
  - name: file-manager
    classes:
      - ^([Tt]hunar|org.gnome.Nautilus|[Pp]cmanfm-qt)$
      - ^(app.drey.Warp)$
    workspace: sys
  - name: settings
    classes:
      - ^(file-roller|org.gnome.FileRoller)$ # archive manager
      - ^(nm-applet|nm-connection-editor|blueman-manager)$
      - ^(pavucontrol|org.pulseaudio.pavucontrol|com.saivert.pwvucontrol)$
      - ^(dev.noctalia.Noctalia)$ # noctalia's settings window
      - ^(nwg-look|qt5ct|qt6ct|[Yy]ad)$
      - ^(xdg-desktop-portal-gtk)$
      - ^(btop)$
    float: true
    center: true
    size:
      width: 0.8
      height: 0.7
monitors:
  - name: Unknown-1
    disabled: true
  - name: Wayvnc-1
    resolution: 1920x1080
    position: "0x0"
    scale: 1
{{- if eq .code "b0n9u4" }}
  - name: eDP-1
    resolution: 1920x1200
    position: "1920x0"
    scale: 1
  - name: HDMI-A-1
    resolution: 1920x1080
    position: "3840x0"
    scale: 1
{{- end }}
# Input sources the external monitors switch to over DDC/CI (`dymonitor
# input`), bound in this order to Mod+Alt+1.. by every window manager
monitorInputs:
  - dp1
  - dp2
  - hdmi1
  - hdmi2
  - usbc
# Browser and mail profiles: `main` on Mod+E / Mod+M, `other` on the same keys
# with Shift. Empty away from home and office, where those keys stay unbound
profiles:
{{- if eq .place "home" }}
  main: Personal
  other: Enterprise-F1
{{- else if eq .place "office" }}
  main: Enterprise-{{ .company }}
  other: Personal
{{- else }}
  main: ""
  other: ""
{{- end }}
# Key bindings of every window manager (niri, Hyprland, aerospace, OmniWM and
# Hammerspoon). `key` is written the niri way: Mod (Super on Linux, Command on
# macOS), Ctrl, Alt and Shift, then the key. Each window manager binds the
# actions it knows and skips the others, so one key can mean one thing on the
# scrolling Linux layouts and another on macOS. `os` keeps an entry to linux or
# darwin; `repeat` turns key repeat on (true) or off (false) where the window
# manager would do otherwise; `locked` keeps it working on the lock screen.
# Mod+[0-9] and Mod+Shift+[0-9] (workspaces) and Mod+Alt+[1-9] (monitorInputs)
# come from the lists above.
bindings:
  # Session
  - {key: Ctrl+Alt+Delete, action: quit}
  - {key: Mod+Shift+R, action: reload}
  - {key: Mod+Shift+Slash, action: hotkey-overlay}
  # Prompt
  - {key: Mod+F2, action: launcher}
  - {key: Alt+F2, action: launcher, os: linux}
  # Workspaces and monitors
  - {key: Mod+D, action: swap-monitors}
  - {key: Mod+Ctrl+Left, action: workspace-to-monitor-left}
  - {key: Mod+Ctrl+Right, action: workspace-to-monitor-right}
  - {key: Mod+Ctrl+H, action: workspace-to-monitor-left}
  - {key: Mod+Ctrl+L, action: workspace-to-monitor-right}
  - {key: Mod+Shift+Tab, action: workspace-to-monitor-next}
  - {key: Mod+Tab, action: overview}
  - {key: Mod+Tab, action: workspace-back-and-forth}
  # Focus, with the arrows or hjkl as in Neovim
  - {key: Mod+Left, action: focus-left}
  - {key: Mod+Down, action: focus-down}
  - {key: Mod+Up, action: focus-up}
  - {key: Mod+Right, action: focus-right}
  - {key: Mod+H, action: focus-left}
  - {key: Mod+J, action: focus-down}
  - {key: Mod+K, action: focus-up}
  - {key: Mod+L, action: focus-right}
  - {key: Alt+Tab, action: cycle-next}
  - {key: Alt+Shift+Tab, action: cycle-prev}
  # Shift resizes on the Linux layouts and joins windows on macOS
  - {key: Mod+Shift+Left, action: resize-left}
  - {key: Mod+Shift+Down, action: resize-down}
  - {key: Mod+Shift+Up, action: resize-up}
  - {key: Mod+Shift+Right, action: resize-right}
  - {key: Mod+Shift+H, action: resize-left}
  - {key: Mod+Shift+J, action: resize-down}
  - {key: Mod+Shift+K, action: resize-up}
  - {key: Mod+Shift+L, action: resize-right}
  - {key: Mod+Shift+Left, action: join-left}
  - {key: Mod+Shift+Down, action: join-down}
  - {key: Mod+Shift+Up, action: join-up}
  - {key: Mod+Shift+Right, action: join-right}
  - {key: Mod+Shift+H, action: join-left}
  - {key: Mod+Shift+J, action: join-down}
  - {key: Mod+Shift+K, action: join-up}
  - {key: Mod+Shift+L, action: join-right}
  - {key: Mod+Shift+Minus, action: resize-smaller}
  - {key: Mod+Shift+Equal, action: resize-larger}
  - {key: Mod+Alt+Left, action: move-left}
  - {key: Mod+Alt+Down, action: move-down}
  - {key: Mod+Alt+Up, action: move-up}
  - {key: Mod+Alt+Right, action: move-right}
  - {key: Mod+Alt+H, action: move-left}
  - {key: Mod+Alt+J, action: move-down}
  - {key: Mod+Alt+K, action: move-up}
  - {key: Mod+Alt+L, action: move-right}
  # Windows
  - {key: Alt+F4, action: close}
  - {key: Mod+Period, action: fullscreen}
  - {key: Mod+Slash, action: float}
  - {key: Mod+Comma, action: layout}
  - {key: Mod+Semicolon, action: group}
  - {key: Mod+Semicolon, action: mode-service}
  - {key: Mod+Apostrophe, action: swap}
  - {key: Mod+Escape, action: mode-apps}
  # Applications
  - {key: Mod+Return, action: terminal}
  - {key: Mod+E, action: browser}
  - {key: Mod+Shift+E, action: browser-other}
  - {key: Mod+M, action: mail}
  - {key: Mod+Shift+M, action: mail-other}
  - {key: Mod+N, action: control-center}
  - {key: Mod+Shift+N, action: notification-dnd}
  - {key: Mod+Alt+N, action: notification-latest}
  # Mod+V pastes on macOS
  - {key: Mod+V, action: clipboard, os: linux}
  - {key: Mod+Ctrl+V, action: clipboard, os: darwin}
  - {key: Mod+P, action: password}
  - {key: Mod+O, action: totp}
  - {key: Mod+Escape, action: lock}
  - {key: Mod+S, action: screenshot}
  - {key: Mod+Z, action: system-monitor}
  - {key: Mod+Ctrl+Shift+Space, action: input-english}
  # External monitors over DDC/CI: each step takes the bus for a moment
  - {key: Mod+Alt+Equal, action: brightness-up, repeat: false}
  - {key: Mod+Alt+Minus, action: brightness-down, repeat: false}
  - {key: Mod+Alt+Shift+Equal, action: contrast-up, repeat: false}
  - {key: Mod+Alt+Shift+Minus, action: contrast-down, repeat: false}
{{- if .hasSound }}
  # Multimedia
  - {key: XF86AudioRaiseVolume, action: volume-up, locked: true, repeat: true}
  - {key: XF86AudioLowerVolume, action: volume-down, locked: true, repeat: true}
  - {key: XF86AudioMute, action: mute, locked: true, repeat: false}
  - {key: XF86AudioMicMute, action: mic-mute, locked: true, repeat: false}
  - {key: XF86AudioPlay, action: play-pause, repeat: false}
  - {key: XF86AudioPause, action: pause, repeat: false}
  - {key: XF86AudioNext, action: next, repeat: false}
  - {key: XF86AudioPrev, action: previous, repeat: false}
{{- end }}
