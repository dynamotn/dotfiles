{{- /*
  dyai shared data: the AI-agent extension and settings data that both
  ~/.config/dyai/config.yaml and Claude's settings.json render from, so the
  two never drift. Data only — no install logic. See
  docs/superpowers/specs/2026-10-24-dyai-shared-ai-config-design.md
*/ -}}
marketplaces:
  i-have-adhd:
    source: { source: github, repo: ayghri/i-have-adhd }
  superpowers-marketplace:
    source: { source: github, repo: obra/superpowers-marketplace }
  obsidian-skills:
    source: { source: github, repo: kepano/obsidian-skills }
  secskills-marketplace:
    source: { source: github, repo: trilwu/secskills }
  trailofbits:
    source: { source: github, repo: trailofbits/skills }
  agent-sec-ops-kit-skills:
    source: { source: git, url: "https://github.com/AgentSecOps/SecOpsAgentKit.git" }
  thedotmack:
    source: { source: github, repo: thedotmack/claude-mem }
  caveman:
    source: { source: github, repo: JuliusBrussee/caveman }
  ponytail:
    source: { source: github, repo: DietrichGebert/ponytail }
  context-mode:
    source: { source: github, repo: mksglu/context-mode }
plugins:
  - i-have-adhd@i-have-adhd
  - claude-mem@thedotmack
  - caveman@caveman
  - ponytail@ponytail
  - context-mode@context-mode
  - dyai-lsp@dyai-lsp
  - superpowers@claude-plugins-official
  - telegram@claude-plugins-official
  - context7@claude-plugins-official
  - github@claude-plugins-official
  - gitlab@claude-plugins-official
  - claude-md-management@claude-plugins-official
  - hookify@claude-plugins-official
  - security-guidance@claude-plugins-official
  - claude-code-setup@claude-plugins-official
  - obsidian@obsidian-skills
  - playwright@claude-plugins-official
  - chrome-devtools-mcp@claude-plugins-official
  - semgrep@claude-plugins-official
  - claude-security@claude-plugins-official
  - frontend-design@claude-plugins-official
  - code-simplifier@claude-plugins-official
  - commit-commands@claude-plugins-official
  - differential-review@trailofbits
  - elements-of-style@superpowers-marketplace
  - episodic-memory@superpowers-marketplace
  - insecure-defaults@trailofbits
  - mattpocock-skills@claude-plugins-official
  - modern-python@trailofbits
  - pr-review-toolkit@claude-plugins-official
  - second-opinion@trailofbits
  - sharp-edges@trailofbits
  - skill-creator@claude-plugins-official
  - static-analysis@trailofbits
  - supply-chain-risk-auditor@trailofbits
  - trailmark@trailofbits
  - mcp-server-dev@claude-plugins-official
  - agent-sdk-dev@claude-plugins-official
  - ralph-loop@claude-plugins-official
# Installed but off globally: each one loads its skills into every session,
# so these domain plugins are switched on per project by the registry preset
# that lists them (`dyai use security`, `dyai use database`).
optional_plugins:
  - appsec-skills@agent-sec-ops-kit-skills
  - compliance-skills@agent-sec-ops-kit-skills
  - devsecops-skills@agent-sec-ops-kit-skills
  - incident-response-skills@agent-sec-ops-kit-skills
  - offsec-skills@agent-sec-ops-kit-skills
  - secsdlc-skills@agent-sec-ops-kit-skills
  - threatmodel-skills@agent-sec-ops-kit-skills
  - secskills-core@secskills-marketplace
  - secskills-defense@secskills-marketplace
  - secskills-offense@secskills-marketplace
  - testing-handbook-skills@trailofbits
  - redis-development@claude-plugins-official
  - duckdb-skills@claude-plugins-official

policy:
  # Harness-enforced versions of the credentials and destructive-commands rules
  # in ai/: a rule here holds even when the prose is lost from context. The rtk
  # PreToolUse hook rewrites some git commands to `rtk git ...` before they are
  # matched, so every git rule is listed in both spellings.
  permissions:
    ask:
      - "Bash(git push)"
      - "Bash(git push:*)"
      - "Bash(rtk git push)"
      - "Bash(rtk git push *)"
      - "Bash(git reset --hard:*)"
      - "Bash(rtk git reset --hard:*)"
      - "Bash(git clean *)"
      - "Bash(rtk git clean *)"
      - "Bash(git branch -D *)"
      - "Bash(rtk git branch -D *)"
      - "Bash(git tag -d *)"
      - "Bash(rtk git tag -d *)"
      - "Bash(git stash drop:*)"
      - "Bash(rtk git stash drop:*)"
      - "Bash(git stash clear:*)"
      - "Bash(rtk git stash clear:*)"
      - "Bash(rm -rf *)"
      - "Bash(rm -fr *)"
      - "Bash(shred *)"
      - "Bash(sudo *)"
      - "Bash(emerge *)"
      - "Bash(pacman *)"
      - "Bash(paru *)"
      - "Bash(chezmoi apply:*)"
      - "Bash(chezmoi destroy:*)"
      - "Bash(chezmoi forget:*)"
    deny:
      - "Read(**/secrets/data/**)"
      - "Edit(**/secrets/data/**)"
      - "Read(**/*.age)"
      - "Edit(**/*.age)"
      - "Read(**/.env)"
      - "Read(**/.env.*)"
      - "Read(**/.envrc)"
      - "Read(~/.ssh/**)"
      - "Read(~/.gnupg/**)"
      - "Read(~/.aws/**)"
      - "Read(~/.kube/**)"
      - "Read(~/.docker/config.json)"
      - "Read(~/.netrc)"
      - "Read(~/.password-store/**)"
      - "Read(~/.local/share/keyrings/**)"
      - "Bash(chezmoi-dycrypt:*)"
      - "Bash(age -d *)"
      - "Bash(age --decrypt *)"
      - "Bash(sops -d *)"
      - "Bash(sops --decrypt *)"
      - "Bash(gpg -d *)"
      - "Bash(gpg --decrypt *)"
      - "Bash(pass show *)"
      - "Bash(vault read *)"
      - "Bash(op read *)"
      - "Bash(aws configure get *)"
    defaultMode: acceptEdits
    # --dangerously-skip-permissions would skip every ask rule above; auto
    # mode and the sandbox cover the same need without that hole.
    disableBypassPermissionsMode: disable
  theme: auto
  effortLevel: medium
  # Shared approval stance, translated per agent where an edits-only preset exists.
  approval: accept-edits
