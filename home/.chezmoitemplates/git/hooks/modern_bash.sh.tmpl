# @file modern_bash.sh
# @brief Re-run a git hook under a bash that dybatpho supports
# @description Included at the top of each hook, before dybatpho is sourced.
# Git runs a hook with the first `bash` on PATH, and tools that put `/usr/bin`
# first, like Homebrew cloning a git-based cask, hand it the macOS bash 3.2
# that dybatpho refuses. Re-run the hook with the first bash on PATH that is
# v4.3 or newer. Keep this part bash 3.2 compatible.
# shellcheck shell=bash
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3))); then
  for candidate in $(type -ap bash); do
    if "${candidate}" -c '((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3)))' 2> /dev/null; then
      exec "${candidate}" "$0" "$@"
    fi
  done
fi
