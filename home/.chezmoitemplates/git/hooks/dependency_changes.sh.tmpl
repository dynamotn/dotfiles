# @file dependency_changes.sh
# @brief Report the dependency files a commit range touched
# @description Included by the `post-checkout` and `post-merge` hooks, which
# source dybatpho themselves and then call the function below.
# shellcheck shell=bash

#######################################
# @description Report the dependency files that changed in a commit range, so a
# checkout or a merge does not leave the tool versions and the lockfiles behind.
# @arg $1 string Commit range, such as `ORIG_HEAD..HEAD`
# @stderr One warning header and one changed file per line
#######################################
function dependency_changes::report {
  local range
  dybatpho::expect_args range -- "$@"

  local -a watched=(
    .gitmodules
    '*Cargo.lock'
    '*Gemfile.lock'
    '*bun.lock'
    '*bun.lockb'
    '*composer.lock'
    '*flake.lock'
    '*go.sum'
    '*mise.toml'
    '*package-lock.json'
    '*pnpm-lock.yaml'
    '*poetry.lock'
    '*requirements*.txt'
    '*uv.lock'
    '*yarn.lock'
    '.tool-versions'
  )

  # A range git cannot resolve reports nothing rather than failing the hook.
  local -a changed=()
  mapfile -t changed < <(git diff --name-only "${range}" -- "${watched[@]}" || true)

  if ((${#changed[@]} > 0)); then
    dybatpho::warn "Dependencies changed, re-run the install step for:"
    dybatpho::array_print changed >&2
  fi
}
