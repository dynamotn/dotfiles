{{- /* The secrets of this machine, as JSON: httpProxy, noProxyAddresses and
       customHostname, from the `machines.<code>` entry of
       secrets/data/<identity>/machine.yaml.age. The identity is the owner
       company's when this machine decrypts it, else the personal one. Every
       field is empty when the machine decrypts neither, or the file or the
       entry is missing, so containers and CI never decrypt anything.
       Read it with: includeTemplate "machine/secret.tmpl" . | fromJson */ -}}
{{- $secret := dict }}
{{- $identity := "" }}
{{- if and .company (has .company .decryptEnterprise) }}
{{-   $identity = printf "enterprise-%s" .company }}
{{- else if .decryptPersonal }}
{{-   $identity = "personal" }}
{{- end }}
{{- if $identity }}
{{-   $file := printf "../secrets/data/%s/machine.yaml.age" $identity | joinPath .chezmoi.sourceDir }}
{{-   if stat $file }}
{{-     $secret = include $file | decrypt | fromYaml | dig "machines" .code dict }}
{{-   end }}
{{- end }}
{{- dict
      "httpProxy" (dig "httpProxy" "" $secret | default "")
      "noProxyAddresses" (dig "noProxyAddresses" list $secret | default list)
      "customHostname" (dig "customHostname" "" $secret | default "")
    | toJson }}
