{{- /* dybw's config file (ADR 0008 of dybw), one profile per account.
       Called with the template data plus `dybwProfiles`, a list of
       {name, identity}: the profile, and the secrets identity whose
       rbw.yaml.age holds its account (schemas/secrets/rbw.schema.yaml).
       rbw's `lock_timeout` is in seconds, dybw's in minutes, rounded up.
       dybw has no identity_url: it derives the identity server from
       server_url (<server_url>/identity, or identity.bitwarden.<tld> for
       Bitwarden's cloud), so a different one fails the render. */ -}}
{{- $profiles := dict }}
{{- range .dybwProfiles }}
{{-   $secret := printf "../secrets/data/%s/rbw.yaml.age" .identity | joinPath $.chezmoi.sourceDir | include | decrypt | fromYaml }}
{{-   $base := trimSuffix "/" $secret.base_url }}
{{-   $identity := get $secret "identity_url" | default "" | trimSuffix "/" }}
{{- /* The identity server dybw will use: the cloud's own host for
       Bitwarden's servers, as dybw-core's resolve_server_urls does */}}
{{-   $derived := printf "%s/identity" $base }}
{{-   $cloud := regexFind "^https://(vault\\.)?bitwarden\\.(com|eu)$" $base }}
{{-   if $cloud }}
{{-     $derived = printf "https://identity.bitwarden.%s" (regexReplaceAll ".*\\." $cloud "") }}
{{-   end }}
{{-   if and $identity (ne $identity $derived) }}
{{-     fail (printf "dybw profile %s: identity_url in %s/rbw.yaml is not the identity server dybw derives from base_url; remove it or fix it" .name .identity) }}
{{-   end }}
{{-   $profiles = set $profiles .name (dict
        "server_url" $secret.base_url
        "email" $secret.email
        "lock_timeout_minutes" (div (add (int $secret.lock_timeout) 59) 60)) }}
{{- end }}
{{- /* The pinentry is the machine's, not the account's: the one dytoy
       installs (pinentry/program.tmpl). A name is looked up in
       /opt/homebrew/bin, /usr/local/bin, /usr/bin and /bin only, and must be
       a program dybw trusts (see dybw/root.tmpl). */}}
{{- $pinentry := includeTemplate "pinentry/program.tmpl" . }}
{{- /* The first profile is the default, the one `rbw` without RBW_PROFILE uses */}}
{{- dict "default" (index .dybwProfiles 0).name "pinentry" $pinentry "profiles" $profiles | toToml }}
